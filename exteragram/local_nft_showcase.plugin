# Fragment website palette (dark theme). Colors as signed 32-bit ints for Java.
def _argb(value):
    return value - 0x100000000 if value & 0x80000000 else value


FG_BG = _argb(0xFF1A2026)        # page background
FG_CARD = _argb(0xFF242E38)      # card / field background
