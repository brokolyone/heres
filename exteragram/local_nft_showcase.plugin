class FragmentSheetOnceHook(MethodHook):
    """FragmentUsernameBottomSheet.open: one tap on a collectible username could open its
    sheet twice. A second open of the same name within 1.5 s is skipped.
    """

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            args = list(param.args)
            key = (int(args[1]), str(args[2]).lower())
            now = time.time()
            last = getattr(self.plugin, "last_fragment_sheet", None)
            self.plugin.last_fragment_sheet = (key, now)
            if (
                last is not None
                and last[0] == key
                and now - last[1] < 1.5
            ):
                param.setResult(None)
        except Exception:
            pass


class UndoLiftHook(MethodHook):
    """UndoView.showWithAction: the profile's older toast ("Скопировано в буфер обмена" when a
    username is copied) sits at the very bottom, under exteraGram's floating tab bar. Lift it
    while the main tabs are on screen."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            last = get_last_fragment()
            on_tabs = (
                last is not None
                and last.getClass().getSimpleName()
                == "MainTabsActivity"
            )
            param.thisObject.setAdditionalTranslationY(
                float(AndroidUtilities.dp(136)) if on_tabs else 0.0
            )
        except Exception:
            pass


