def log_path() -> str:
    from org.telegram.messenger import ApplicationLoader

    return (
        str(
            ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()
        )
        + "/winft_log.txt"
    )


LOG_ENABLED = False  # the debug log is off; True records it (opened by a long press on «Профиль»)


def write_log(text: str):
    """Synchronous append, so the line survives even if the app dies right after."""
    if not LOG_ENABLED:
        return
    try:
        path = log_path()
        with open(path, "a", encoding="utf-8") as f:
            f.write(time.strftime("%H:%M:%S ") + text + "\n")
        import os

        if os.path.getsize(path) > 96 * 1024:
            with open(path, "r", encoding="utf-8") as f:
                tail = f.read()[-48 * 1024 :]
            with open(path, "w", encoding="utf-8") as f:
                f.write(tail)
    except Exception:
        pass


def long_click_listener(fn):
    """View.OnLongClickListener backed by a Python callable (consumes the long press)."""
    from java import dynamic_proxy
    from android.view import View

    class _Listener(dynamic_proxy(View.OnLongClickListener)):
        def onLongClick(self, v):
            fn()
            return True

    return _Listener()


def layout_listener(fn):
    """View.OnLayoutChangeListener backed by a Python callable."""
    from java import dynamic_proxy
    from android.view import View

    class _Listener(dynamic_proxy(View.OnLayoutChangeListener)):
        def onLayoutChange(
            self, v, left, top, right, bottom, ol, ot, orr, ob
        ):
            fn()

    return _Listener()


def java_field(obj, name):
    """Reads a field declared anywhere up obj's class chain (public or not)."""
    cls = obj.getClass()
    while cls is not None:
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            return field.get(obj)
        except Exception:
            cls = cls.getSuperclass()
    return None


def long_press_listener(on_start, on_release):
    """RecyclerListView.OnItemLongClickListenerExtended backed by Python callables."""
    from java import dynamic_proxy
    from org.telegram.ui.Components import RecyclerListView

    class _Listener(
        dynamic_proxy(
            RecyclerListView.OnItemLongClickListenerExtended
        )
    ):
        def onItemClick(self, view, position, x, y):
            return bool(on_start(view, position))

        def onMove(self, dx, dy):
            pass

        def onLongClickRelease(self):
            on_release()

    return _Listener()


class MarketRedirectHook(MethodHook):
    """While the NFT constructor market is open, a tap on a gift in Telegram's market
    opens Telegram's own preview sheet (the constructor) instead of buying or resale.
    """

    def __init__(self, plugin, extract, name):
        self.plugin = plugin
        self.extract = extract
        self.name = name

    def before_hooked_method(self, param):
        if not self.plugin.market_active():
            return
        try:
            target = self.extract(param)
        except Exception:
            write_log(
                f"redirect {self.name} failed:\n{traceback.format_exc()}"
            )
            return
        write_log(f"redirect via {self.name}: {target}")
        if target is None:
            return
        param.setResult(None)
        gift_id, title = target
        run_on_ui_thread(
            lambda: self.plugin.open_constructor_for(gift_id, title)
        )


class MarketFillHook(MethodHook):
    """GiftSheet.fillItems: before the market grid is (re)built, hide resale listings
    in the very lists it reads, so only non-upgraded versions are shown.
    """

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.is_market_sheet(param.thisObject):
            self.plugin.hide_resale_now()


class FakeUpdatesHook(MethodHook):
    """MessagesController.processUpdates: the updates made for a local upgrade only feed the
    gift screen's upgrade animation and must never reach the chats."""

    def __init__(self, plugin):
        self.plugin = plugin

    @hook_filters(
        HookFilter.ArgumentIsInstanceOf(
            0, TLRPC.TL_updatesCombined().getClass()
        )
    )
    def before_hooked_method(self, param):
        updates = param.args[0]
        for i, fake in enumerate(self.plugin.fake_updates):
            if fake.equals(updates):
                del self.plugin.fake_updates[i]
                param.setResult(None)
                return


class SendRequestHook(MethodHook):
    """ConnectionsManager.sendRequest(...): every gift purchase ends with payments.sendStarsForm,
    whichever screen started it, so local purchases are answered here without the server.
    """

    def __init__(self, plugin):
        self.plugin = plugin

    # sendRequest runs for every network request, so only these requests reach Python.
    @hook_filters(
        HookFilter.Or(
            HookFilter.ArgumentIsInstanceOf(
                0, TL_stars.TL_payments_sendStarsForm().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_stars.updateStarGiftPrice().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_fragment.TL_getCollectibleInfo().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_stars.saveStarGift().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TLRPC.TL_payments_getPaymentForm().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_stars.upgradeStarGift().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_stars.createStarGiftCollection().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_stars.updateStarGiftCollection().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_stars.deleteStarGiftCollection().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_account.reorderUsernames().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_account.toggleUsername().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TL_account.updateColor().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TLRPC.TL_messages_toggleDialogPin().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0, TLRPC.TL_messages_sendReaction().getClass()
            ),
            HookFilter.ArgumentIsInstanceOf(
                0,
                TL_stars.TL_payments_getStarsTransactions().getClass(),
            ),
        )
    )
    def before_hooked_method(self, param):
        args = list(param.args)
        if not args:
            return
        # sendRequest overloads call one another with the same request object: answer it once,
        # or the screen that sent it opens (or upgrades, or buys) once per overload.
        for i, (done, at, answered) in enumerate(
            self.plugin.answered_requests
        ):
            if done.equals(args[0]):
                if time.time() - at < 5:
                    if answered:
                        param.setResult(0)
                    return  # already looked at: answered above, or passed on to the server
                del self.plugin.answered_requests[i]
                break
        delegate = next(
            (
                a
                for a in args[1:]
                if a is not None and hasattr(a, "run")
            ),
            None,
        )
        account = (
            get_private_field(param.thisObject, "currentAccount") or 0
        )
        if isinstance(
            args[0], TL_stars.TL_payments_getStarsTransactions
        ):
            # Once per request: the nested overloads would wrap the wrapped delegate again
            # and add the local transactions once per overload.
            self.plugin.answered_requests = (
                self.plugin.answered_requests
                + [(args[0], time.time(), False)]
            )[-20:]
            self.plugin.wrap_transactions(
                param, args, delegate, account
            )
            return
        if isinstance(args[0], TL_stars.TL_payments_sendStarsForm):
            result = self.plugin.pay_locally(account, args[0])
        elif isinstance(args[0], TL_stars.updateStarGiftPrice):
            result = self.plugin.set_price_locally(args[0])
        elif isinstance(args[0], TL_fragment.TL_getCollectibleInfo):
            result = self.plugin.collectible_info(args[0])
        elif isinstance(args[0], TL_stars.saveStarGift):
            result = self.plugin.save_gift_locally(args[0])
        elif isinstance(args[0], TLRPC.TL_payments_getPaymentForm):
            result = self.plugin.drop_details_form(args[0])
        elif isinstance(args[0], TL_stars.upgradeStarGift):
            result = self.plugin.upgrade_gift_locally(
                account, args[0]
            )
        elif isinstance(
            args[0],
            (
                TL_stars.createStarGiftCollection,
                TL_stars.updateStarGiftCollection,
                TL_stars.deleteStarGiftCollection,
            ),
        ):
            result = self.plugin.collection_request(account, args[0])
        elif isinstance(args[0], TL_account.reorderUsernames):
            result = self.plugin.reorder_usernames_locally(
                account, args[0]
            )
        elif isinstance(args[0], TL_account.toggleUsername):
            result = self.plugin.toggle_username_locally(args[0])
        elif isinstance(args[0], TL_account.updateColor):
            result = self.plugin.save_colors_locally(account, args[0])
        elif isinstance(args[0], TLRPC.TL_messages_toggleDialogPin):
            result = self.plugin.remember_pin(account, args[0])
        elif isinstance(args[0], TLRPC.TL_messages_sendReaction):
            result = self.plugin.send_reaction_locally(
                account, args[0]
            )
        else:
            return
        self.plugin.trace_request(args[0], result)
        self.plugin.answered_requests = (
            self.plugin.answered_requests
            + [(args[0], time.time(), result is not None)]
        )[-20:]
        if result is None:
            return  # not ours: let the real request go
        param.setResult(0)
        if delegate is None:
            return
        if (
            len(result) == 3
        ):  # (response, error, should_answer): answered a moment later
            response, error, still_wanted = result

            def answer_later():
                if still_wanted():
                    deliver(delegate, response, error)

            run_on_ui_thread(answer_later, 350)
            return
        response, error = result
        deliver(delegate, response, error)


def transactions_delegate(original, on_response):
    """A RequestDelegate(Timestamp) that lets on_response edit the response first, so local
    transactions go into the very list that was asked for (all / incoming / outgoing).
    """
    from java import dynamic_proxy, jclass

    for name in (
        "org.telegram.tgnet.RequestDelegateTimestamp",
        "org.telegram.tgnet.RequestDelegate",
    ):
        iface = jclass(name)
        if isinstance(original, iface):
            break
    else:
        return None

    class _Delegate(dynamic_proxy(iface)):
        def run(self, response, error, *rest):
            try:
                on_response(response, error)
            except Exception:
                pass
            original.run(response, error, *rest)

    return _Delegate()


def deliver(delegate, response, error):
    try:
        delegate.run(response, error)
    except Exception:
        delegate.run(response, error, 0)  # RequestDelegateTimestamp


def parse_usernames(text: str) -> List[str]:
    """'@durov, t.me/telegram fragment' -> ['durov', 'telegram', 'fragment']"""
    names = []
    for part in re.split(r"[\s,;]+", text or ""):
        name = part.strip().split("t.me/")[-1].lstrip("@").strip("/")
        # Telegram's rules: Latin letters, digits and _, starting with a letter, not ending with _.
        if re.fullmatch(
            r"[A-Za-z][A-Za-z0-9_]{2,30}[A-Za-z0-9]", name
        ) and name.lower() not in [n.lower() for n in names]:
            names.append(name)
    return names


def parse_phone(text: str) -> str:
    """'+888 0123 4567' -> '88801234567', empty when it is not a +888 number."""
    digits = re.sub(r"\D", "", text or "")
    return (
        digits
        if digits.startswith("888") and len(digits) >= 7
        else ""
    )


def format_phone(digits: str) -> str:
    """'88801234567' -> '+888 0123 4567'."""
    if not digits:
        return ""
    rest = digits[3:]
    groups = [digits[:3]] + [
        rest[i : i + 4] for i in range(0, len(rest), 4)
    ]
    return "+" + " ".join(groups)


def parse_prices(text: str) -> dict:
    """'durov=7000, telegram=15k, number=3000' -> {'durov': 7000.0, 'telegram': 15000.0, 'number': 3000.0}"""
    prices = {}
    for part in re.split(r"[,;\n]+", text or ""):
        if "=" not in part:
            continue
        name, value = part.split("=", 1)
        name = name.strip().lstrip("@").lower()
        value = (
            value.strip().lower().replace(" ", "").replace(",", ".")
        )
        scale = 1
        if value.endswith(("k", "к")):
            value, scale = value[:-1], 1000
        try:
            prices[name] = float(value) * scale
        except ValueError:
            continue
    return prices


def http_get(url: str) -> str:
    """Through Java: the app's Python may lack CA certificates for urllib."""
    connection = URL(url).openConnection()
    connection.setConnectTimeout(10000)
    connection.setReadTimeout(10000)
    reader = BufferedReader(
        InputStreamReader(connection.getInputStream())
    )
    lines = []
    while True:
        line = reader.readLine()
        if line is None:
            break
        lines.append(line)
    reader.close()
    return "\n".join(lines)


def parse_slugs(text: str) -> List[str]:
    """Several links separated by commas, spaces or new lines, without duplicates."""
    slugs = []
    for part in re.split(r"[\s,;]+", text or ""):
        slug = parse_slug(part)
        if slug and slug not in slugs:
            slugs.append(slug)
    return slugs


class LocalNftShowcasePlugin(BasePlugin):
    def install_crash_handler(self):
        """Write Java crashes to the winft log before Telegram goes down."""
        from java import dynamic_proxy
        from java.lang import Thread
        from android.util import Log

        previous = Thread.getDefaultUncaughtExceptionHandler()

        class Handler(dynamic_proxy(Thread.UncaughtExceptionHandler)):
            def uncaughtException(self, thread, error):
                try:
                    write_log(
                        f"CRASH in {thread.getName()}:\n{Log.getStackTraceString(error)}"
                    )
                except Exception:
                    pass
                if previous is not None:
                    previous.uncaughtException(thread, error)

        self.crash_previous = previous
        self.crash_handler = Handler()
        Thread.setDefaultUncaughtExceptionHandler(self.crash_handler)

    def on_plugin_unload(self):
        try:
            from java.lang import Thread

            if getattr(self, "crash_handler", None) is not None:
                Thread.setDefaultUncaughtExceptionHandler(
                    self.crash_previous
                )
        except Exception:
            pass
        self.restore_resale()
        try:
            from org.telegram.messenger import (
                NotificationCenter as NC,
            )

            for account, observer in getattr(
                self, "pin_observers", []
            ):
                NC.getInstance(account).removeObserver(
                    observer, NC.dialogsNeedReload
                )
        except Exception:
            pass

    # ----- Local reactions: more per message than the server allows, and Saved tags -----

    def local_reactions(self, account) -> dict:
        cache = getattr(self, "_reactions_cache", {})
        if account not in cache:
            try:
                cache[account] = json.loads(
                    self.get_setting(f"local_reactions_{account}", "")
                    or "{}"
                )
            except ValueError:
                cache[account] = {}
            self._reactions_cache = cache
        return cache[account]

    def save_local_reactions(self, account, data):
        self.set_setting(
            f"local_reactions_{account}", json.dumps(data)
        )
        cache = getattr(self, "_reactions_cache", {})
        cache[account] = data
        self._reactions_cache = cache

    @staticmethod
    def reaction_spec(reaction):
        if isinstance(reaction, TLRPC.TL_reactionEmoji):
            return ["e", str(reaction.emoticon)]
        if isinstance(reaction, TLRPC.TL_reactionCustomEmoji):
            return ["d", str(reaction.document_id)]
        return None

    @staticmethod
    def reaction_from_spec(spec):
        if spec[0] == "e":
            reaction = TLRPC.TL_reactionEmoji()
            reaction.emoticon = spec[1]
        else:
            reaction = TLRPC.TL_reactionCustomEmoji()
            reaction.document_id = int(spec[1])
        return reaction

    def send_reaction_locally(self, account, request):
        """messages.sendReaction: in Saved Messages (tags) nothing goes to the server; in other
        chats the server gets as many as it allows without Premium and the rest stay here.
        """
        if not self.get_setting("local_premium", True):
            return None
        did = self.input_peer_to_dialog(account, request.peer)
        if did is None:
            return None
        wanted = [
            spec
            for spec in (
                self.reaction_spec(r) for r in jlist(request.reaction)
            )
            if spec
        ]
        data = dict(self.local_reactions(account))
        key = f"{did}:{request.msg_id}"
        own = did == int(get_user_config(account).getClientUserId())
        limit = max(
            1,
            int(
                getattr(
                    get_messages_controller(account),
                    "reactionsUserMaxDefault",
                    1,
                )
                or 1
            ),
        )
        if wanted and (own or len(wanted) > limit):
            data[key] = wanted
        else:
            data.pop(key, None)
        self.save_local_reactions(account, data)
        if own:
            updates = TLRPC.TL_updates()
            updates.date = int(time.time())
            return updates, None  # tags stay on this device
        if len(wanted) > limit:
            kept = ArrayList()
            for r in jlist(request.reaction)[:limit]:
                kept.add(r)
            request.reaction = kept
        return None

    def merge_local_reactions(
        self, account, did, msg_id, reactions
    ) -> bool:
        """Marks the locally kept reactions as chosen in a TL_messageReactions, in place."""
        wanted = self.local_reactions(account).get(f"{did}:{msg_id}")
        if not wanted or reactions is None:
            return False
        results = reactions.results
        order = 0
        for i in range(results.size()):
            if results.get(i).chosen:
                order = max(order, results.get(i).chosen_order)
        for spec in wanted:
            found = None
            for i in range(results.size()):
                if (
                    self.reaction_spec(results.get(i).reaction)
                    == spec
                ):
                    found = results.get(i)
                    break
            if found is None:
                found = TLRPC.TL_reactionCount()
                found.reaction = self.reaction_from_spec(spec)
                found.count = 0
                results.add(found)
            if not found.chosen:
                order += 1
                found.chosen = True
                found.chosen_order = order
                found.flags |= 1
                found.count += 1
        return True

    def apply_local_reactions_to(self, account, messages) -> bool:
        changed = False
        for message in jlist(messages):
            try:
                did = MessageObject.getDialogId(message)
                if f"{did}:{message.id}" not in self.local_reactions(
                    account
                ):
                    continue
                if message.reactions is None:
                    message.reactions = TLRPC.TL_messageReactions()
                    message.flags |= 1048576
                changed = (
                    self.merge_local_reactions(
                        account, did, message.id, message.reactions
                    )
                    or changed
                )
            except Exception:
                continue
        return changed

    def add_local_tags(self, account, response) -> bool:
        """The tag bar in Saved Messages: local tags with how many messages carry each."""
        if not isinstance(
            response, TLRPC.TL_messages_savedReactionsTags
        ):
            return False
        own = str(get_user_config(account).getClientUserId())
        counts = {}
        for key, specs in self.local_reactions(account).items():
            if key.split(":")[0] == own:
                for spec in specs:
                    counts[tuple(spec)] = (
                        counts.get(tuple(spec), 0) + 1
                    )
        if not counts:
            return False
        tags = response.tags
        for spec, count in counts.items():
            tag = next(
                (
                    tags.get(i)
                    for i in range(tags.size())
                    if tuple(
                        self.reaction_spec(tags.get(i).reaction) or ()
                    )
                    == spec
                ),
                None,
            )
            if tag is None:
                tag = TLRPC.TL_savedReactionTag()
                tag.reaction = self.reaction_from_spec(list(spec))
                tag.count = 0
                tags.add(tag)
            tag.count = max(tag.count, count)
        return True

    # ----- Local pinned chats: past the server's limit, kept on this device -----

    LOCAL_PIN_LIMIT = 100

    def local_pins(self, account) -> list:
        try:
            return json.loads(
                self.get_setting(f"local_pins_{account}", "") or "[]"
            )
        except ValueError:
            return []

    def remember_pin(self, account, request):
        """messages.toggleDialogPin still goes to the server (it keeps what it allows); the
        pin is also remembered here, so the ones it refuses come back after a sync.
        """
        if not self.get_setting("local_premium", True):
            return None
        peer = getattr(getattr(request, "peer", None), "peer", None)
        did = self.input_peer_to_dialog(account, peer)
        if did is None:
            return None
        pins = [d for d in self.local_pins(account) if d != did]
        if request.pinned:
            pins.append(did)
        self.set_setting(f"local_pins_{account}", json.dumps(pins))
        return None

    def input_peer_to_dialog(self, account, peer):
        if isinstance(peer, TLRPC.TL_inputPeerSelf):
            return int(get_user_config(account).getClientUserId())
        if isinstance(peer, TLRPC.TL_inputPeerUser):
            return int(peer.user_id)
        if isinstance(peer, TLRPC.TL_inputPeerChat):
            return -int(peer.chat_id)
        if isinstance(peer, TLRPC.TL_inputPeerChannel):
            return -int(peer.channel_id)
        return None

    def raise_pin_limits(self, controller):
        try:
            if (
                controller.maxPinnedDialogsCountPremium
                < self.LOCAL_PIN_LIMIT
            ):
                controller.maxPinnedDialogsCountPremium = (
                    self.LOCAL_PIN_LIMIT
                )
            if (
                controller.maxPinnedDialogsCountDefault
                < self.LOCAL_PIN_LIMIT
            ):
                controller.maxPinnedDialogsCountDefault = (
                    self.LOCAL_PIN_LIMIT
                )
        except Exception:
            pass

    def reapply_pins(self, account):
        """Pins the server dropped are pinned again, locally only (taskId -1 sends nothing)."""
        if not self.get_setting("local_premium", True):
            return
        controller = get_messages_controller(account)
        self.raise_pin_limits(controller)
        dialogs = controller.dialogs_dict
        for did in self.local_pins(account):
            dialog = dialogs.get(did)
            if dialog is not None and not dialog.pinned:
                controller.pinDialog(did, True, None, -1)

    def install_pin_keeper(self):
        from java import dynamic_proxy
        from org.telegram.messenger import NotificationCenter as NC

        plugin = self

        class _Observer(dynamic_proxy(NC.NotificationCenterDelegate)):
            def __init__(self, account):
                super().__init__()
                self.account = account

            def didReceivedNotification(self, nid, account, args):
                try:
                    plugin.reapply_pins(self.account)
                except Exception:
                    pass

        self.pin_observers = []
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            if not get_user_config(account).isClientActivated():
                continue
            observer = _Observer(account)
            NC.getInstance(account).addObserver(
                observer, NC.dialogsNeedReload
            )
            self.pin_observers.append((account, observer))
            self.raise_pin_limits(get_messages_controller(account))
            run_on_ui_thread(
                lambda a=account: self.reapply_pins(a), 3000
            )

    def show_log(self):
        activity = self.get_activity()
        if activity is None:
            return
        try:
            with open(log_path(), "r", encoding="utf-8") as f:
                text = f.read()
        except Exception:
            text = ""
        text = text[-6000:] or "Лог пуст"
        builder = AlertDialogBuilder(activity)
        builder.set_title("Лог winft")
        builder.set_message(text)
        builder.set_positive_button(
            "Скопировать",
            lambda bld, _: (copy_to_clipboard(text), bld.dismiss()),
        )
        builder.set_neutral_button(
            "Очистить",
            lambda bld, _: (self.clear_log(), bld.dismiss()),
        )
        builder.set_negative_button(
            "Закрыть", lambda bld, _: bld.dismiss()
        )
        builder.show()

    def clear_log(self):
        try:
            open(log_path(), "w").close()
        except Exception:
            pass

    def on_plugin_load(self):
        try:
            if LOG_ENABLED:
                self.install_crash_handler()
        except Exception:
            write_log(
                f"crash handler failed:\n{traceback.format_exc()}"
            )
        write_log(f"plugin loaded {__version__}")
        self.slugs = []
        self.gifts = {}
        self.custom = (
            {}
        )  # synthetic slug -> locally built TL_starGiftUnique
        self.ctor = None  # constructor state
        self.generation = 0
        # Requests for gift lists are answered in order, so remember for each
        # account whether the pending ones were for our own profile.
        self.pending = defaultdict(deque)
        self.add_hook("getSavedStarGifts", match_substring=True)
        self.add_hook("TL_users_getFullUser")
        self.add_hook("updateEmojiStatus", match_substring=True)
        self.add_hook("getPaymentForm", match_substring=True)
        self.add_hook("getStarsStatus", match_substring=True)
        self.add_hook("getStarsTransactions", match_substring=True)
        self.add_hook(
            "toggleStarGiftsPinnedToTop", match_substring=True
        )
        self.add_hook("getStarGiftCollections", match_substring=True)
        self.add_hook(
            "updateStarGiftCollection", match_substring=True
        )
        self.add_hook(
            "createStarGiftCollection", match_substring=True
        )
        for name in (
            "TL_messages_getHistory",
            "getSavedHistory",
            "TL_messages_getMessages",
            "TL_channels_getMessages",
            "TL_messages_getReplies",
            "getSavedReactionTags",
        ):
            self.add_hook(name, match_substring=True)
        self.tx_pending = defaultdict(deque)
        self.form_prices = (
            {}
        )  # payment form id -> price (stars, or nanoTON)
        self.balance_cache = {}
        self.rates_loading = False
        self.last_purchase = None  # (slug or gift id, time)
        self.local_msg_ids = {}  # fake SavedStarGift.msg_id -> slug
        self.local_regular_msg = (
            {}
        )  # fake msg_id -> catalog gift id (for local upgrade)
        self.local_saved_ids = (
            {}
        )  # fake SavedStarGift.saved_id -> local key (slug or "r:<gift id>")
        self.previews = (
            {}
        )  # gift id -> (models, backdrops, patterns) for an instant local upgrade
        self.upgraded = (
            {}
        )  # "msg:saved:gift" -> (slug of the NFT it became, "" while building; time)
        self.fake_updates = (
            []
        )  # updates objects kept away from MessagesController
        self.answered_requests = (
            []
        )  # (request, time, answered) seen here, so nested overloads skip them
        self.error_depth = (
            0  # > 0 while Telegram builds an error bulletin
        )
        self.muted_bulletins = (
            []
        )  # error bulletins built but not shown yet
        self.pending_create = (
            deque()
        )  # local keys for collections being created
        self.collection_pending = defaultdict(
            deque
        )  # own-profile flags for collection requests
        self.announce = (
            {}
        )  # slug or gift id -> account: post a card in Saved Messages once loaded
        self.own_ids = set()
        self.added_usernames = set()
        self.real_username = (
            {}
        )  # user id -> real main username, to restore it later
        self.real_phones = (
            {}
        )  # user id -> real phone, to restore when the +888 number is cleared
        self.statuses = {}
        self.catalog = (
            {}
        )  # gift id -> regular gift from the gift catalog
        self.install_java_hooks()
        self.load_gifts(self.get_setting("slug", ""))
        self.load_custom_gifts()
        self.migrate_fragment_settings()
        self.load_catalog()
        self.remember_balances()
        try:
            self.install_pin_keeper()
        except Exception:
            self.logger.exception("Local pins are off")

    def install_java_hooks(self):
        # Take java.lang.Class from live objects: find_class may return a Python proxy.
        user_config = get_user_config().getClass()
        controller = get_messages_controller().getClass()
        self.hook_method(
            user_config.getDeclaredMethod("isPremium"),
            PremiumHook(self),
        )
        self.hook_all_methods(
            user_config, "setCurrentUser", PatchUserHook(self, 0)
        )
        self.hook_all_methods(
            controller, "putUser", PatchUserHook(self, 0)
        )
        stars = StarsController.getInstance(0).getClass()
        method = find_method(stars, "getBalance", 3)
        if method is None:
            self.logger.error(
                "StarsController.getBalance not found, local balance is off"
            )
        else:
            self.hook_method(method, BalanceHook(self))
        try:
            loader = stars.getClassLoader()
            sheet = loader.loadClass(
                "org.telegram.ui.Stars.StarsIntroActivity$StarsNeededSheet"
            )
            self.hook_method(
                find_method(sheet, "show", 0), StarsNeededHook(self)
            )
        except Exception:
            self.logger.exception(
                "StarsNeededSheet not found, purchases may repeat"
            )
        try:
            self.install_error_hooks(stars.getClassLoader())
        except Exception:
            self.logger.exception("Error hiding hooks failed")
        try:
            self.install_market_hooks(stars.getClassLoader())
        except Exception:
            self.logger.exception(
                "NFT constructor market hooks failed"
            )
        method = find_method(controller, "processUpdates", 2)
        if method is not None:
            self.hook_method(method, FakeUpdatesHook(self))
        else:
            self.logger.error(
                "processUpdates not found, the upgrade animation is off"
            )
        connections = get_private_field(
            get_messages_controller(), "connectionsManager"
        )
        connections_class = (
            connections or ConnectionsManager.getInstance(0)
        ).getClass()
        if not self.hook_all_methods(
            connections_class, "sendRequest", SendRequestHook(self)
        ):
            self.logger.error(
                "ConnectionsManager.sendRequest not found, local purchases are off"
            )

    ERROR_WORDS = (
        "ошибк",
        "error",
        "not_found",
        "invalid",
        "_failed",
    )

    def bulletin_texts(self, bulletin) -> str:
        try:
            from android.view import ViewGroup
            from android.widget import TextView as JTextView

            texts = []
            stack = [bulletin.getLayout()]
            while stack:
                view = stack.pop()
                if isinstance(view, JTextView):
                    texts.append(str(view.getText() or ""))
                elif isinstance(view, ViewGroup):
                    for i in range(view.getChildCount()):
                        stack.append(view.getChildAt(i))
            return " ".join(texts)
        except Exception:
            return ""

    def is_error_bulletin(self, bulletin) -> bool:
        """Any bulletin whose text reads as an error ("Неизвестная ошибка: …", "…_NOT_FOUND"),
        whichever Telegram helper built it."""
        text = self.bulletin_texts(bulletin).lower()
        return any(word in text for word in self.ERROR_WORDS)

    def lift_profile_bulletins(self, bulletin):
        """exteraGram's floating tab bar covers bulletins shown on its main tabs ("Скопировано
        в буфер обмена" on the profile tab sits behind Чаты/Контакты). Those bulletins belong to
        MainTabsActivity; wrap its Bulletin.Delegate (or the profile's, when the profile is a
        tab) so the screen's own offsets stay and the bar's height is added when missing.
        """
        try:
            fragment = get_private_field(
                bulletin, "containerFragment"
            )
            texts = self.bulletin_texts(bulletin)
            if fragment is None:
                write_log(
                    f"bulletin: no fragment, text={texts[:60]!r}"
                )
                return
            name = fragment.getClass().getSimpleName()
            write_log(f"bulletin: on {name}, text={texts[:60]!r}")
            if name == "MainTabsActivity":
                pass
            elif "Profile" in name:
                last = get_last_fragment()
                if last is not None and last.equals(fragment):
                    return  # a profile opened on its own screen: no tab bar under it
            else:
                return
            current = fragment.getBulletinDelegate()
            wrappers = getattr(self, "bulletin_wrappers", [])
            if current is not None and any(
                current.equals(w) for w in wrappers
            ):
                return
            wrapper = bulletin_delegate(
                AndroidUtilities.dp(84), current, fragment
            )
            self.bulletin_wrappers = (wrappers + [wrapper])[-8:]
            fragment.setBulletinDelegate(wrapper)
            write_log(
                f"bulletin: lifted on {name} (own delegate: {current is not None})"
            )
        except Exception:
            self.logger.exception("Could not lift tab bulletins")

    def install_error_hooks(self, loader):
        factory = loader.loadClass(
            "org.telegram.ui.Components.BulletinFactory"
        )
        self.hook_all_methods(
            factory, "showForError", ErrorGateHook(self, False)
        )
        self.hook_all_methods(
            factory, "makeForError", ErrorGateHook(self, True)
        )
        self.hook_all_methods(
            factory, "showError", ErrorGateHook(self, False)
        )
        self.hook_all_methods(
            factory, "createErrorBulletin", ErrorGateHook(self, True)
        )
        self.hook_all_methods(
            factory,
            "createErrorBulletinSubtitle",
            ErrorGateHook(self, True),
        )
        self.hook_all_methods(
            loader.loadClass("org.telegram.ui.Components.Bulletin"),
            "show",
            BulletinShowHook(self),
        )
        self.hook_all_methods(
            loader.loadClass(
                "org.telegram.ui.Components.AlertsCreator"
            ),
            "processError",
            ProcessErrorHook(self),
        )
        self.hook_all_methods(
            loader.loadClass("org.telegram.ui.Components.UndoView"),
            "showWithAction",
            UndoLiftHook(self),
        )
        try:
            self.hook_all_methods(
                loader.loadClass(
                    "org.telegram.messenger.MessageObject"
                ),
                "updateReactions",
                ReactionsMergeHook(self, "update"),
            )
            self.hook_all_methods(
                loader.loadClass(
                    "org.telegram.messenger.MessagesStorage"
                ),
                "updateMessageReactions",
                ReactionsMergeHook(self, "storage"),
            )
        except Exception:
            self.logger.exception(
                "Local reactions: update hooks failed"
            )
        try:
            self.hook_all_methods(
                loader.loadClass("org.telegram.ui.ProfileActivity"),
                "processOnClickOrPress",
                OwnNumberClickHook(self),
            )
            self.hook_all_methods(
                loader.loadClass("org.telegram.ui.ProfileActivity"),
                "editRow",
                OwnNumberEditRowHook(self),
            )
            write_log("profile number hooks installed")
        except Exception:
            write_log(
                f"profile number hooks failed:\n{traceback.format_exc()}"
            )
        try:
            self.hook_all_methods(
                loader.loadClass(
                    "org.telegram.ui.FragmentUsernameBottomSheet"
                ),
                "open",
                FragmentSheetOnceHook(self),
            )
        except Exception:
            self.logger.exception(
                "FragmentUsernameBottomSheet not found"
            )
        try:
            self.hook_all_methods(
                loader.loadClass(
                    "org.telegram.ui.Gifts.GiftSheet$GiftCell"
                ),
                "setStarsGift",
                PinnedBadgeHook(),
            )
        except Exception:
            self.logger.exception(
                "GiftCell not found, no pin badge on pinned NFTs"
            )

    def install_market_hooks(self, loader):
        def cls(name):
            try:
                return loader.loadClass(name)
            except Exception:
                self.logger.error(f"{name} not found")
                return None

        def by_gift(gift):
            return (
                (gift.id, gift.title)
                if gift is not None and getattr(gift, "title", None)
                else None
            )

        send = cls("org.telegram.ui.Gifts.SendGiftSheet")
        if send is not None:
            method = find_method(send, "show", 0)
            if method is not None:
                self.hook_method(
                    method,
                    MarketRedirectHook(
                        self,
                        lambda p: by_gift(
                            get_private_field(
                                p.thisObject, "starGift"
                            )
                        ),
                        "SendGiftSheet.show",
                    ),
                )

        resale = cls("org.telegram.ui.Gifts.ResaleGiftsFragment")
        fragment = cls("org.telegram.ui.ActionBar.BaseFragment")
        if resale is not None and fragment is not None:
            method = find_method(fragment, "showAsSheet", 2)
            if method is not None:
                self.hook_method(
                    method,
                    MarketRedirectHook(
                        self,
                        lambda p: (
                            (
                                get_private_field(
                                    p.args[0], "gift_id"
                                ),
                                get_private_field(
                                    p.args[0], "gift_name"
                                ),
                            )
                            if p.args[0] is not None
                            and resale.isInstance(p.args[0])
                            else None
                        ),
                        "showAsSheet",
                    ),
                )

        intro = cls("org.telegram.ui.Stars.StarsIntroActivity")
        if intro is not None:
            method = find_method(intro, "showSoldOutGiftSheet", 4)
            if method is not None:
                self.hook_method(
                    method,
                    MarketRedirectHook(
                        self, lambda p: by_gift(p.args[2]), "soldOut"
                    ),
                )

        auction = cls("org.telegram.ui.Gifts.AuctionJoinSheet")
        if auction is not None:
            method = find_method(auction, "show", 6)
            if method is not None:
                self.hook_method(
                    method,
                    MarketRedirectHook(
                        self,
                        lambda p: (
                            int(p.args[4]),
                            self.catalog_title(int(p.args[4])),
                        ),
                        "auction",
                    ),
                )

        gift_sheet = cls("org.telegram.ui.Gifts.GiftSheet")
        if gift_sheet is not None:
            method = find_method(gift_sheet, "fillItems", 2)
            if method is not None:
                self.hook_method(method, MarketFillHook(self))
        write_log("market hooks installed")

