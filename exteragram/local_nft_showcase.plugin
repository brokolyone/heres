    # ----- basics -----

    def fg3_dp(self, v):
        return AndroidUtilities.dp(float(v))

    def fg3_has_cyrillic(self, text):
        return bool(re.search("[Ѐ-ӿ]", str(text or "")))

    def fg3_font(self, bold):
        """ProductSans Regular/Bold from the embedded TTFs, cached; DEFAULT/DEFAULT_BOLD on failure."""
        bold = bool(bold)
        cache = getattr(self, "_fg3_fonts", None)
        if cache is None:
            cache = {}
            self._fg3_fonts = cache
        if bold in cache:
            return cache[bold]
        face = None
        try:
            import base64
            import os
            base = None
            try:
                activity = self.get_activity()
                if activity is not None:
                    base = str(activity.getFilesDir().getAbsolutePath())
            except Exception:
                base = None
            if not base:
                from org.telegram.messenger import ApplicationLoader
                base = str(ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath())
            folder = os.path.join(base, "winft_fonts")
            if not os.path.isdir(folder):
                os.makedirs(folder)
            name = "ProductSansBold.ttf" if bold else "ProductSansRegular.ttf"
            path = os.path.join(folder, name)
            raw = base64.b64decode(FG3_FONT_BOLD_B64 if bold else FG3_FONT_REGULAR_B64)
            if not os.path.exists(path) or os.path.getsize(path) != len(raw):
                tmp = path + ".tmp"
                with open(tmp, "wb") as fh:
                    fh.write(raw)
                os.replace(tmp, path)
            face = Typeface.createFromFile(path)
        except Exception:
            try:
                self.fg3_log_error("ProductSans load failed, using the default typeface")
            except Exception:
                pass
            face = None
        if face is None:
            face = Typeface.DEFAULT_BOLD if bold else Typeface.DEFAULT
        cache[bold] = face
        return face

    def fg3_pad(self, view, left=0, top=0, right=0, bottom=0):
        """Adds dp padding on top of the view's current padding (keeps fg3_text half-leading)."""
        dp = self.fg3_dp
        view.setPadding(view.getPaddingLeft() + dp(left), view.getPaddingTop() + dp(top),
                        view.getPaddingRight() + dp(right), view.getPaddingBottom() + dp(bottom))
        return view

    def fg3_text(self, ctx, text, size, color, bold=False, line_height=None, cyrillic=False):
        view = TextView(ctx)
        view.setText(text if text is not None else "")
        view.setTextColor(color)
        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, float(size))
        view.setIncludeFontPadding(False)
        if cyrillic or self.fg3_has_cyrillic(text):
            view.setTypeface(Typeface.DEFAULT_BOLD if bold else Typeface.DEFAULT)
        else:
            view.setTypeface(self.fg3_font(bold))
        if line_height:
            # Line box == line_height: extra spacing between lines + half-leading as padding
            # (Android adds no line spacing after the last line).
            metrics = view.getPaint().getFontMetricsInt()
            extra = self.fg3_dp(line_height) - (metrics.descent - metrics.ascent)
            view.setLineSpacing(float(extra), 1.0)
            if extra > 0:
                view.setPadding(0, extra // 2, 0, extra - extra // 2)
        return view

    def fg3_shape(self, color, radius=8, top_only=False, stroke_color=None, stroke_width=0):
        shape = GradientDrawable()
        shape.setShape(GradientDrawable.RECTANGLE)
        shape.setColor(color)
        r = float(self.fg3_dp(radius)) if radius else 0.0
        if top_only:
            from java import jarray, jfloat
            shape.setCornerRadii(jarray(jfloat)([r, r, r, r, 0.0, 0.0, 0.0, 0.0]))
        else:
            shape.setCornerRadius(r)
        if stroke_color is not None and stroke_width:
            shape.setStroke(max(1, self.fg3_dp(stroke_width)), stroke_color)
        return shape

    def fg3_pressable(self, view, color, pressed_color, radius=8, top_only=False):
        from android.graphics.drawable import StateListDrawable
        from java import jarray
        states = StateListDrawable()
        states.addState(jarray(jint)([16842919]),  # android.R.attr.state_pressed
                        self.fg3_shape(pressed_color, radius, top_only))
        states.addState(jarray(jint)([]), self.fg3_shape(color, radius, top_only))
        view.setBackground(states)
        view.setClickable(True)
        return view

    def fg3_click(self, view, on_click):
        """Attaches a click handler that logs instead of crashing."""
        def handler(v):
            try:
                on_click()
            except Exception:
                self.fg3_log_error("Fragment click handler failed")
        view.setOnClickListener(OnClickListener(handler))
        return view

    # ----- SVG path parser -----

    _FG3_TOKEN_RE = re.compile(r"[MmLlHhVvCcSsQqTtAaZz]|[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?")

    def fg3_parse_path(self, d, path):
        """Feeds SVG path data into any object with moveTo/lineTo/cubicTo/quadTo/close."""
        tokens = self._FG3_TOKEN_RE.findall(d or "")
        counts = {"M": 2, "L": 2, "H": 1, "V": 1, "C": 6, "S": 4, "Q": 4, "T": 2, "A": 7, "Z": 0}
        i, n = 0, len(tokens)
        cx = cy = sx = sy = 0.0
        lcx = lcy = None   # last cubic control point (for S)
        lqx = lqy = None   # last quad control point (for T)
        cmd = None
        while i < n:
            tok = tokens[i]
            if tok.isalpha():
                cmd = tok
                i += 1
                if cmd in "Zz":
                    path.close()
                    cx, cy = sx, sy
                    lcx = lcy = lqx = lqy = None
                    continue
            elif cmd is None:
                break  # number before the first command: invalid
            upper = cmd.upper()
            need = counts[upper]
            if i + need > n or any(tokens[j].isalpha() for j in range(i, i + need)):
                # not enough numbers for this command: skip to the next command letter
                while i < n and not tokens[i].isalpha():
                    i += 1
                continue
            a = [float(tokens[j]) for j in range(i, i + need)]
            i += need
            rel = cmd.islower()
            ox, oy = (cx, cy) if rel else (0.0, 0.0)
            if upper == "M":
                cx, cy = a[0] + ox, a[1] + oy
                sx, sy = cx, cy
                path.moveTo(cx, cy)
                cmd = "l" if rel else "L"  # implicit repeats are line-to
                lcx = lcy = lqx = lqy = None
            elif upper == "L":
                cx, cy = a[0] + ox, a[1] + oy
                path.lineTo(cx, cy)
                lcx = lcy = lqx = lqy = None
            elif upper == "H":
                cx = a[0] + (cx if rel else 0.0)
                path.lineTo(cx, cy)
                lcx = lcy = lqx = lqy = None
            elif upper == "V":
                cy = a[0] + (cy if rel else 0.0)
                path.lineTo(cx, cy)
                lcx = lcy = lqx = lqy = None
            elif upper == "C":
                x1, y1 = a[0] + ox, a[1] + oy
                x2, y2 = a[2] + ox, a[3] + oy
                cx, cy = a[4] + ox, a[5] + oy
                path.cubicTo(x1, y1, x2, y2, cx, cy)
                lcx, lcy = x2, y2
                lqx = lqy = None
            elif upper == "S":
                if lcx is None:
                    x1, y1 = cx, cy
                else:
                    x1, y1 = 2 * cx - lcx, 2 * cy - lcy
                x2, y2 = a[0] + ox, a[1] + oy
                cx, cy = a[2] + ox, a[3] + oy
                path.cubicTo(x1, y1, x2, y2, cx, cy)
                lcx, lcy = x2, y2
                lqx = lqy = None
            elif upper == "Q":
                x1, y1 = a[0] + ox, a[1] + oy
                cx, cy = a[2] + ox, a[3] + oy
                path.quadTo(x1, y1, cx, cy)
                lqx, lqy = x1, y1
                lcx = lcy = None
            elif upper == "T":
                if lqx is None:
                    x1, y1 = cx, cy
                else:
                    x1, y1 = 2 * cx - lqx, 2 * cy - lqy
                cx, cy = a[0] + ox, a[1] + oy
                path.quadTo(x1, y1, cx, cy)
                lqx, lqy = x1, y1
                lcx = lcy = None
            elif upper == "A":
                # arcs are not used by the Fragment icons: approximate with a straight line
                cx, cy = a[5] + ox, a[6] + oy
                path.lineTo(cx, cy)
                lcx = lcy = lqx = lqy = None
        return path

    def fg3_svg_path(self, d):
        from android.graphics import Path
        return self.fg3_parse_path(d, Path())

    # ----- icons -----

    def fg3_icon_bitmap(self, name, width, height, color=None):
        """The icon drawn into a density-scaled Bitmap (SVG viewBox fitted like CSS 'contain')."""
        from android.graphics import Bitmap, Canvas, Paint, Path
        cache = getattr(self, "_fg3_bitmaps", None)
        if cache is None:
            cache = {}
            self._fg3_bitmaps = cache
        key = (name, float(width), float(height), color)
        if key in cache:
            return cache[key]
        vw, vh, parts = self.FG3_ICONS[name]
        density = float(AndroidUtilities.density)
        wpx = max(1, int(round(float(width) * density)))
        hpx = max(1, int(round(float(height) * density)))
        bitmap = Bitmap.createBitmap(wpx, hpx, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bitmap)
        scale = min(wpx / float(vw), hpx / float(vh))
        canvas.translate((wpx - vw * scale) / 2.0, (hpx - vh * scale) / 2.0)
        canvas.scale(scale, scale)
        for d, kind, part_color, stroke, evenodd, recolor in parts:
            path = self.fg3_svg_path(d)
            if evenodd:
                path.setFillType(Path.FillType.EVEN_ODD)
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setColor(color if (color is not None and recolor) else part_color)
            if kind == "stroke":
                paint.setStyle(Paint.Style.STROKE)
                paint.setStrokeWidth(float(stroke))
                paint.setStrokeCap(Paint.Cap.ROUND)
                paint.setStrokeJoin(Paint.Join.ROUND)
            else:
                paint.setStyle(Paint.Style.FILL)
            canvas.drawPath(path, paint)
        cache[key] = bitmap
        return bitmap

    def fg3_icon(self, ctx, name, width, height, color=None):
        from android.widget import ImageView
        view = ImageView(ctx)
        view.setScaleType(ImageView.ScaleType.FIT_CENTER)
        w, h = self.fg3_dp(width), self.fg3_dp(height)
        try:
            view.setImageBitmap(self.fg3_icon_bitmap(name, width, height, color))
        except Exception:
            self.fg3_log_error("Fragment icon %s failed" % name)
        view.setLayoutParams(LinearLayout.LayoutParams(w, h))
        return view

    # ----- formatting -----

    def fg3_amount(self, gram):
        try:
            value = round(float(gram), 2)
        except (TypeError, ValueError):
            return str(gram)
        text = "{:,.2f}".format(value)
        if "." in text:
            text = text.rstrip("0").rstrip(".")
        return "0" if text in ("-0", "") else text

    def fg3_fiat(self, gram):
        try:
            code = FIAT[int(self.get_setting("fiat_currency", 0) or 0)]
        except Exception:
            code = "USD"
        symbol = {"USD": "$", "EUR": "€", "RUB": "₽"}.get(code, "$")
        try:
            value = float(gram) * float(self.ton_rate(code))
        except Exception:
            value = 0.0
        return "~ " + symbol + "{:,.0f}".format(value)

    def fg3_phone(self, digits):
        d = re.sub(r"\D", "", str(digits or ""))
        if not d:
            return ""
        if len(d) == 11 and d.startswith("888"):
            return "+888 %s %s" % (d[3:7], d[7:])
        if len(d) == 7 and d.startswith("888"):
            return "+888 %s %s" % (d[3:4], d[4:])
        return format_phone(d)

    # ----- components -----

    def fg3_pill(self, ctx, text, tone, small=False):
        fg, bg = self.FG3_TONES.get(tone, self.FG3_TONES["neutral"])
        view = self.fg3_text(ctx, text, 11, fg, bold=True)
        view.setSingleLine(True)
        view.setGravity(Gravity.CENTER)
        if small:   # table chip: 11/12 bold, padding 2/5, radius 4 -> 16 tall
            view.setPadding(self.fg3_dp(5), 0, self.fg3_dp(5), 0)
            view.setHeight(self.fg3_dp(16))
            view.setBackground(self.fg3_shape(bg, 4))
        else:       # item-page status: 11/16 bold, padding 3/6, radius 5 -> 22 tall
            view.setPadding(self.fg3_dp(6), 0, self.fg3_dp(6), 0)
            view.setHeight(self.fg3_dp(22))
            view.setBackground(self.fg3_shape(bg, 5))
        return view

    def fg3_button(self, ctx, text, on_click, kind="primary", gem_amount=None, height=42):
        styles = {
            "primary": (self.FG3_PRIMARY, self.FG3_PRIMARY_PRESSED, self.FG3_TEXT, 13, 18, 15),
            "secondary": (self.FG3_SECONDARY_BTN, self.FG3_SECONDARY_PRESSED, self.FG3_TEXT, 13, 18, 15),
            "text": (self.FG3_TRANSPARENT, self.FG3_CARD, self.FG3_ACCENT, 14, 17, 12),
            "danger_text": (self.FG3_TRANSPARENT, self.FG3_CARD, self.FG3_RED, 14, 17, 12),
        }
        bg, pressed, fg, size, line, pad = styles.get(kind, styles["primary"])
        button = LinearLayout(ctx)
        button.setOrientation(LinearLayout.HORIZONTAL)
        button.setGravity(Gravity.CENTER)
        button.setMinimumHeight(self.fg3_dp(height))
        button.setPadding(self.fg3_dp(pad), 0, self.fg3_dp(pad), 0)
        self.fg3_pressable(button, bg, pressed, 8)
        if text:
            label = self.fg3_text(ctx, text, size, fg, bold=True, line_height=line)
            label.setSingleLine(True)
            from android.text import TextUtils
            label.setEllipsize(TextUtils.TruncateAt.END)
            button.addView(label, LinearLayout.LayoutParams(-2, -2))
        if gem_amount is not None:
            gem = self.fg3_icon(ctx, "gem_white", 15, 19, color=fg)
            params = LinearLayout.LayoutParams(self.fg3_dp(15), self.fg3_dp(19))
            params.leftMargin = self.fg3_dp(5 if text else 1)  # " " + margin-left 1
            params.rightMargin = self.fg3_dp(4)
            button.addView(gem, params)
            amount = gem_amount if isinstance(gem_amount, str) else self.fg3_amount(gem_amount)
            value = self.fg3_text(ctx, amount, size, fg, bold=True, line_height=line)
            value.setSingleLine(True)
            button.addView(value, LinearLayout.LayoutParams(-2, -2))
        if on_click is not None:
            self.fg3_click(button, on_click)
        return button

    def fg3_price_view(self, ctx, gram, size=14, fiat="inline", gem_size=None):
        if gem_size is None:
            gw, gh = float(size), float(size) * 1.25
        elif isinstance(gem_size, (tuple, list)):
            gw, gh = float(gem_size[0]), float(gem_size[1])
        else:
            gw, gh = float(gem_size), float(gem_size) * 1.25
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        gem = self.fg3_icon(ctx, "gem", gw, gh)
        params = LinearLayout.LayoutParams(self.fg3_dp(gw), self.fg3_dp(gh))
        params.rightMargin = self.fg3_dp(2)
        row.addView(gem, params)
        amount = self.fg3_text(ctx, self.fg3_amount(gram), size, self.FG3_TEXT, bold=True, line_height=16)
        amount.setSingleLine(True)
        row.addView(amount, LinearLayout.LayoutParams(-2, -2))
        if fiat == "inline":
            note = self.fg3_text(ctx, self.fg3_fiat(gram), 13, self.FG3_TEXT2, line_height=16)
            note.setSingleLine(True)
            p = LinearLayout.LayoutParams(-2, -2)
            p.leftMargin = self.fg3_dp(7)
            row.addView(note, p)
            return row
        if fiat == "below":
            box = LinearLayout(ctx)
            box.setOrientation(LinearLayout.VERTICAL)
            box.addView(row, LinearLayout.LayoutParams(-2, -2))
            note = self.fg3_text(ctx, self.fg3_fiat(gram), 11, self.FG3_TEXT2, line_height=16)
            note.setSingleLine(True)
            box.addView(note, LinearLayout.LayoutParams(-2, -2))
            return box
        return row

    def fg3_header(self, ctx):
        bar = LinearLayout(ctx)
        bar.setOrientation(LinearLayout.HORIZONTAL)
        bar.setGravity(Gravity.CENTER_VERTICAL)
        bar.setBackgroundColor(self.FG3_HEADER)
        bar.setMinimumHeight(self.fg3_dp(48))
        # .tm-logo-icon: 34x34 box at x 6 (18x18 content + 8 padding, background-size cover)
        logo = self.fg3_icon(ctx, "logo", 34, 34)
        p = LinearLayout.LayoutParams(self.fg3_dp(34), self.fg3_dp(34))
        p.leftMargin = self.fg3_dp(6)
        bar.addView(logo, p)
        # .tm-logo-text: 77x18 at x 32 (overlaps the icon's padding by 8)
        word = self.fg3_icon(ctx, "wordmark", 77, 18)
        p = LinearLayout.LayoutParams(self.fg3_dp(77), self.fg3_dp(18))
        p.leftMargin = -self.fg3_dp(8)
        bar.addView(word, p)
        bar.setLayoutParams(LinearLayout.LayoutParams(-1, self.fg3_dp(48)))
        return bar

    FG3_TABS_H = 54  # the tab row is the top of the sheet: no FRAGMENT header above it

    def fg3_tabs(self, ctx, items, active_index):
        from android.view import View
        from android.widget import FrameLayout
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setBackgroundColor(self.FG3_HEADER)
        row.setPadding(self.fg3_dp(17), 0, self.fg3_dp(17), 0)
        for index, item in enumerate(items):
            label, on_click = item[0], item[1]
            active = index == active_index
            cell = FrameLayout(ctx)
            text = self.fg3_text(ctx, label, 18, self.FG3_TEXT if active else self.FG3_TAB_INACTIVE, bold=True)
            text.setSingleLine(True)
            text.setGravity(Gravity.CENTER_VERTICAL)
            cell.addView(text, FrameLayout.LayoutParams(-2, -1))
            if active:
                line = View(ctx)
                line.setBackground(self.fg3_shape(self.FG3_TAB_UNDERLINE, 3, top_only=True))
                cell.addView(line, FrameLayout.LayoutParams(-1, self.fg3_dp(4), Gravity.BOTTOM))
            elif on_click is not None:
                self.fg3_click(cell, on_click)
            params = LinearLayout.LayoutParams(-2, -1)
            if index > 0:
                params.leftMargin = self.fg3_dp(17)
            row.addView(cell, params)
        row.setLayoutParams(LinearLayout.LayoutParams(-1, self.fg3_dp(self.FG3_TABS_H)))
        return row

    def fg3_box(self, ctx):
        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setBackground(self.fg3_shape(self.FG3_CARD, 8))
        box.setClipToOutline(True)
        return box

    def fg3_table_header(self, ctx, columns):
        from android.text import TextUtils
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setBackgroundColor(self.FG3_THEAD)
        row.setGravity(Gravity.BOTTOM)
        row.setMinimumHeight(self.fg3_dp(30))
        count = len(columns)
        for index, column in enumerate(columns):
            label = column[0]
            weight = column[1] if len(column) > 1 else 1
            gravity = column[2] if len(column) > 2 and column[2] is not None else Gravity.START
            cell = self.fg3_text(ctx, label, 12, self.FG3_TABLE_TEXT, bold=True, line_height=16)
            cell.setSingleLine(True)
            cell.setEllipsize(TextUtils.TruncateAt.END)
            cell.setGravity((gravity & Gravity.RELATIVE_HORIZONTAL_GRAVITY_MASK) | Gravity.BOTTOM)
            self.fg3_pad(cell, 16 if index == 0 else 8, 7, 16 if index == count - 1 else 8, 7)
            if weight:
                params = LinearLayout.LayoutParams(0, -2, float(weight))
            else:
                params = LinearLayout.LayoutParams(-2, -2)
            row.addView(cell, params)
        return row

    def fg3_divider(self, ctx):
        from android.view import View
        line = View(ctx)
        line.setBackgroundColor(self.FG3_DIVIDER)
        line.setLayoutParams(LinearLayout.LayoutParams(-1, self.fg3_dp(1)))
        return line

    def fg3_info_list(self, ctx, rows):
        from android.text import TextUtils
        box = self.fg3_box(ctx)
        for index, item in enumerate(rows):
            label, value = item[0], item[1]
            on_click = item[2] if len(item) > 2 else None
            if index > 0:
                box.addView(self.fg3_divider(ctx))
            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setPadding(self.fg3_dp(16), self.fg3_dp(8), self.fg3_dp(16), self.fg3_dp(8))
            title = self.fg3_text(ctx, label, 13, self.FG3_TEXT, bold=True, line_height=18)
            title.setSingleLine(True)
            row.addView(title, LinearLayout.LayoutParams(-2, -2))
            text = self.fg3_text(ctx, value, 14, self.FG3_ACCENT, line_height=18)
            text.setSingleLine(True)
            text.setGravity(Gravity.END | Gravity.CENTER_VERTICAL)
            value_str = str(value or "")
            middle = value_str.endswith(".t.me") or value_str.endswith(".ton")
            text.setEllipsize(TextUtils.TruncateAt.MIDDLE if middle else TextUtils.TruncateAt.END)
            params = LinearLayout.LayoutParams(0, -2, 1.0)
            params.leftMargin = self.fg3_dp(30)
            row.addView(text, params)
            if on_click is not None:
                self.fg3_pressable(row, self.FG3_CARD, self.FG3_ROW_PRESSED, 0)
                self.fg3_click(row, on_click)
            box.addView(row, LinearLayout.LayoutParams(-1, -2))
        return box

    def fg3_section_title(self, ctx, text):
        title = self.fg3_text(ctx, text, 18, self.FG3_TEXT, bold=True, line_height=28)
        self.fg3_pad(title, 6, 18, 6, 9)
        return title

    # ----- page / sheets / toast -----

    def fg3_switch_tab(self, index):
        current = getattr(self, "fg3_tab_index", None)
        if current == index:
            return
        if index == 0:
            self.manage_usernames()
        else:
            self.manage_number()

    def fg3_page(self, ctx, tab_index=None):
        root = LinearLayout(ctx)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setBackground(self.fg3_shape(self.FG3_PAGE, 12, top_only=True))
        root.setClipToOutline(True)
        root.setMinimumHeight(AndroidUtilities.displaySize.y)  # full height (clamped by the sheet)
        self.fg3_tab_index = tab_index
        if tab_index is not None:
            items = [("Usernames", lambda: self.fg3_switch_tab(0)),
                     ("Numbers", lambda: self.fg3_switch_tab(1))]
            root.addView(self.fg3_tabs(ctx, items, tab_index), LinearLayout.LayoutParams(-1, self.fg3_dp(self.FG3_TABS_H)))
        scroll = ScrollView(ctx)
        scroll.setFillViewport(True)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setOverScrollMode(2)  # View.OVER_SCROLL_NEVER
        column = LinearLayout(ctx)
        column.setOrientation(LinearLayout.VERTICAL)
        column.setPadding(self.fg3_dp(10), 0, self.fg3_dp(10), self.fg3_dp(30))
        scroll.addView(column, LinearLayout.LayoutParams(-1, -2))
        root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1.0))
        return root, column

    def fg3_sheet(self, ctx, view, need_focus):
        builder = BottomSheet.Builder(ctx, need_focus)
        builder.setApplyBottomPadding(False)
        builder.setApplyTopPadding(False)
        builder.setCustomView(view)
        try:
            sheet = builder.create()
            try:
                sheet.setDimBehindAlpha(128)  # scrim rgba(0,0,0,.5)
            except Exception:
                pass
            sheet.show()
        except Exception:
            sheet = builder.show()
        try:
            sheet.setBackgroundColor(self.FG3_TRANSPARENT)  # our view paints #1A2026 + 12dp top radius
        except Exception:
            pass
        try:
            sheet.fixNavigationBar(self.FG3_PAGE)
        except Exception:
            pass
        return sheet

    def fg3_show(self, ctx, root):
        previous = getattr(self, "active_sheet", None)
        if previous is not None:
            try:
                previous.dismiss()
            except Exception:
                pass
            self.active_sheet = None
        sheet = self.fg3_sheet(ctx, root, True)  # focusable: pages may hold a search field
        self.active_sheet = sheet
        return sheet

    def fg3_modal(self, ctx, content_view):
        outer = LinearLayout(ctx)
        outer.setOrientation(LinearLayout.VERTICAL)
        outer.setGravity(Gravity.CENTER_HORIZONTAL)
        outer.setBackground(self.fg3_shape(self.FG3_PAGE, 12, top_only=True))
        outer.setClipToOutline(True)
        outer.setPadding(self.fg3_dp(20), self.fg3_dp(22), self.fg3_dp(20), self.fg3_dp(30))
        width = min(self.fg3_dp(320), AndroidUtilities.displaySize.x - self.fg3_dp(40))
        outer.addView(content_view, LinearLayout.LayoutParams(width, -2))
        sheet = self.fg3_sheet(ctx, outer, True)
        self.fg3_active_modal = sheet
        return sheet

    def fg3_toast(self, text):
        def show():
            try:
                from android.widget import FrameLayout
                window = None
                for attr in ("fg3_active_modal", "active_sheet"):
                    sheet = getattr(self, attr, None)
                    try:
                        if sheet is not None and sheet.isShowing():
                            window = sheet.getWindow()
                            break
                    except Exception:
                        pass
                ctx = self.get_activity()
                if window is None:
                    window = ctx.getWindow()
                decor = window.getDecorView()
                toast = self.fg3_text(window.getContext(), text, 14, self.FG3_TEXT, line_height=19)
                self.fg3_pad(toast, 24, 8, 24, 8)
                toast.setGravity(Gravity.CENTER)
                toast.setMaxWidth(self.fg3_dp(320))
                toast.setBackground(self.fg3_shape(self.FG3_TOAST_BG, 8))
                params = FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.CENTER_HORIZONTAL)
                params.topMargin = AndroidUtilities.statusBarHeight + self.fg3_dp(48 + 20)
                params.leftMargin = params.rightMargin = self.fg3_dp(20)
                toast.setAlpha(0.0)
                decor.addView(toast, params)
                toast.animate().alpha(1.0).setDuration(200).start()

                def hide():
                    try:
                        toast.animate().alpha(0.0).setDuration(200).withEndAction(
                            R(lambda: decor.removeView(toast))).start()
                    except Exception:
                        pass
                run_on_ui_thread(hide, 2000)
            except Exception:
                self.fg3_log_error("Fragment toast failed, using a bulletin")
                BulletinHelper.show_info(text)
        run_on_ui_thread(show)

    # ===================================================================
    # Builder B: Fragment "Usernames" table page (fragment.com main list,
    # thin/mobile layout at 390px; 1 CSS px == 1 dp). English wording.
    # Uses only the shared fg3_* core API plus a few plain Android views.
    # ===================================================================

    FG3B_PAGE = _argb(0xFF1A2026)
    FG3B_CARD = _argb(0xFF212A33)
    FG3B_THEAD = _argb(0xFF293440)
    FG3B_FIELD = _argb(0xFF242E38)
    FG3B_WHITE = _argb(0xFFFFFFFF)
    FG3B_TEXT2 = _argb(0xFF8794A1)
    FG3B_TABLE_TEXT = _argb(0xFF8C9AA9)
    FG3B_ACCENT = _argb(0xFF4DB2FF)
    FG3B_PLACEHOLDER = _argb(0xFF8A98A6)
    FG3B_PLACEHOLDER_FOCUS = _argb(0x668A98A6)  # placeholder at opacity .4 while focused
    FG3B_SORT_GREY = _argb(0xFF838F9C)

    FG3B_INTRO_TITLE = "Buy and Sell Usernames"
    FG3B_INTRO_PARTS = [
        ("Secure your name", True),
        (" with blockchain in an ecosystem of ", False),
        ("1+ billion", True),
        (" users and assign it as a link for your personal account, channel or group. ", False),
    ]
    FG3B_LEARN_MORE = "Learn more ›"
    FG3B_PLACEHOLDER_TEXT = "Enter a Telegram user​name..."
    FG3B_SORT_DESC_PATHS = (
        "m2 7.02 2.94-2.96c.04-.03.09-.03.13 0l3 2.96m-3.04-2.47v8.76",
        "m9.93 10.98 2.94 2.96c.04.03.09.03.13 0l3-2.96m-3.04 2.47v-8.76",
    )

    def fragment_usernames_sheet(self):
        try:
            self.fg3b_build_usernames_sheet()
        except Exception:
            self.fg3_log_error("Fragment usernames page failed, using dialogs")
            try:
                self.active_sheet_dismiss()
            except Exception:
                pass
            self.manage_usernames_dialog()

    # ----- page -----

    def fg3b_build_usernames_sheet(self):
        ctx = self.get_activity()
        if ctx is None:
            return
        root, column = self.fg3_page(ctx, 0)
        state = {"query": "", "desc": True, "edit": None}

        try:
            column.addView(self.fg3b_intro(ctx), LinearLayout.LayoutParams(-1, -2))
        except Exception:
            self.fg3_log_error("usernames intro failed")

        try:
            search, edit = self.fg3b_search_field(ctx, state)
            state["edit"] = edit
            lp = LinearLayout.LayoutParams(-1, self.fg3_dp(42))
            lp.bottomMargin = self.fg3_dp(5)
            column.addView(search, lp)
        except Exception:
            self.fg3_log_error("usernames search field failed")

        header, title, sort_btn = self.fg3b_section_header(ctx, state)
        column.addView(header, LinearLayout.LayoutParams(-1, -2))

        results = LinearLayout(ctx)
        results.setOrientation(LinearLayout.VERTICAL)
        column.addView(results, LinearLayout.LayoutParams(-1, -2))

        def render():
            query = state["query"]
            title.setText("Results" if query else "My Assets")
            results.removeAllViews()
            items = self.fg3b_filtered(query, state["desc"])
            if items:
                results.addView(self.fg3b_table(ctx, items, state), LinearLayout.LayoutParams(-1, -2))
            else:
                text = "No usernames found." if query else "You don't have any collectible usernames yet."
                results.addView(self.fg3b_empty_box(ctx, text), LinearLayout.LayoutParams(-1, -2))

        state["render"] = render

        def on_sort():
            state["desc"] = not state["desc"]
            self.fg3b_set_sort_icon(ctx, sort_btn, state["desc"])
            render()

        sort_btn.setOnClickListener(OnClickListener(lambda v: self.fg3b_safe(on_sort)))

        add = self.fg3_button(ctx, "Add Username", lambda *a: self.fg3b_safe(lambda: self.fg3b_on_add(state)),
                              kind="primary")
        lp = LinearLayout.LayoutParams(-1, self.fg3_dp(42))
        lp.topMargin = self.fg3_dp(15)
        lp.bottomMargin = self.fg3_dp(70)  # main padding-bottom
        column.addView(add, lp)

        render()
        sheet = self.fg3_show(ctx, root)
        try:
            # fg3_show builds a non-focusable sheet; the search field needs the keyboard.
            sheet.setFocusable(True)
        except Exception:
            pass
        return sheet

    def fg3b_safe(self, fn):
        try:
            fn()
        except Exception:
            self.fg3_log_error("Fragment usernames page action failed")

    def fg3b_filtered(self, query, desc):
        primary = (self.get_setting("primary_username", "") or "").lower()
        q = (query or "").strip().lower().lstrip("@")
        rows = []
        for d in self.get_usernames():
            name = d["name"]
            if q and q not in name.lower() and q not in (name.lower() + ".t.me"):
                continue
            try:
                gram = float(d.get("price") or DEFAULT_PRICE)
            except (TypeError, ValueError):
                gram = float(DEFAULT_PRICE)
            rows.append((name, gram, name.lower() == primary))
        rows.sort(key=lambda r: r[1], reverse=bool(desc))
        return rows

    # ----- intro (h1 22/30 bold + p 13/17 #8794A1, padding 21/12 -> 2 inside the 10dp gutter) -----

    def fg3b_intro(self, ctx):
        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setGravity(Gravity.CENTER_HORIZONTAL)
        box.setPadding(self.fg3_dp(2), self.fg3_dp(21), self.fg3_dp(2), self.fg3_dp(21))

        h1 = self.fg3_text(ctx, self.FG3B_INTRO_TITLE, 22, self.FG3B_WHITE, bold=True, line_height=30)
        h1.setGravity(Gravity.CENTER)
        box.addView(h1, LinearLayout.LayoutParams(-1, -2))

        p = self.fg3_text(ctx, "", 13, self.FG3B_TEXT2, line_height=17)
        p.setGravity(Gravity.CENTER)
        p.setText(self.fg3b_intro_spannable())
        lp = LinearLayout.LayoutParams(-1, -2)
        lp.topMargin = self.fg3_dp(4)
        box.addView(p, lp)
        return box

    def fg3b_intro_spannable(self):
        from android.text import SpannableStringBuilder
        from android.text.style import ForegroundColorSpan, StyleSpan
        flags = 33  # Spanned.SPAN_EXCLUSIVE_EXCLUSIVE
        sb = SpannableStringBuilder()
        bold_face = self.fg3_font(True)
        for text, bold in self.FG3B_INTRO_PARTS:
            start = sb.length()
            sb.append(text)
            if bold:
                span = None
                try:
                    from android.text.style import TypefaceSpan
                    span = TypefaceSpan(bold_face)  # API 28+: the real ProductSans Bold face
                except Exception:
                    span = StyleSpan(Typeface.BOLD)
                sb.setSpan(span, start, sb.length(), flags)
        start = sb.length()
        sb.append(self.FG3B_LEARN_MORE)
        sb.setSpan(ForegroundColorSpan(self.FG3B_ACCENT), start, sb.length(), flags)
        return sb

    # ----- search field (370x42, #242E38 r8; magnifier 15x18 @ 19/12; text inset 48/42; clear 42x42) -----

    def fg3b_proxy_class(self, key, iface, methods):
        cache = getattr(type(self), "_fg3b_proxies", None)
        if cache is None:
            cache = {}
            setattr(type(self), "_fg3b_proxies", cache)
        cls = cache.get(key)
        if cls is None:
            cls = methods(iface)
            cache[key] = cls
        return cls

    def fg3b_text_watcher(self, on_text):
        from java import dynamic_proxy
        from android.text import TextWatcher

        def make(iface):
            class _Watcher(dynamic_proxy(iface)):
                def __init__(self, cb):
                    super().__init__()
                    self.cb = cb

                def beforeTextChanged(self, s, start, count, after):
                    pass

                def onTextChanged(self, s, start, before, count):
                    pass

                def afterTextChanged(self, s):
                    self.cb(str(s) if s is not None else "")
            return _Watcher

        return self.fg3b_proxy_class("watcher", TextWatcher, make)(on_text)

    def fg3b_focus_listener(self, on_focus):
        from java import dynamic_proxy
        from android.view import View

        def make(iface):
            class _Focus(dynamic_proxy(iface)):
                def __init__(self, cb):
                    super().__init__()
                    self.cb = cb

                def onFocusChange(self, view, has_focus):
                    self.cb(bool(has_focus))
            return _Focus

        return self.fg3b_proxy_class("focus", View.OnFocusChangeListener, make)(on_focus)

    def fg3b_search_field(self, ctx, state):
        from android.widget import FrameLayout
        from android.view import View
        from android.view.inputmethod import EditorInfo
        from android.text import TextUtils

        dp = self.fg3_dp
        field = FrameLayout(ctx)
        field.setBackground(self.fg3_shape(self.FG3B_FIELD, 8))

        icon = self.fg3_icon(ctx, "search", 15, 18)
        lp = FrameLayout.LayoutParams(dp(15), dp(18))
        lp.gravity = Gravity.START | Gravity.TOP
        lp.leftMargin = dp(19)
        lp.topMargin = dp(12)
        field.addView(icon, lp)

        edit = EditText(ctx)
        edit.setBackground(None)
        edit.setTypeface(self.fg3_font(False))
        edit.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        edit.setTextColor(self.FG3B_WHITE)
        edit.setHintTextColor(self.FG3B_PLACEHOLDER)
        edit.setHint(self.FG3B_PLACEHOLDER_TEXT)
        edit.setIncludeFontPadding(False)
        edit.setSingleLine(True)
        edit.setEllipsize(TextUtils.TruncateAt.END)
        edit.setGravity(Gravity.CENTER_VERTICAL | Gravity.START)
        edit.setPadding(dp(48), dp(12), dp(42), dp(12))
        edit.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS)
        edit.setImeOptions(EditorInfo.IME_ACTION_SEARCH | EditorInfo.IME_FLAG_NO_EXTRACT_UI)
        try:
            cursor = self.fg3_shape(self.FG3B_ACCENT, 1)
            cursor.setSize(dp(2), dp(18))
            edit.setTextCursorDrawable(cursor)  # API 29+
        except Exception:
            pass
        field.addView(edit, FrameLayout.LayoutParams(-1, -1))

        clear = FrameLayout(ctx)
        clear.setPadding(dp(12), dp(12), dp(12), dp(12))
        clear.addView(self.fg3_icon(ctx, "clear", 18, 18), FrameLayout.LayoutParams(dp(18), dp(18)))
        clear.setVisibility(View.INVISIBLE)
        lp = FrameLayout.LayoutParams(dp(42), dp(42))
        lp.gravity = Gravity.END | Gravity.TOP
        field.addView(clear, lp)
        clear.setOnClickListener(OnClickListener(lambda v: edit.setText("")))

        def on_text(text):
            clear.setVisibility(View.VISIBLE if text else View.INVISIBLE)
            if text != state["query"]:
                state["query"] = text
                render = state.get("render")
                if render is not None:
                    self.fg3b_safe(render)

        def on_focus(has_focus):
            edit.setHintTextColor(self.FG3B_PLACEHOLDER_FOCUS if has_focus else self.FG3B_PLACEHOLDER)

        edit.addTextChangedListener(self.fg3b_text_watcher(on_text))
        try:
            edit.setOnFocusChangeListener(self.fg3b_focus_listener(on_focus))
        except Exception:
            pass
        return field, edit

    # ----- section header ("My Assets" 18/28 bold, padding 18/0/9; sort button 28h) -----

    def fg3b_section_header(self, ctx, state):
        dp = self.fg3_dp
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(0, dp(18), 0, dp(9))

        title = self.fg3_text(ctx, "My Assets", 18, self.FG3B_WHITE, bold=True, line_height=28)
        title.setPadding(dp(6), 0, dp(6), 0)
        title.setSingleLine(True)
        row.addView(title, LinearLayout.LayoutParams(0, -2, 1.0))

        btn = LinearLayout(ctx)
        btn.setOrientation(LinearLayout.HORIZONTAL)
        btn.setGravity(Gravity.CENTER_VERTICAL)
        btn.setPadding(dp(9), dp(5), dp(9), dp(5))
        self.fg3_pressable(btn, self.FG3B_FIELD, self.FG3B_THEAD, 8)

        try:
            sort_icon = self.fg3b_sort_icon(ctx, state["desc"])
            lp = LinearLayout.LayoutParams(dp(18), dp(18))
            lp.rightMargin = dp(4)
            btn.addView(sort_icon, lp)
        except Exception:
            self.fg3_log_error("usernames sort icon failed")
        btn.addView(self.fg3_text(ctx, "Price", 13, self.FG3B_WHITE, bold=True, line_height=18))
        caret = self.fg3_icon(ctx, "caret", 11, 18)
        lp = LinearLayout.LayoutParams(dp(11), dp(18))
        lp.leftMargin = dp(4)
        lp.rightMargin = -dp(1)
        btn.addView(caret, lp)

        lp = LinearLayout.LayoutParams(-2, dp(28))
        lp.leftMargin = dp(5)
        row.addView(btn, lp)
        return row, title, btn

    def fg3b_sort_icon(self, ctx, desc):
        from android.widget import ImageView
        view = ImageView(ctx)
        view.setImageBitmap(self.fg3b_sort_bitmap(desc))
        return view

    def fg3b_set_sort_icon(self, ctx, btn, desc):
        try:
            btn.getChildAt(0).setImageBitmap(self.fg3b_sort_bitmap(desc))
        except Exception:
            self.fg3_log_error("sort icon update failed")

    def fg3b_sort_bitmap(self, desc):
        # Fragment sort-desc / sort-asc icon (18x18 viewBox, stroke 1.5, round caps):
        # desc = left arrow grey, right arrow white; asc swaps them.
        from android.graphics import Bitmap, Canvas, Paint
        size = self.fg3_dp(18)
        bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)
        scale = size / 18.0
        canvas.scale(scale, scale)
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setStyle(Paint.Style.STROKE)
        paint.setStrokeWidth(1.5)
        paint.setStrokeCap(Paint.Cap.ROUND)
        paint.setStrokeJoin(Paint.Join.ROUND)
        left, right = self.FG3B_SORT_DESC_PATHS
        colors = (self.FG3B_SORT_GREY, self.FG3B_WHITE) if desc else (self.FG3B_WHITE, self.FG3B_SORT_GREY)
        for d, color in ((left, colors[0]), (right, colors[1])):
            paint.setColor(color)
            canvas.drawPath(self.fg3_svg_path(d), paint)
        return bmp

    # ----- table -----

    def fg3b_table(self, ctx, items, state):
        box = self.fg3_box(ctx)
        box.addView(self.fg3_table_header(ctx, [
            ("Username", 55, Gravity.START),
            ("Value", 45, Gravity.START),
        ]), LinearLayout.LayoutParams(-1, self.fg3_dp(30)))
        for i, (name, gram, is_primary) in enumerate(items):
            if i:
                box.addView(self.fg3_divider(ctx), LinearLayout.LayoutParams(-1, self.fg3_dp(1)))
            box.addView(self.fg3b_row(ctx, name, gram, is_primary, state),
                        LinearLayout.LayoutParams(-1, self.fg3_dp(44)))
        return box

    def fg3b_shrink_line(self, ctx, first, extras):
        # Fragment's flex row: the first text ellipsizes, the extras never shrink.
        line = LinearLayout(ctx)
        line.setOrientation(LinearLayout.HORIZONTAL)
        line.setGravity(Gravity.CENTER_VERTICAL)
        line.addView(first, LinearLayout.LayoutParams(-2, -2, 1.0))
        for view, lp in extras:
            line.addView(view, lp)
        return line

    def fg3b_row(self, ctx, name, gram, is_primary, state):
        from android.widget import FrameLayout
        from android.text import TextUtils
        dp = self.fg3_dp

        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        self.fg3_pressable(row, self.FG3B_CARD, self.FG3B_THEAD, 0)

        # column 1 (55%): "@name" 14/16 bold [+ check] [+ "Sold" chip], "name.t.me" 11/16 accent
        col1 = LinearLayout(ctx)
        col1.setOrientation(LinearLayout.VERTICAL)
        col1.setGravity(Gravity.CENTER_VERTICAL)
        col1.setPadding(dp(16), dp(6), dp(8), dp(5))

        value = self.fg3_text(ctx, "@" + name, 14, self.FG3B_WHITE, bold=True, line_height=16)
        value.setSingleLine(True)
        value.setEllipsize(TextUtils.TruncateAt.END)
        extras = []
        if is_primary:
            check = self.fg3_icon(ctx, "check", 14, 10)
            lp = LinearLayout.LayoutParams(dp(14), dp(10))
            lp.leftMargin = dp(5)
            extras.append((check, lp))
        chip = self.fg3_pill(ctx, "Sold", "red", small=True)
        lp = LinearLayout.LayoutParams(-2, dp(16))
        lp.leftMargin = dp(4)
        extras.append((chip, lp))
        col1.addView(self.fg3b_shrink_line(ctx, value, extras), LinearLayout.LayoutParams(-2, dp(16)))

        sub = self.fg3_text(ctx, name, 11, self.FG3B_ACCENT, line_height=16)
        sub.setSingleLine(True)
        sub.setEllipsize(TextUtils.TruncateAt.END)
        domain = self.fg3_text(ctx, ".t.me", 11, self.FG3B_ACCENT, line_height=16)
        domain.setSingleLine(True)
        col1.addView(self.fg3b_shrink_line(ctx, sub, [(domain, LinearLayout.LayoutParams(-2, -2))]),
                     LinearLayout.LayoutParams(-2, dp(16)))
        row.addView(col1, LinearLayout.LayoutParams(0, -1, 55.0))

        # column 2 (45%): gem + price 13/16 bold, "Sale price" 11/16 #8C9AA9, chevron 9x17 @ right 12
        col2 = FrameLayout(ctx)
        inner = LinearLayout(ctx)
        inner.setOrientation(LinearLayout.VERTICAL)
        inner.setGravity(Gravity.CENTER_VERTICAL)
        inner.setPadding(dp(8), dp(6), dp(32), dp(5))
        price = self.fg3_price_view(ctx, gram, size=13, fiat=None)
        inner.addView(price, LinearLayout.LayoutParams(-2, -2))
        desc = self.fg3_text(ctx, "Sale price", 11, self.FG3B_TABLE_TEXT, line_height=16)
        desc.setSingleLine(True)
        desc.setEllipsize(TextUtils.TruncateAt.END)
        inner.addView(desc, LinearLayout.LayoutParams(-2, dp(16)))
        col2.addView(inner, FrameLayout.LayoutParams(-1, -1))
        chevron = self.fg3_icon(ctx, "chevron", 9, 17)
        lp = FrameLayout.LayoutParams(dp(9), dp(17))
        lp.gravity = Gravity.END | Gravity.CENTER_VERTICAL
        lp.rightMargin = dp(12)
        col2.addView(chevron, lp)
        row.addView(col2, LinearLayout.LayoutParams(0, -1, 45.0))

        row.setOnClickListener(OnClickListener(
            lambda v, n=name: self.fg3b_safe(lambda: self.fg3b_open_username(n, state))))
        return row

    def fg3b_empty_box(self, ctx, text):
        # .tm-table-empty: padding 22/15, #212A33 r8, 14/20 #8C9AA9 centered (64dp tall)
        view = self.fg3_text(ctx, text, 14, self.FG3B_TABLE_TEXT, line_height=20)
        view.setGravity(Gravity.CENTER)
        view.setPadding(self.fg3_dp(15), self.fg3_dp(22), self.fg3_dp(15), self.fg3_dp(22))
        view.setBackground(self.fg3_shape(self.FG3B_CARD, 8))
        return view

    # ----- navigation -----

    def fg3b_hide_keyboard(self, state):
        edit = state.get("edit") if state else None
        if edit is not None:
            try:
                AndroidUtilities.hideKeyboard(edit)
                edit.clearFocus()
            except Exception:
                pass

    def fg3b_open_username(self, name, state):
        self.fg3b_hide_keyboard(state)
        page = getattr(self, "fragment_username_page", None)
        if page is not None:
            try:
                page(name)
                return
            except Exception:
                self.fg3_log_error("fragment_username_page failed, using the actions dialog")
        self.active_sheet_dismiss()
        self.username_actions(name)

    def fg3b_on_add(self, state):
        self.fg3b_hide_keyboard(state)
        modal = getattr(self, "fg3_add_username_modal", None)
        if modal is not None:
            try:
                modal()
                return
            except Exception:
                self.fg3_log_error("fg3_add_username_modal failed, using the dialog")
        self.active_sheet_dismiss()
        self.add_username_dialog()

    # ===== Builder C: Fragment username item page (fragment.com/username/<name>, "Sold" state) =====
    # Uses only the shared fg3_* core API (fg3_core.py) plus plugin data methods.

    FG3C_WHITE = _argb(0xFFFFFFFF)
    FG3C_TABLE_TEXT = _argb(0xFF8C9AA9)
    FG3C_ACCENT = _argb(0xFF4DB2FF)
    FG3C_CARD = _argb(0xFF212A33)
    FG3C_THEAD = _argb(0xFF293440)
    FG3C_DIVIDER = _argb(0xFF1A2026)
    FG3C_MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

    def fragment_username_page(self, name):
        try:
            self.fg3c_build_page(name)
        except Exception:
            self.fg3_log_error("Fragment username page failed, using dialogs")
            try:
                self.fg3c_dismiss()
            except Exception:
                pass
            self.username_actions(name)

    # ----- data -----

    def fg3c_item(self, name):
        for d in self.get_usernames():
            if d["name"].lower() == name.lower():
                return d
        return None

    def fg3c_is_main(self, name):
        return (self.get_setting("primary_username", "") or "").lower() == name.lower()

    def fg3c_save_price(self, name, value):
        # Same storage as set_username_price, without its trailing manage_usernames().
        try:
            price = float(value)
        except (TypeError, ValueError):
            BulletinHelper.show_error("Нужно число")
            return
        if price < 0:
            price = 0.0
        items = self.get_usernames()
        for d in items:
            if d["name"].lower() == name.lower():
                d["price"] = price
        self.save_usernames(items)  # also refresh_own_users()
        self.fg3c_rerender(name)

    def fg3c_remove(self, name):
        was_main = self.fg3c_is_main(name)
        items = [d for d in self.get_usernames() if d["name"].lower() != name.lower()]
        if was_main:
            self.set_setting("primary_username", "")
        self.save_usernames(items)  # also refresh_own_users()
        self.fg3c_dismiss()
        self.fg3c_toast("@" + name + " удалён")
        self.manage_usernames()  # -> fragment_usernames_sheet (with dialog fallback)

    def fg3c_toggle_main(self, name):
        if self.fg3c_is_main(name):
            self.set_setting("primary_username", "")
            self.fg3c_toast("Основной юзернейм снят")
        else:
            self.set_setting("primary_username", name)
            self.fg3c_toast("@" + name + " теперь основной")
        self.refresh_own_users()
        self.fg3c_rerender(name)

    # ----- navigation / helpers -----

    def fg3c_dismiss(self):
        sheet = getattr(self, "fg3c_sheet", None)
        self.fg3c_sheet = None
        if sheet is not None:
            try:
                sheet.dismiss()
            except Exception:
                pass
            if getattr(self, "active_sheet", None) is sheet:
                self.active_sheet = None

    def fg3c_rerender(self, name):
        self.fg3c_dismiss()
        if self.fg3c_item(name) is None:
            self.manage_usernames()
            return
        self.fragment_username_page(name)

    def fg3c_back(self):
        self.fg3c_dismiss()
        try:
            self.fragment_usernames_sheet()
        except Exception:
            self.fg3_log_error("Fragment usernames sheet failed")
            self.manage_usernames_dialog()

    def fg3c_toast(self, text):
        try:
            self.fg3_toast(text)
        except Exception:
            BulletinHelper.show_success(text)

    def fg3c_copy(self, text):
        try:
            copy_to_clipboard(text)
            self.fg3c_toast("Скопировано: " + text)
        except Exception:
            self.fg3_log_error("copy failed")

    def fg3c_date(self, ts, long_form=False):
        # long_form: "18 Nov 2022 at 10:16" (bid card); short: "Jun 2 at 17:33" / "Nov 18, 2022 at 10:16"
        t = time.localtime(int(ts))
        mon = self.FG3C_MONTHS[t.tm_mon - 1]
        hm = "%02d:%02d" % (t.tm_hour, t.tm_min)
        if long_form:
            return "%d %s %d at %s" % (t.tm_mday, mon, t.tm_year, hm)
        if t.tm_year == time.localtime().tm_year:
            return "%s %d at %s" % (mon, t.tm_mday, hm)
        return "%s %d, %d at %s" % (mon, t.tm_mday, t.tm_year, hm)

    def fg3c_lp(self, width, height, weight=None, left=0, top=0, right=0, bottom=0):
        if weight is None:
            lp = LinearLayout.LayoutParams(width, height)
        else:
            lp = LinearLayout.LayoutParams(width, height, float(weight))
        lp.setMargins(self.fg3_dp(left), self.fg3_dp(top), self.fg3_dp(right), self.fg3_dp(bottom))
        return lp

    def fg3c_ellipsize(self, view):
        from android.text import TextUtils
        view.setSingleLine(True)
        view.setEllipsize(TextUtils.TruncateAt.END)
        return view

    def fg3c_cell(self, ctx, child, weight, first, last, gravity=None):
        # td: padding 8 8, first col left 16, last col right 16
        cell = LinearLayout(ctx)
        cell.setOrientation(LinearLayout.VERTICAL)
        cell.setGravity(gravity if gravity is not None else (Gravity.CENTER_VERTICAL | Gravity.LEFT))
        cell.setPadding(self.fg3_dp(16 if first else 8), self.fg3_dp(8),
                        self.fg3_dp(16 if last else 8), self.fg3_dp(8))
        cell.addView(child, LinearLayout.LayoutParams(-1, -2))
        return cell, self.fg3c_lp(0, -1, weight)

    # ----- page -----

    def fg3c_build_page(self, name):
        ctx = self.get_activity()
        if ctx is None:
            return
        item = self.fg3c_item(name)
        if item is None:
            self.manage_usernames()
            return
        name = item["name"]
        gram = float(item.get("price") or DEFAULT_PRICE)
        date = item.get("date")
        try:
            date = int(date) if date else None
        except (TypeError, ValueError):
            date = None
        is_main = self.fg3c_is_main(name)

        root, column = self.fg3_page(ctx, 0)
        column.addView(self.fg3c_back_row(ctx), LinearLayout.LayoutParams(-1, -2))
        column.addView(self.fg3c_title_row(ctx, name), LinearLayout.LayoutParams(-1, -2))
        column.addView(self.fg3c_bid_info(ctx, gram, date), self.fg3c_lp(-1, -2, bottom=16))

        rows = [
            ("Telegram Username", "@" + name, lambda *a: self.fg3c_copy("@" + name)),
            ("Web Address", "t.me/" + name, lambda *a: self.fg3c_copy("https://t.me/" + name)),
            ("TON Web 3.0 Address", name + ".t.me", lambda *a: self.fg3c_copy(name + ".t.me")),
        ]
        column.addView(self.fg3_info_list(ctx, rows), self.fg3c_lp(-1, -2, bottom=16))

        # .tm-section-buttons: owner actions instead of "Place bid" / "Buy for"
        if is_main:
            main_btn = self.fg3_button(ctx, "Main username", lambda *a: self.fg3c_ask_unset_main(name),
                                       kind="secondary")
        else:
            main_btn = self.fg3_button(ctx, "Set as main username", lambda *a: self.fg3c_toggle_main(name),
                                       kind="primary")
        column.addView(main_btn, self.fg3c_lp(-1, self.fg3_dp(42), bottom=10))
        price_btn = self.fg3_button(ctx, "Change Price", lambda *a: self.fg3c_ask_price(name),
                                    kind="secondary")
        column.addView(price_btn, self.fg3c_lp(-1, self.fg3_dp(42), bottom=16))
        # .tm-section-subscribe slot: single centered text link
        remove_btn = self.fg3_button(ctx, "Remove Username", lambda *a: self.fg3c_ask_remove(name),
                                     kind="danger_text")
        column.addView(remove_btn, self.fg3c_lp(-1, self.fg3_dp(42), bottom=11))

        if date:
            column.addView(self.fg3_section_title(ctx, "Ownership History"), LinearLayout.LayoutParams(-1, -2))
            column.addView(self.fg3c_history(ctx, gram, date), self.fg3c_lp(-1, -2, bottom=5))

        from android.view import View
        bottom = View(ctx)
        column.addView(bottom, LinearLayout.LayoutParams(-1, self.fg3_dp(70)))  # main padding-bottom 70

        sheet = self.fg3_show(ctx, root)
        self.fg3c_sheet = sheet

    def fg3c_back_row(self, ctx):
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(self.fg3_dp(6), self.fg3_dp(6), self.fg3_dp(6), 0)
        inner = LinearLayout(ctx)
        inner.setOrientation(LinearLayout.HORIZONTAL)
        inner.setGravity(Gravity.CENTER_VERTICAL)
        inner.setPadding(self.fg3_dp(4), self.fg3_dp(4), self.fg3_dp(10), self.fg3_dp(4))
        icon = self.fg3_icon(ctx, "back", 16, 16, self.FG3C_ACCENT)
        inner.addView(icon, self.fg3c_lp(self.fg3_dp(16), self.fg3_dp(16), right=6))
        label = self.fg3_text(ctx, "Usernames", 14, self.FG3C_ACCENT, line_height=20)
        inner.addView(label, LinearLayout.LayoutParams(-2, -2))
        self.fg3_pressable(inner, 0, self.FG3C_CARD, radius=8)
        inner.setOnClickListener(OnClickListener(lambda v: self.fg3c_back()))
        row.addView(inner, LinearLayout.LayoutParams(-2, -2))
        return row

    def fg3c_title_row(self, ctx, name):
        # .tm-section-header: pad 18/17, h2 22/28 bold centered + status pill (margin 5 6 1)
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_HORIZONTAL | Gravity.TOP)
        row.setPadding(self.fg3_dp(6), self.fg3_dp(18), self.fg3_dp(6), self.fg3_dp(17))
        title = self.fg3c_ellipsize(self.fg3_text(ctx, name + ".t.me", 22, self.FG3C_WHITE, bold=True, line_height=28))
        try:
            screen = ctx.getResources().getDisplayMetrics().widthPixels
            title.setMaxWidth(max(self.fg3_dp(80), screen - self.fg3_dp(20 + 12 + 34 + 12 + 8)))
        except Exception:
            pass
        row.addView(title, LinearLayout.LayoutParams(-2, -2))
        pill = self.fg3_pill(ctx, "Sold", "red")
        row.addView(pill, self.fg3c_lp(-2, -2, left=6, top=5, right=6, bottom=1))
        return row

    def fg3c_bid_info(self, ctx, gram, date):
        # .tm-section-bid-info (sold): th "Sale Price" 35% / "Owner" 65%; row; "Purchased on ..."
        box = self.fg3_box(ctx)
        box.addView(self.fg3_table_header(ctx, [("Sale Price", 35, Gravity.LEFT), ("Owner", 65, Gravity.LEFT)]),
                    LinearLayout.LayoutParams(-1, self.fg3_dp(30)))
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        price = self.fg3_price_view(ctx, gram, 14, fiat="below")
        cell, lp = self.fg3c_cell(ctx, price, 35, True, False)
        row.addView(cell, lp)
        owner = self.fg3c_ellipsize(self.fg3_text(ctx, self.fg3d_owner(), 13, self.FG3C_ACCENT, line_height=16))
        cell, lp = self.fg3c_cell(ctx, owner, 65, False, True)
        row.addView(cell, lp)
        box.addView(row, LinearLayout.LayoutParams(-1, -2))
        if date:
            info = self.fg3_text(ctx, "Purchased on " + self.fg3c_date(date, long_form=True), 13,
                                 self.FG3C_TABLE_TEXT, line_height=17)
            info.setPadding(self.fg3_dp(16), self.fg3_dp(5), self.fg3_dp(16), self.fg3_dp(10))
            box.addView(info, LinearLayout.LayoutParams(-1, -2))
        return box

    def fg3c_history(self, ctx, gram, date):
        # Ownership History table: cols 100 / 110 / 160 ("Sale price / Date / Buyer")
        box = self.fg3_box(ctx)
        box.addView(self.fg3_table_header(ctx, [("Sale price", 100, Gravity.LEFT), ("Date", 110, Gravity.LEFT),
                                                ("Buyer", 160, Gravity.LEFT)]),
                    LinearLayout.LayoutParams(-1, self.fg3_dp(30)))
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        price = self.fg3_price_view(ctx, gram, 14, fiat=None)
        cell, lp = self.fg3c_cell(ctx, price, 100, True, False)
        row.addView(cell, lp)
        when = self.fg3c_ellipsize(self.fg3_text(ctx, self.fg3c_date(date), 13, self.FG3C_TABLE_TEXT, line_height=16))
        cell, lp = self.fg3c_cell(ctx, when, 110, False, False)
        row.addView(cell, lp)
        buyer = self.fg3c_ellipsize(self.fg3_text(ctx, self.fg3d_owner(), 13, self.FG3C_ACCENT, line_height=16))
        cell, lp = self.fg3c_cell(ctx, buyer, 160, False, True)
        row.addView(cell, lp)
        box.addView(row, LinearLayout.LayoutParams(-1, -2))
        return box

    # ----- action prompts (builder E modals when present, AlertDialogs otherwise) -----

    def fg3c_ask_price(self, name):
        current = self.price_of(name)
        on_value = lambda value: self.fg3c_save_price(name, value)  # noqa: E731
        modal = getattr(self, "fg3_price_modal", None)
        if modal is not None:
            try:
                modal(current, on_value)
                return
            except Exception:
                self.fg3_log_error("fg3_price_modal failed")
        self.price_dialog(current, on_value)

    def fg3c_confirm(self, title, text, ok_text, on_ok):
        confirm = getattr(self, "fg3_confirm", None)
        if confirm is not None:
            try:
                confirm(title, text, ok_text, on_ok, danger=True)
                return
            except Exception:
                self.fg3_log_error("fg3_confirm failed")
        ctx = self.get_activity()
        if ctx is None:
            return
        builder = AlertDialogBuilder(ctx)
        builder.set_title(title)
        builder.set_message(text)
        builder.set_positive_button(ok_text, lambda bld, _: (bld.dismiss(), on_ok()))
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def fg3c_ask_remove(self, name):
        self.fg3c_confirm("Удалить юзернейм?",
                          "@" + name + " пропадёт из профиля и из списка коллекционных юзернеймов.",
                          "Удалить", lambda *a: self.fg3c_remove(name))

    def fg3c_ask_unset_main(self, name):
        self.fg3c_confirm("Убрать основной?",
                          "@" + name + " перестанет быть основным юзернеймом профиля.",
                          "Убрать", lambda *a: self.fg3c_toggle_main(name))

    # ===== Fragment +888 number page (builder D) =====
    #
    # fragment.com/number/<digits> in the "sold" state, rebuilt for the owner's
    # own number (research_3 §5-§8), or Fragment's empty-table box with a
    # "Set Number" button. Uses only the shared fg3_* core API. Page text is
    # English (Fragment wording); confirmations are Russian (builder E style).

    FG3D_MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun",
                   "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
    FG3D_WHITE = _argb(0xFFFFFFFF)
    FG3D_ACCENT = _argb(0xFF4DB2FF)
    FG3D_TABLE_TEXT = _argb(0xFF8C9AA9)
    FG3D_HINT = ("This collectible number can be used to create a Telegram "
                 "account not tied to a SIM card.")

    def fragment_number_sheet(self):
        try:
            activity = self.get_activity()
            if activity is None:
                return
            root, column = self.fg3_page(activity, tab_index=1)
            number = parse_phone(self.get_setting("anon_number", ""))
            if number:
                self.fg3d_item_page(activity, column, number)
            else:
                self.fg3d_empty_state(activity, column)
            self.fg3_show(activity, root)
        except Exception:
            self.fg3_log_error("Fragment number page failed, using dialogs")
            self.manage_number_dialog()

    # ----- layout pieces -----

    def fg3d_lp(self, width=-1, height=-2, weight=None, left=0, top=0, right=0, bottom=0):
        if weight is None:
            params = LinearLayout.LayoutParams(width, height)
        else:
            params = LinearLayout.LayoutParams(width, height, float(weight))
        params.setMargins(self.fg3_dp(left), self.fg3_dp(top), self.fg3_dp(right), self.fg3_dp(bottom))
        return params

    def fg3d_pad(self, view, left, top, right, bottom):
        view.setPadding(self.fg3_dp(left), self.fg3_dp(top), self.fg3_dp(right), self.fg3_dp(bottom))
        return view

    def fg3d_line(self, ctx, text, size, color, line_height, bold=False):
        """Single-line label with end ellipsis."""
        from android.text import TextUtils
        view = self.fg3_text(ctx, text, size, color, bold=bold, line_height=line_height)
        view.setSingleLine(True)
        view.setEllipsize(TextUtils.TruncateAt.END)
        return view

    def fg3d_cell(self, ctx, weight, first=False, last=False):
        """Table cell: padding 8 8 8 8, 16 on the outer edges (research_3 §6)."""
        cell = LinearLayout(ctx)
        cell.setOrientation(LinearLayout.VERTICAL)
        cell.setGravity(Gravity.TOP | Gravity.START)
        self.fg3d_pad(cell, 16 if first else 8, 8, 16 if last else 8, 8)
        cell.setLayoutParams(self.fg3d_lp(0, -1, weight))
        return cell

    def fg3d_row(self, ctx):
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        return row

    def fg3d_item_page(self, ctx, column, number):
        shown = self.fg3_phone(number)
        price = self.number_price()
        bought = self.fg3d_date()

        column.addView(self.fg3d_title(ctx, shown), self.fg3d_lp())
        column.addView(self.fg3d_price_box(ctx, price, bought), self.fg3d_lp(bottom=16))
        column.addView(self.fg3d_info_box(ctx, shown), self.fg3d_lp(bottom=16))
        column.addView(self.fg3d_buttons(ctx), self.fg3d_lp(height=self.fg3_dp(42), bottom=16))

        remove = self.fg3_button(ctx, "Remove Number", lambda *_: self.fg3d_remove(shown), kind="danger_text")
        column.addView(remove, self.fg3d_lp(height=self.fg3_dp(42)))

        if bought:
            column.addView(self.fg3_section_title(ctx, "Ownership History"), self.fg3d_lp())
            column.addView(self.fg3d_history_box(ctx, price, bought), self.fg3d_lp(bottom=16))
        else:
            column.addView(self.fg3d_spacer(ctx, 16))

    def fg3d_spacer(self, ctx, height):
        from android.view import View
        space = View(ctx)
        space.setLayoutParams(self.fg3d_lp(height=self.fg3_dp(height)))
        return space

    def fg3d_title(self, ctx, shown):
        """h2: number Bold 22/28 centered + red 'Sold' pill; header padding 18 0 17."""
        row = self.fg3d_row(ctx)
        row.setGravity(Gravity.CENTER_HORIZONTAL | Gravity.TOP)
        self.fg3d_pad(row, 6, 18, 6, 17)
        title = self.fg3d_line(ctx, shown, 22, self.FG3D_WHITE, 28, bold=True)
        row.addView(title, self.fg3d_lp(-2, -2))
        pill = self.fg3_pill(ctx, "Sold", "red")
        row.addView(pill, self.fg3d_lp(-2, -2, left=6, top=5, right=6, bottom=1))
        return row

    def fg3d_price_box(self, ctx, price, bought):
        """'Sale Price' | 'Owner' table (35% / 65%) + 'Purchased on …' line."""
        box = self.fg3_box(ctx)
        box.addView(self.fg3_table_header(ctx, [("Sale Price", 35, Gravity.START),
                                                ("Owner", 65, Gravity.START)]))
        row = self.fg3d_row(ctx)
        left = self.fg3d_cell(ctx, 35, first=True)
        left.addView(self.fg3_price_view(ctx, price, size=14, fiat="below"))
        row.addView(left)
        right = self.fg3d_cell(ctx, 65, last=True)
        right.addView(self.fg3d_line(ctx, self.fg3d_owner(), 13, self.FG3D_ACCENT, 16),
                      self.fg3d_lp(-2, -2, top=1))
        row.addView(right)
        box.addView(row, self.fg3d_lp())
        if bought:
            info = self.fg3_text(ctx, "Purchased on " + self.fg3d_long_date(bought), 13,
                                 self.FG3D_TABLE_TEXT, line_height=17)
            self.fg3d_pad(info, 16, 5, 16, 10)
            box.addView(info, self.fg3d_lp())
        return box

    def fg3d_info_box(self, ctx, shown):
        """.tm-list: 'Collectible Number' -> number, then the hint text."""
        box = self.fg3_box(ctx)
        row = self.fg3d_row(ctx)
        row.setGravity(Gravity.CENTER_VERTICAL)
        self.fg3d_pad(row, 16, 8, 16, 8)
        label = self.fg3d_line(ctx, "Collectible Number", 13, self.FG3D_WHITE, 18, bold=True)
        row.addView(label, self.fg3d_lp(-2, -2))
        value = self.fg3d_line(ctx, shown, 14, self.FG3D_ACCENT, 18)
        value.setGravity(Gravity.END)
        value.setOnClickListener(OnClickListener(lambda v: self.fg3d_copy(shown)))
        row.addView(value, self.fg3d_lp(0, -2, 1, left=30))
        box.addView(row, self.fg3d_lp())
        hint = self.fg3_text(ctx, self.FG3D_HINT, 13, self.FG3D_TABLE_TEXT, line_height=17)
        self.fg3d_pad(hint, 16, 0, 16, 10)
        box.addView(hint, self.fg3d_lp())
        return box

    def fg3d_buttons(self, ctx):
        """.tm-section-buttons: two primary buttons, flex 1, gap 12."""
        row = self.fg3d_row(ctx)
        change = self.fg3_button(ctx, "Change Number", lambda *_: self.fg3d_change_number())
        row.addView(change, self.fg3d_lp(0, -1, 1))
        price = self.fg3_button(ctx, "Change Price", lambda *_: self.fg3d_change_price())
        row.addView(price, self.fg3d_lp(0, -1, 1, left=12))
        return row

    def fg3d_history_box(self, ctx, price, bought):
        """Ownership History: 'Sale price | Date | Buyer' at 100 / 110 / rest."""
        box = self.fg3_box(ctx)
        box.addView(self.fg3_table_header(ctx, [("Sale price", 100, Gravity.START),
                                                ("Date", 110, Gravity.START),
                                                ("Buyer", 160, Gravity.START)]))
        row = self.fg3d_row(ctx)
        first = self.fg3d_cell(ctx, 100, first=True)
        first.addView(self.fg3_price_view(ctx, price, size=14, fiat=None))
        row.addView(first)
        middle = self.fg3d_cell(ctx, 110)
        middle.addView(self.fg3d_line(ctx, self.fg3d_short_date(bought), 13, self.FG3D_TABLE_TEXT, 16),
                       self.fg3d_lp(-2, -2, top=1))
        row.addView(middle)
        last = self.fg3d_cell(ctx, 160, last=True)
        last.addView(self.fg3d_line(ctx, self.fg3d_owner(), 13, self.FG3D_ACCENT, 16),
                     self.fg3d_lp(-2, -2, top=1))
        row.addView(last)
        box.addView(row, self.fg3d_lp())
        return box

    def fg3d_empty_state(self, ctx, column):
        """Section header + .tm-table-empty box (370x64, 14/20 #8C9AA9) + 'Set Number'."""
        column.addView(self.fg3_section_title(ctx, "My Numbers"), self.fg3d_lp())
        empty = self.fg3_text(ctx, "No collectible numbers yet.", 14, self.FG3D_TABLE_TEXT, line_height=20)
        empty.setGravity(Gravity.CENTER)
        empty.setBackground(self.fg3_shape(_argb(0xFF212A33), 8))
        self.fg3d_pad(empty, 15, 22, 15, 22)
        column.addView(empty, self.fg3d_lp(bottom=16))
        button = self.fg3_button(ctx, "Set Number", lambda *_: self.fg3d_change_number())
        column.addView(button, self.fg3d_lp(height=self.fg3_dp(42), bottom=16))
        hint = self.fg3_text(ctx, self.FG3D_HINT, 13, _argb(0xFF8794A1), line_height=17)
        hint.setGravity(Gravity.CENTER)
        self.fg3d_pad(hint, 12, 0, 12, 16)
        column.addView(hint, self.fg3d_lp())

    # ----- data -----

    def fg3d_owner(self) -> str:
        """Owner shown the way Fragment shows a wallet that has a name: 'name.t.me'."""
        names = self.username_names()
        primary = (self.get_setting("primary_username", "") or "").lower()
        for name in names:
            if name.lower() == primary:
                return name + ".t.me"
        return names[0] + ".t.me" if names else "You"

    def fg3d_date(self):
        try:
            value = int(float(self.get_setting("number_date", "") or 0))
        except (TypeError, ValueError):
            return None
        return value if value > 0 else None

    def fg3d_long_date(self, ts) -> str:
        """'25 Aug 2026 at 10:17' (the 'Purchased on' line)."""
        t = time.localtime(ts)
        return f"{t.tm_mday} {self.FG3D_MONTHS[t.tm_mon - 1]} {t.tm_year} at {t.tm_hour:02d}:{t.tm_min:02d}"

    def fg3d_short_date(self, ts) -> str:
        """'Aug 25 at 10:17' this year, 'Apr 11, 2025 at 12:25' otherwise."""
        t = time.localtime(ts)
        day = f"{self.FG3D_MONTHS[t.tm_mon - 1]} {t.tm_mday}"
        if t.tm_year != time.localtime().tm_year:
            day += f", {t.tm_year}"
        return f"{day} at {t.tm_hour:02d}:{t.tm_min:02d}"

    # ----- actions (set_number_dialog / set_number_price re-open this page via manage_number) -----

    def fg3d_copy(self, text):
        try:
            copy_to_clipboard(text)
            self.fg3_toast("Copied to clipboard.")
        except Exception:
            self.fg3_log_error("Copy failed")

    def fg3d_change_number(self):
        try:
            modal = getattr(self, "fg3_number_modal", None)
            if modal is not None:
                modal()
                return
        except Exception:
            self.fg3_log_error("Number modal failed, using the dialog")
        self.set_number_dialog()

    def fg3d_change_price(self):
        try:
            modal = getattr(self, "fg3_price_modal", None)
            if modal is not None:
                modal(self.number_price(), self.set_number_price)
                return
        except Exception:
            self.fg3_log_error("Price modal failed, using the dialog")
        self.price_dialog(self.number_price(), self.set_number_price)

    def fg3d_remove(self, shown):
        def do_remove(*_):
            self.remove_number()
            self.set_setting("number_date", "")
            self.fragment_number_sheet()

        title = "Убрать номер?"
        text = f"Номер {shown} пропадёт из твоего профиля."
        try:
            confirm = getattr(self, "fg3_confirm", None)
            if confirm is not None:
                confirm(title, text, "Убрать", do_remove, danger=True)
                return
        except Exception:
            self.fg3_log_error("Confirm modal failed, using the dialog")
        activity = self.get_activity()
        if activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(title)
        builder.set_message(text)
        builder.set_positive_button("Убрать", lambda bld, _: (bld.dismiss(), do_remove()))
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    # ===== Builder E: Fragment-styled modals (Russian text) =====
    #
    # Bottom-sheet popups in fragment.com style (research_5): big centered title, grey
    # subtitle, bold field labels, #242E38 fields with the gem prefix, a live
    # "Примерно $X" line, a full-width primary button, and for confirmations a
    # plain text + right-aligned text buttons. Built only on the fg3_* core API.
    # Validation and storage copy add_username_dialog / set_number_dialog /
    # price_dialog; each entry point falls back to that AlertDialog on any error.

    FG3E_FIELD = _argb(0xFF242E38)
    FG3E_TEXT = _argb(0xFFFFFFFF)
    FG3E_TEXT2 = _argb(0xFF8794A1)
    FG3E_PLACEHOLDER = _argb(0xFF8A98A6)
    FG3E_RED = _argb(0xFFFF5863)

    # ----- small helpers -----

    def fg3e_lp(self, width=-1, height=-2, top=0, bottom=0, left=0, right=0):
        lp = LinearLayout.LayoutParams(width, height)
        lp.setMargins(self.fg3_dp(left), self.fg3_dp(top), self.fg3_dp(right), self.fg3_dp(bottom))
        return lp

    def fg3e_watch(self, edit, on_text):
        """Calls on_text(str) after every edit (android.text.TextWatcher proxy)."""
        cls = getattr(type(self), "_fg3e_watcher_cls", None)
        if cls is None:
            from java import dynamic_proxy
            from android.text import TextWatcher

            class _Watcher(dynamic_proxy(TextWatcher)):
                def __init__(self, fn):
                    super().__init__()
                    self.fn = fn

                def beforeTextChanged(self, s, start, count, after):
                    pass

                def onTextChanged(self, s, start, before, count):
                    pass

                def afterTextChanged(self, s):
                    try:
                        self.fn(str(s))
                    except Exception:
                        pass

            cls = _Watcher
            type(self)._fg3e_watcher_cls = cls
        edit.addTextChangedListener(cls(on_text))

    def fg3e_on_done(self, edit, on_done):
        """Keyboard 'Done' runs on_done (the same action as the primary button)."""
        try:
            from android.view.inputmethod import EditorInfo
            cls = getattr(type(self), "_fg3e_action_cls", None)
            if cls is None:
                from java import dynamic_proxy

                class _Action(dynamic_proxy(TextView.OnEditorActionListener)):
                    def __init__(self, fn):
                        super().__init__()
                        self.fn = fn

                    def onEditorAction(self, view, action_id, event):
                        self.fn()
                        return True

                cls = _Action
                type(self)._fg3e_action_cls = cls
            edit.setImeOptions(EditorInfo.IME_ACTION_DONE)
            edit.setOnEditorActionListener(cls(on_done))
        except Exception:
            self.fg3_log_error("fg3e: IME action not set")

    def fg3e_fiat_line(self, gram) -> str:
        """'Примерно $31,174' from the core '~ $31,174'."""
        fiat = self.fg3_fiat(max(0.0, float(gram)))
        fiat = str(fiat).replace(" ", " ").strip().lstrip("~").strip()
        return "Примерно " + fiat

    def fg3e_plain_amount(self, value) -> str:
        """Editable amount text: '7000', '12.5' (no thousands commas: they would not parse)."""
        value = float(value)
        if value == int(value):
            return str(int(value))
        return ("%.2f" % value).rstrip("0").rstrip(".")

    def fg3e_help(self, ctx, text=""):
        """Grey 14/18 line under a field (.help-block: margin 10 8 0)."""
        view = self.fg3_text(ctx, text, 14, self.FG3E_TEXT2, line_height=18, cyrillic=True)
        view.setLayoutParams(self.fg3e_lp(top=10, left=8, right=8))
        return view

    def fg3e_set_help(self, view, text, error=False):
        view.setText(text)
        view.setTextColor(self.FG3E_RED if error else self.FG3E_TEXT2)

    def fg3e_group(self, ctx, label, hint, value, input_type, gem=False, top=22):
        """.form-group: bold 15/18 label (margin 0 8 10) + field. Returns (group, edit)."""
        group = LinearLayout(ctx)
        group.setOrientation(LinearLayout.VERTICAL)
        group.setLayoutParams(self.fg3e_lp(top=top))
        if label:
            title = self.fg3_text(ctx, label, 15, self.FG3E_TEXT, bold=True, line_height=18)
            title.setLayoutParams(self.fg3e_lp(bottom=10, left=8, right=8))
            group.addView(title)
        box, edit = self.fg3_input_field(ctx, hint, value, input_type, gem=gem)
        group.addView(box)
        return group, edit

    def fg3e_head(self, ctx, column, title, subtitle):
        """Big centered title 30/42 bold + grey 14/20 subtitle (Place a bid / Sell sheets)."""
        head = self.fg3_text(ctx, title, 30, self.FG3E_TEXT, bold=True, line_height=42)
        head.setGravity(Gravity.CENTER_HORIZONTAL)
        head.setLayoutParams(self.fg3e_lp())
        column.addView(head)
        sub = None
        if subtitle is not None:
            sub = self.fg3_text(ctx, subtitle, 14, self.FG3E_TEXT2, line_height=20, cyrillic=True)
            sub.setGravity(Gravity.CENTER_HORIZONTAL)
            sub.setLayoutParams(self.fg3e_lp(top=2, bottom=4))
            column.addView(sub)
        return sub

    def fg3e_column(self, ctx):
        column = LinearLayout(ctx)
        column.setOrientation(LinearLayout.VERTICAL)
        return column

    def fg3e_primary(self, ctx, column, text, on_click):
        """Full-width primary button, 40dp under the form (.form-main-button)."""
        button = self.fg3_button(ctx, text, lambda *a: on_click(), kind="primary")
        button.setLayoutParams(self.fg3e_lp(height=self.fg3_dp(42), top=40))
        column.addView(button)
        return button

    def fg3e_open(self, ctx, column, focus=None):
        """Shows the column in the core Fragment sheet; makes it IME-focusable and
        raises the keyboard for `focus`."""
        sheet = self.fg3_modal(ctx, column)
        if focus is not None:
            try:
                sheet.setFocusable(True)  # BottomSheet(ctx, False) blocks the IME otherwise
            except Exception:
                pass
        try:
            if not sheet.isShowing():
                sheet.show()
        except Exception:
            pass
        if focus is not None:
            def raise_keyboard():
                try:
                    focus.requestFocus()
                    focus.setSelection(focus.length())
                    AndroidUtilities.showKeyboard(focus)
                except Exception:
                    pass
            run_on_ui_thread(raise_keyboard, 250)
        return sheet

    def fg3e_close(self, sheet, edit=None):
        try:
            if edit is not None:
                AndroidUtilities.hideKeyboard(edit)
        except Exception:
            pass
        try:
            if sheet is not None:
                sheet.dismiss()
        except Exception:
            pass

    # ----- public API -----

    def fg3_input_field(self, ctx, hint, value, input_type, gem=False, fiat_for=None):
        """Fragment field: #242E38 r8, 42dp, 15/20 white text, #8A98A6 placeholder,
        no border / focus ring. gem=True puts the 15x19 gem at x=16 (text at x=46).
        fiat_for: optional TextView that is kept at 'Примерно $X' for the typed amount.
        Returns (container, EditText)."""
        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.HORIZONTAL)
        box.setGravity(Gravity.CENTER_VERTICAL)
        box.setBackground(self.fg3_shape(self.FG3E_FIELD, 8))
        box.setLayoutParams(self.fg3e_lp(height=self.fg3_dp(42)))
        if gem:
            icon = self.fg3_icon(ctx, "gem", 15, 19)
            lp = LinearLayout.LayoutParams(self.fg3_dp(15), self.fg3_dp(19))
            lp.setMargins(self.fg3_dp(16), 0, 0, 0)
            icon.setLayoutParams(lp)
            box.addView(icon)

        edit = EditText(ctx)
        edit.setBackground(None)
        edit.setSingleLine(True)
        edit.setInputType(input_type)
        edit.setTextColor(self.FG3E_TEXT)
        edit.setHintTextColor(self.FG3E_PLACEHOLDER)
        edit.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15.0)
        edit.setIncludeFontPadding(False)
        try:
            edit.setTypeface(self.fg3_font(False))
        except Exception:
            pass
        edit.setHint(hint or "")
        edit.setPadding(self.fg3_dp(15 if gem else 16), 0, self.fg3_dp(22), 0)
        edit.setGravity(Gravity.CENTER_VERTICAL)
        edit.setLayoutParams(LinearLayout.LayoutParams(0, -1, 1.0))
        try:  # thin white caret like the site (API 29+)
            caret = self.fg3_shape(self.FG3E_TEXT, 1)
            caret.setSize(self.fg3_dp(2), self.fg3_dp(20))
            edit.setTextCursorDrawable(caret)
        except Exception:
            pass
        if value is not None and str(value) != "":
            edit.setText(str(value))
        box.addView(edit)

        if fiat_for is not None:
            def update(text):
                fiat_for.setTextColor(self.FG3E_TEXT2)
                fiat_for.setText(self.fg3e_fiat_line(parse_amount(text, 0.0)) if text.strip() else "")
            update(str(edit.getText()))
            self.fg3e_watch(edit, update)
        return box, edit

    def fg3_price_modal(self, current, on_value, title=None, subtitle=None):
        """'Place a bid'-style sheet: title, subtitle, 'Цена' gem field, live fiat, 'Сохранить'.
        on_value(float) gets the new price (same parsing as price_dialog)."""
        sheet_ref = [None]
        try:
            ctx = self.get_activity()
            if ctx is None:
                return
            column = self.fg3e_column(ctx)
            self.fg3e_head(ctx, column, title or "Цена покупки",
                           subtitle if subtitle is not None else "Сколько GRAM вы заплатили на Fragment")
            form = self.fg3e_column(ctx)
            form.setPadding(0, self.fg3_dp(6), 0, 0)
            group, edit = self.fg3e_group(
                ctx, "Цена", "Введите сумму в GRAM", self.fg3e_plain_amount(current),
                InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_FLAG_DECIMAL, gem=True)
            help_line = self.fg3e_help(ctx)
            group.addView(help_line)
            form.addView(group)
            column.addView(form)

            def fiat(text):
                self.fg3e_set_help(help_line, self.fg3e_fiat_line(parse_amount(text, 0.0)) if text.strip() else "")
            fiat(str(edit.getText()))
            self.fg3e_watch(edit, fiat)

            def save():
                try:
                    value = float(str(edit.getText()).replace(",", ".").replace(" ", ""))
                except ValueError:
                    self.fg3e_set_help(help_line, "Нужно число", error=True)
                    return
                self.fg3e_close(sheet_ref[0], edit)
                on_value(value)

            self.fg3e_on_done(edit, save)
            self.fg3e_primary(ctx, column, "Сохранить", save)
            sheet_ref[0] = self.fg3e_open(ctx, column, focus=edit)
        except Exception:
            self.fg3_log_error("fg3_price_modal failed, using the dialog")
            self.fg3e_close(sheet_ref[0])
            self.price_dialog(current, on_value)

    def fg3_add_username_modal(self):
        """'Новый юзернейм': username + purchase price; saves like add_username_dialog
        (plus d['date']) and reopens the usernames screen."""
        sheet_ref = [None]
        try:
            ctx = self.get_activity()
            if ctx is None:
                return
            column = self.fg3e_column(ctx)
            default_sub = "Коллекционный юзернейм с Fragment"
            sub = self.fg3e_head(ctx, column, "Новый юзернейм", default_sub)
            form = self.fg3e_column(ctx)
            form.setPadding(0, self.fg3_dp(6), 0, 0)

            name_group, name_field = self.fg3e_group(
                ctx, "Юзернейм", "durov",
                "", InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS)
            rule = "4–32 латинских буквы, цифры или _"
            name_help = self.fg3e_help(ctx, rule)
            name_group.addView(name_help)
            form.addView(name_group)

            price_group, price_field = self.fg3e_group(
                ctx, "Цена покупки", self.fg3e_plain_amount(DEFAULT_PRICE), "",
                InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_FLAG_DECIMAL, gem=True)
            price_help = self.fg3e_help(ctx)
            price_group.addView(price_help)
            form.addView(price_group)
            column.addView(form)

            def on_name(text):
                names = parse_usernames(text)
                if sub is not None:
                    sub.setText(f"Юзернейм Telegram и {names[0]}.t.me" if names else default_sub)
                self.fg3e_set_help(name_help, rule)

            def on_price(text):
                gram = parse_amount(text, DEFAULT_PRICE) if text.strip() else DEFAULT_PRICE
                self.fg3e_set_help(price_help, self.fg3e_fiat_line(gram))

            on_price("")
            self.fg3e_watch(name_field, on_name)
            self.fg3e_watch(price_field, on_price)

            def save():
                names = parse_usernames(str(name_field.getText()))
                if not names:
                    self.fg3e_set_help(name_help, "Юзернейм: 4-32 латинских буквы, цифры или _", error=True)
                    name_field.requestFocus()
                    return
                name = names[0]
                raw = str(price_field.getText())
                try:
                    price = float(raw.replace(",", ".")) if raw.strip() else DEFAULT_PRICE
                except ValueError:
                    price = DEFAULT_PRICE
                items = [d for d in self.get_usernames() if d["name"].lower() != name.lower()]
                items.append({"name": name, "price": price, "date": int(time.time())})
                self.fg3e_close(sheet_ref[0], price_field)
                self.save_usernames(items)
                self.manage_usernames()

            self.fg3e_on_done(price_field, save)
            self.fg3e_primary(ctx, column, "Добавить", save)
            sheet_ref[0] = self.fg3e_open(ctx, column, focus=name_field)
        except Exception:
            self.fg3_log_error("fg3_add_username_modal failed, using the dialog")
            self.fg3e_close(sheet_ref[0])
            self.add_username_dialog()

    def fg3_number_modal(self):
        """'Анонимный номер': +888 field with a live formatted preview; saves like
        set_number_dialog (plus number_date) and reopens the number screen."""
        sheet_ref = [None]
        try:
            ctx = self.get_activity()
            if ctx is None:
                return
            current = parse_phone(self.get_setting("anon_number", ""))
            column = self.fg3e_column(ctx)
            self.fg3e_head(ctx, column, "Анонимный номер", "Номер +888 с Fragment")
            form = self.fg3e_column(ctx)
            form.setPadding(0, self.fg3_dp(6), 0, 0)
            group, edit = self.fg3e_group(ctx, "Номер", "+888 0123 4567", "+" + (current or "888"),
                                          InputType.TYPE_CLASS_PHONE)
            help_line = self.fg3e_help(ctx)
            group.addView(help_line)
            form.addView(group)
            column.addView(form)

            def preview(text):
                phone = parse_phone(text)
                if phone:
                    try:
                        shown = self.fg3_phone(phone)
                    except Exception:
                        shown = format_phone(phone)
                    self.fg3e_set_help(help_line, "Будет показан как " + shown)
                else:
                    self.fg3e_set_help(help_line, "Номер должен начинаться с +888")
            preview(str(edit.getText()))
            self.fg3e_watch(edit, preview)

            def save():
                phone = parse_phone(str(edit.getText()))
                if not phone:
                    self.fg3e_set_help(help_line, "Это не номер +888", error=True)
                    return
                self.fg3e_close(sheet_ref[0], edit)
                self.set_setting("anon_number", phone)
                self.set_setting("number_date", int(time.time()))
                self.refresh_own_users()
                BulletinHelper.show_success("Номер задан. Переоткрой профиль")
                self.manage_number()

            self.fg3e_on_done(edit, save)
            self.fg3e_primary(ctx, column, "Сохранить", save)
            sheet_ref[0] = self.fg3e_open(ctx, column, focus=edit)
        except Exception:
            self.fg3_log_error("fg3_number_modal failed, using the dialog")
            self.fg3e_close(sheet_ref[0])
            self.set_number_dialog()

    def fg3_confirm(self, title, text, ok_text, on_ok, danger=False):
        """showConfirm()-style sheet: optional 18/22 bold title, white 14/19 text,
        text buttons 'Отмена' + ok_text at the bottom-right (ok in red when danger)."""
        sheet_ref = [None]
        try:
            ctx = self.get_activity()
            if ctx is None:
                return
            column = self.fg3e_column(ctx)
            if title:
                head = self.fg3_text(ctx, title, 18, self.FG3E_TEXT, bold=True, line_height=22)
                head.setLayoutParams(self.fg3e_lp(bottom=15))
                column.addView(head)
            if text:
                body = self.fg3_text(ctx, text, 14, self.FG3E_TEXT, line_height=19)
                if "<b>" in text:  # '<b>@name</b>' like showConfirm's bold accents
                    try:
                        from android.text import Html
                        body.setText(Html.fromHtml(text, 0))
                    except Exception:
                        body.setText(re.sub(r"</?b>", "", text))
                body.setLayoutParams(self.fg3e_lp())
                column.addView(body)

            def cancel():
                self.fg3e_close(sheet_ref[0])

            def confirm():
                self.fg3e_close(sheet_ref[0])
                on_ok()

            # .popup-buttons: right-aligned, 33dp buttons, gap 12; the row sits 21dp under
            # the text and its bottom edge 22dp above the sheet bottom (-8 into the padding).
            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.END | Gravity.CENTER_VERTICAL)
            row.setLayoutParams(self.fg3e_lp(top=21, bottom=-8, right=-12))
            cancel_btn = self.fg3_button(ctx, "Отмена", lambda *a: cancel(), kind="text", height=33)
            cancel_btn.setLayoutParams(LinearLayout.LayoutParams(-2, self.fg3_dp(33)))
            row.addView(cancel_btn)
            ok_btn = self.fg3_button(ctx, ok_text or "OK", lambda *a: confirm(),
                                     kind="danger_text" if danger else "text", height=33)
            ok_lp = LinearLayout.LayoutParams(-2, self.fg3_dp(33))
            ok_lp.setMargins(self.fg3_dp(12), 0, 0, 0)
            ok_btn.setLayoutParams(ok_lp)
            row.addView(ok_btn)
            column.addView(row)
            sheet_ref[0] = self.fg3e_open(ctx, column)
        except Exception:
            self.fg3_log_error("fg3_confirm failed, using the dialog")
            self.fg3e_close(sheet_ref[0])
            ctx = self.get_activity()
            if ctx is None:
                return
            builder = AlertDialogBuilder(ctx)
            if title:
                builder.set_title(title)
            if text:
                builder.set_message(text)
            builder.set_positive_button(ok_text or "OK", lambda bld, _: (bld.dismiss(), on_ok()))
            builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
            builder.show()

    def remove_number(self):
        self.set_setting("anon_number", "")
        self.refresh_own_users()
        BulletinHelper.show_success("Номер убран. Переоткрой профиль")

    def active_sheet_dismiss(self):
        sheet = getattr(self, "active_sheet", None)
        if sheet is not None:
            try:
                sheet.dismiss()
            except Exception:
                pass
            self.active_sheet = None

    # ----- plain dialog fallback for the two screens -----

    def manage_usernames_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        items = self.get_usernames()
        primary = (self.get_setting("primary_username", "") or "").lower()
        rows = []
        for d in items:
            star = " ⭐ основной" if d["name"].lower() == primary else ""
            rows.append(f"@{d['name']}  ·  {self.price_label(float(d.get('price') or DEFAULT_PRICE))}{star}")
        rows.append("➕ Добавить юзернейм")

        builder = AlertDialogBuilder(activity)
        builder.set_title("Мои юзернеймы")

        def on_click(bld, which):
            bld.dismiss()
            if which == len(items):
                self.add_username_dialog()
            else:
                self.username_actions(items[which]["name"])

        builder.set_items(rows, on_click)
        builder.set_negative_button("Закрыть", lambda bld, _: bld.dismiss())
        builder.show()

    def username_actions(self, name: str):
        activity = self.get_activity()
        if activity is None:
            return
        is_primary = (self.get_setting("primary_username", "") or "").lower() == name.lower()
        actions = ["Изменить цену", "Убрать основной" if is_primary else "Сделать основным", "Удалить"]

        builder = AlertDialogBuilder(activity)
        builder.set_title(f"@{name}")

        def on_click(bld, which):
            bld.dismiss()
            if which == 0:
                self.price_dialog(self.price_of(name), lambda value: self.set_username_price(name, value))
            elif which == 1:
                self.set_setting("primary_username", "" if is_primary else name)
                self.refresh_own_users()
                self.manage_usernames()
            else:
                self.save_usernames([d for d in self.get_usernames() if d["name"].lower() != name.lower()])
                if is_primary:
                    self.set_setting("primary_username", "")
                self.manage_usernames()

        builder.set_items(actions, on_click)
        builder.set_negative_button("Назад", lambda bld, _: (bld.dismiss(), self.manage_usernames()))
        builder.show()

    def set_username_price(self, name: str, price: float):
        items = self.get_usernames()
        for d in items:
            if d["name"].lower() == name.lower():
                d["price"] = price
        self.save_usernames(items)
        self.manage_usernames()

    def add_username_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        layout = LinearLayout(activity)
        layout.setOrientation(LinearLayout.VERTICAL)
        pad = AndroidUtilities.dp(22)
        layout.setPadding(pad, 0, pad, 0)
        name_field = EditText(activity)
        name_field.setHint("Юзернейм, например durov")
        name_field.setInputType(InputType.TYPE_CLASS_TEXT)
        price_field = EditText(activity)
        price_field.setHint("Цена в GRAM, например 7000")
        price_field.setInputType(InputType.TYPE_CLASS_NUMBER)
        layout.addView(name_field)
        layout.addView(price_field)

        builder = AlertDialogBuilder(activity)
        builder.set_title("Новый юзернейм")
        builder.set_view(layout)

        def on_ok(bld, _):
            names = parse_usernames(str(name_field.getText()))
            bld.dismiss()
            if not names:
                BulletinHelper.show_error("Юзернейм: 4-32 латинских буквы, цифры или _")
                self.manage_usernames()
                return
            name = names[0]
            try:
                price = float(str(price_field.getText()).replace(",", ".")) if str(price_field.getText()).strip() else DEFAULT_PRICE
            except ValueError:
                price = DEFAULT_PRICE
            items = [d for d in self.get_usernames() if d["name"].lower() != name.lower()]
            items.append({"name": name, "price": price})
            self.save_usernames(items)
            self.manage_usernames()

        builder.set_positive_button("Добавить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: (bld.dismiss(), self.manage_usernames()))
        builder.show()

    def price_dialog(self, current: float, on_value):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER)
        field.setHint("Цена в GRAM")
        field.setText(str(int(current)))

        builder = AlertDialogBuilder(activity)
        builder.set_title("Цена покупки (GRAM)")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            try:
                on_value(float(str(field.getText()).replace(",", ".")))
            except ValueError:
                BulletinHelper.show_error("Нужно число")

        builder.set_positive_button("Сохранить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def manage_number_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        number = parse_phone(self.get_setting("anon_number", ""))
        if number:
            rows = [f"Номер: {format_phone(number)}", f"Цена: {self.price_label(self.number_price())}",
                    "Изменить номер", "Изменить цену", "Убрать номер"]
            offset = 2
        else:
            rows = ["Задать номер +888"]
            offset = 0

        builder = AlertDialogBuilder(activity)
        builder.set_title("Анонимный номер +888")

        def on_click(bld, which):
            bld.dismiss()
            if not number:
                self.set_number_dialog()
                return
            if which == offset:       # change number
                self.set_number_dialog()
            elif which == offset + 1:  # change price
                self.price_dialog(self.number_price(), self.set_number_price)
            elif which == offset + 2:  # remove
                self.set_setting("anon_number", "")
                self.refresh_own_users()
                BulletinHelper.show_success("Номер убран. Переоткрой профиль")

        builder.set_items(rows, on_click)
        builder.set_negative_button("Закрыть", lambda bld, _: bld.dismiss())
        builder.show()

    def set_number_price(self, price: float):
        self.set_setting("number_price", str(price))
        self.manage_number()

    def set_number_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_PHONE)
        field.setHint("+888 0123 4567")
        field.setText("+" + parse_phone(self.get_setting("anon_number", "")))

        builder = AlertDialogBuilder(activity)
        builder.set_title("Анонимный номер +888")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            phone = parse_phone(str(field.getText()))
            if not phone:
                BulletinHelper.show_error("Это не номер +888")
                return
            self.set_setting("anon_number", phone)
            self.refresh_own_users()
            BulletinHelper.show_success("Номер задан. Переоткрой профиль")
            self.manage_number()

        builder.set_positive_button("Сохранить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    # Fragment: purchase info for the local usernames and +888 number.

    def ton_rate(self, fiat: str) -> float:
        """GRAM (TON) price in fiat. Refreshes in the background, never blocks."""
        try:
            cached = json.loads(self.get_setting("ton_rates", "") or "{}")
        except ValueError:
            cached = {}
        if time.time() - cached.get("time", 0) > RATES_TTL and not self.rates_loading:
            self.rates_loading = True
            threading.Thread(target=self.load_rates, daemon=True).start()
        return float(cached.get(fiat) or FALLBACK_RATES[fiat])

    def load_rates(self):
        try:
            data = json.loads(http_get(RATES_URL))["the-open-network"]
            rates = {fiat: float(data[fiat.lower()]) for fiat in FIAT}
            rates["time"] = time.time()
            self.set_setting("ton_rates", json.dumps(rates))
        except Exception:
            self.logger.exception("Could not load GRAM rates, using the last known ones")
        finally:
            self.rates_loading = False

    def collectible_info(self, request):
        collectible = request.collectible
        if isinstance(collectible, TL_fragment.TL_inputCollectibleUsername):
            name = next((n for n in self.username_names()
                         if n.lower() == (collectible.username or "").lower()), None)
            if name is None:
                return None
            key, url, price = name.lower(), f"https://fragment.com/username/{name}", self.price_of(name)
        elif isinstance(collectible, TL_fragment.TL_inputCollectiblePhone):
            phone = parse_phone(self.get_setting("anon_number", ""))
            if not phone or re.sub(r"\D", "", collectible.phone or "") != phone:
                return None
            key, url, price = "number", f"https://fragment.com/number/{phone}", self.number_price()
        else:
            return None

        fiat = FIAT[self.get_setting("fiat_currency", 0)]
        date_key = f"bought_at_{key}"
        bought_at = self.get_setting(date_key, 0)
        if not bought_at:
            bought_at = int(time.time())
            self.set_setting(date_key, bought_at)

        info = TL_fragment.TL_collectibleInfo()
        info.purchase_date = int(bought_at)
        info.crypto_currency = "TON"
        info.crypto_amount = int(price * NANO)
        info.currency = fiat
        info.amount = int(round(price * self.ton_rate(fiat) * 100))  # cents / kopecks
        info.url = url
        return info, None

    def open_saved_messages(self, account: int, text: str):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            args = Bundle()
            args.putLong("user_id", get_user_config(account).getClientUserId())
            chat = ChatActivity(args)
            fragment.presentFragment(chat)
            run_on_ui_thread(lambda: BulletinHelper.show_success(text, chat), 400)
        except Exception:
            self.logger.exception("Could not open Saved Messages")
            BulletinHelper.show_success(text)

    # Cards in Saved Messages for local purchases. They are only in this app's database.

    def post_saved_card(self, purchase, gift, unique: bool):
        """purchase is (account, price, ton): price in stars, or nanoTON when ton."""
        account, price, ton = purchase
        try:
            user_id = get_user_config(account).getClientUserId()
            me = TLRPC.TL_peerUser()
            me.user_id = user_id

            if unique:
                action = TLRPC.TL_messageActionStarGiftUnique()
                action.saved = True
                action.flags |= 4
                # With a resale amount the app writes "You bought this gift for ...".
                if ton:
                    action.resale_amount = TL_stars.TL_starsTonAmount()
                    action.resale_amount.amount = int(price)
                else:
                    action.resale_amount = TL_stars.StarsAmount.ofStars(int(price))
                action.flags |= 256
            else:
                action = TLRPC.TL_messageActionStarGift()
                action.saved = True
                action.flags |= 4
            action.gift = gift

            message = TLRPC.TL_messageService()
            message.id = get_user_config(account).getNewMessageId()
            message.from_id = me
            message.peer_id = me
            message.dialog_id = user_id
            message.date = int(time.time())
            message.out = True
            message.flags |= 2 | 256
            message.action = action

            messages = ArrayList()
            messages.add(message)
            try:
                MessagesStorage.getInstance(account).putMessages(messages, False, True, False, 0, 0, 0)
            except Exception:
                self.logger.exception("Could not save the purchase card, it will vanish after restart")
            objects = ArrayList()
            objects.add(MessageObject(account, message, True, True))
            run_on_ui_thread(lambda: get_messages_controller(account).updateInterfaceWithMessages(user_id, objects, 0))
        except Exception:
            self.logger.exception("Could not post the purchase card to Saved Messages")

    # Picker: collection -> NFT on resale, by number or a random one.

    def get_activity(self):
        fragment = get_last_fragment()
        return fragment.getParentActivity() if fragment else None

    def show_loading(self):
        activity = self.get_activity()
        if activity is None:
            return None
        dialog = AlertDialogBuilder(activity, AlertDialogBuilder.ALERT_TYPE_SPINNER)
        dialog.show()
        return dialog

    def show_items(self, title: str, items: List[str], on_pick):
        activity = self.get_activity()
        if activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(title)

        def on_click(bld, which):
            bld.dismiss()
            on_pick(which)

        builder.set_items(items, on_click)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    # ----- NFT constructor: Telegram's own market and preview sheet, driven by hooks -----

    def open_nft_market(self):
        activity = self.get_activity()
        if activity is None:
            return
        try:
            from org.telegram.ui.Gifts import GiftSheet
            account = UserConfig.selectedAccount
            uid = get_user_config(account).getClientUserId()
            self.restore_resale()
            self.resale_account = account
            self.market_opening = True  # fillItems runs inside the constructor already
            write_log("opening market")
            try:
                sheet = GiftSheet(activity, account, uid, None)
            finally:
                self.market_opening = False
            sheet.setOnDismissListener(R(self.on_market_closed))
            self.market_sheet = sheet
            try:
                self.add_market_hold(sheet)
            except Exception:
                write_log(f"hold failed:\n{traceback.format_exc()}")
            sheet.show()
            write_log("market shown")
        except Exception:
            self.logger.exception("Could not open the gift market")
            BulletinHelper.show_error("Не удалось открыть маркет")

    HOLD_SECONDS = 5.0

    def add_market_hold(self, sheet):
        """Holding a gift in the constructor market for 5+ seconds adds it, non-upgraded,
        to the profile and closes the market. Telegram's long press fires after ~0.5 s,
        so the rest of the wait is timed here and a release before that cancels it."""
        listview = java_field(sheet, "recyclerListView")
        adapter = java_field(sheet, "adapter")
        hold = {"token": 0}

        def on_start(view, position):
            item = adapter.getItem(position - 1) if adapter is not None else None
            gift = getattr(item, "object", None) if item is not None else None
            if gift is None or not str(gift.getClass().getName()).endswith("$TL_starGift"):
                return False
            hold["token"] += 1
            token = hold["token"]

            def fire():
                if hold["token"] != token or not self.market_active():
                    return
                hold["token"] += 1
                try:
                    view.performHapticFeedback(0)  # HapticFeedbackConstants.LONG_PRESS
                except Exception:
                    pass
                self.add_regular_from_market(gift)

            run_on_ui_thread(fire, int((self.HOLD_SECONDS - 0.5) * 1000))
            return True

        def on_release():
            hold["token"] += 1

        self.market_hold_listener = long_press_listener(on_start, on_release)  # keep the proxy alive
        listview.setOnItemLongClickListener(self.market_hold_listener)
        write_log("market hold installed")

    def add_regular_from_market(self, gift):
        write_log(f"hold: add regular {gift.id} {gift.title}")
        self.catalog[gift.id] = gift
        ids = self.regular_gift_ids()
        ids.insert(0, gift.id)
        self.set_setting("regular_gifts", ",".join(str(i) for i in ids))
        sheet = getattr(self, "market_sheet", None)
        if sheet is not None:
            sheet.dismiss()
        BulletinHelper.show_success(f"«{gift.title}» добавлен в профиль. Переоткрой профиль")

    def is_market_sheet(self, sheet) -> bool:
        if getattr(self, "market_opening", False):
            return True
        current = getattr(self, "market_sheet", None)
        try:
            return current is not None and current.equals(sheet)
        except Exception:
            return False

    def hide_resale_now(self):
        """Zero resale counts in the lists GiftSheet reads, remembering originals."""
        if not hasattr(self, "resale_backup"):
            self.resale_backup = []
        controller = StarsController.getInstance(getattr(self, "resale_account", UserConfig.selectedAccount))
        hidden = 0
        for name in ("gifts", "sortedGifts", "birthdaySortedGifts"):
            gifts = getattr(controller, name, None)
            if gifts is None:
                continue
            for i in range(gifts.size()):
                gift = gifts.get(i)
                value = int(getattr(gift, "availability_resale", 0) or 0)
                if value > 0:
                    self.resale_backup.append((gift, value))
                    gift.availability_resale = 0
                    hidden += 1
        if hidden:
            write_log(f"hid resale on {hidden} gifts")

    def restore_resale(self):
        for gift, value in getattr(self, "resale_backup", []) or []:
            try:
                gift.availability_resale = value
            except Exception:
                pass
        self.resale_backup = []

    def on_market_closed(self):
        write_log("market closed")
        self.restore_resale()

    def market_active(self) -> bool:
        sheet = getattr(self, "market_sheet", None)
        try:
            return sheet is not None and sheet.isShowing()
        except Exception:
            return False

    def catalog_title(self, gift_id):
        gift = self.catalog.get(gift_id)
        return gift.title if gift is not None else "NFT"

    def open_constructor_for(self, gift_id, title):
        write_log(f"open constructor for {gift_id} {title}")
        req = TL_stars.getStarGiftUpgradePreview()
        req.gift_id = gift_id

        def on_result(response):
            attrs = getattr(response, "sample_attributes", None)
            if attrs is None or attrs.size() == 0:
                BulletinHelper.show_error("Нет образцов для этой коллекции")
                return
            self.show_native_constructor(gift_id, title or "NFT", attrs)

        self.request_on_ui(req, on_result)

    def show_native_constructor(self, gift_id, title, attrs):
        try:
            self._show_native_constructor(gift_id, title, attrs)
        except Exception:
            write_log(f"constructor failed:\n{traceback.format_exc()}")
            BulletinHelper.show_error("Конструктор не открылся. Лог: настройки → Лог winft")

    def _show_native_constructor(self, gift_id, title, attrs):
        from org.telegram.ui.Stars import StarGiftPreviewSheet
        activity = self.get_activity()
        if activity is None:
            return
        write_log(f"constructor: {title} id={gift_id} samples={attrs.size()}")
        sheet = StarGiftPreviewSheet(activity, None, UserConfig.selectedAccount, title, attrs, False)
        write_log("constructor: sheet created")
        base = self.catalog.get(gift_id)
        total = int(getattr(base, "availability_total", 0) or 0) or 100000
        self.ctor = {"sheet": sheet, "gift_id": gift_id, "title": title, "total": total,
                     "num": random.randint(1, total), "value": None, "built": False}
        try:
            self.add_constructor_buttons(sheet)
            write_log("constructor: buttons added")
        except Exception:
            write_log(f"buttons failed:\n{traceback.format_exc()}")
        try:
            self.add_build_check(sheet)
            write_log("constructor: check added")
        except Exception:
            write_log(f"check failed:\n{traceback.format_exc()}")
        self.update_ctor_header()
        write_log("constructor: showing")
        sheet.show()
        write_log("constructor: shown")

    def add_constructor_buttons(self, sheet):
        """Two round buttons beside the native glass tab bar. The glass comes from the sheet's
        own fallback source: its live-blur source only tracks the tab bar and crashes others."""
        from android.widget import FrameLayout
        from org.telegram.ui.ActionBar import Theme
        from org.telegram.ui.Components.blur3 import BlurredBackgroundDrawableViewFactory
        from org.telegram.ui.Components.blur3.drawable.color import BlurredBackgroundColorProviderThemed
        container = get_private_field(sheet, "containerView")
        tabs = get_private_field(sheet, "tabsSelectorView")
        fallback = get_private_field(sheet, "glassSourceFallback")
        factory = BlurredBackgroundDrawableViewFactory(fallback) if fallback is not None else None
        activity = self.get_activity()
        side = (AndroidUtilities.displaySize.x - self.dp(268)) // 2
        size = max(self.dp(36), min(self.dp(56), side - self.dp(14)))
        views = []
        for text, action in (("#", self.ask_ctor_number), ("?", self.ask_ctor_value)):
            view = TextView(activity)
            view.setText(text)
            view.setGravity(Gravity.CENTER)
            view.setTypeface(Typeface.DEFAULT_BOLD)
            view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22.0)
            view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            if factory is not None:
                drawable = factory.create(view)
                drawable.setPadding(self.dp(4))
                drawable.setRadius(size // 2 - self.dp(4))
                drawable.setColorProvider(BlurredBackgroundColorProviderThemed(None, Theme.key_windowBackgroundWhite))
                view.setBackground(drawable)
            container.addView(view, FrameLayout.LayoutParams(size, size, Gravity.TOP | Gravity.LEFT))
            view.setOnClickListener(OnClickListener(lambda v, a=action: a()))
            views.append(view)

        def place():
            gap = self.dp(10)
            y = tabs.getY() + (tabs.getHeight() - size) / 2.0
            left, right = views
            left.setX(float(max(self.dp(4), tabs.getX() - gap - size)))
            right.setX(float(min(container.getWidth() - size - self.dp(4), tabs.getX() + tabs.getWidth() + gap)))
            left.setY(float(y))
            right.setY(float(y))

        self.ctor_layout_listener = layout_listener(place)  # keep the proxy alive
        tabs.addOnLayoutChangeListener(self.ctor_layout_listener)

    def add_build_check(self, sheet):
        """Turns the native play/pause circle into a white check that builds the NFT. The
        sheet resets that image on every mode change, so the play icon is faded out and the
        check is drawn as the view's foreground; the native tinted circle stays as it is."""
        from android.graphics import PorterDuff, PorterDuffColorFilter
        play = get_private_field(sheet, "headerPlay")
        activity = self.get_activity()
        res = activity.getResources()
        icon = None
        for name in ("ic_ab_done", "checkbig", "msg_check"):
            rid = res.getIdentifier(name, "drawable", activity.getPackageName())
            if rid:
                icon = activity.getDrawable(rid).mutate()
                break
        if icon is None:
            return
        icon.setColorFilter(PorterDuffColorFilter(_argb(0xFFFFFFFF), PorterDuff.Mode.SRC_IN))
        play.setImageAlpha(0)
        play.setForeground(icon)
        play.setForegroundGravity(Gravity.CENTER)
        play.setOnClickListener(OnClickListener(lambda v: self.build_and_close()))

    def build_and_close(self):
        c = self.ctor
        if c is None or c["built"]:
            return
        try:
            model, back, pat = self.ctor_selection(c["sheet"])
        except Exception:
            write_log(f"selection failed:\n{traceback.format_exc()}")
            BulletinHelper.show_error("Не удалось прочитать выбор")
            return
        if model is None or back is None:
            BulletinHelper.show_error("Выбери модель и фон")
            return
        self.build_from_ctor(model, back, pat)
        if c["built"]:
            c["sheet"].dismiss()

    def ctor_value_label(self):
        value = self.ctor.get("value") if self.ctor else None
        if not value:
            return None
        amount, code = value
        symbol = next((sym for c, sym, _ in CURRENCIES if c == code), code)
        return f"Ценность ~{amount:g} {symbol}"

    def update_ctor_header(self):
        c = self.ctor
        if c is None:
            return
        try:
            get_private_field(c["sheet"], "giftNameTextView").setText(f"{c['title']} #{c['num']}")
            label = self.ctor_value_label()
            if label:
                get_private_field(c["sheet"], "giftStatusTextView").setText(label)
        except Exception:
            self.logger.exception("Could not update the constructor header")

    def ask_ctor_number(self):
        c = self.ctor
        activity = self.get_activity()
        if c is None or activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER)
        field.setText(str(c["num"]))
        builder = AlertDialogBuilder(activity)
        builder.set_title("Номер подарка")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            text = str(field.getText()).strip()
            if text.isdigit() and int(text) > 0:
                c["num"] = int(text)
                self.update_ctor_header()

        builder.set_positive_button("Готово", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def ask_ctor_value(self):
        activity = self.get_activity()
        if self.ctor is None or activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title("Ценность в")

        def on_pick(bld, which):
            bld.dismiss()
            self.ask_ctor_amount(CURRENCIES[which][0])

        builder.set_items([f"{sym}  {name}" for _, sym, name in CURRENCIES], on_pick)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def ask_ctor_amount(self, code):
        c = self.ctor
        activity = self.get_activity()
        if c is None or activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_FLAG_DECIMAL)
        field.setHint("Например 32")
        builder = AlertDialogBuilder(activity)
        builder.set_title("Ценность")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            amount = parse_amount(str(field.getText()), 0)
            c["value"] = (amount, code) if amount > 0 else None
            self.update_ctor_header()

        builder.set_positive_button("Готово", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def ctor_selection(self, sheet):
        mode = get_private_field(sheet, "mode")
        if mode is not None and mode.name() == "SELECTED":
            selected = get_private_field(sheet, "selectedAttributes")
            if selected is not None:
                return selected.model, selected.backdrop, selected.pattern
        top = get_private_field(sheet, "topView")
        return (top.getUpgradeImageViewAttribute(), top.getUpgradeBackdropAttribute(),
                top.getUpgradePatternAttribute())

    def to_usd(self, amount, code):
        if code == "USD":
            return amount
        return amount * self.ton_rate("USD") / max(self.ton_rate(code), 1e-9)

    def build_from_ctor(self, model, back, pat):
        c = self.ctor
        if c is None:
            return
        gift = self.assemble_unique(c["gift_id"], c["title"], model, back, pat)
        gift.num = c["num"]
        gift.availability_issued = max(gift.num, min(c["total"], gift.num + 1000))
        gift.availability_total = max(c["total"], gift.availability_issued)
        if c["value"]:
            amount, code = c["value"]
            gift.value_amount = int(round(amount * 100))
            gift.value_currency = code
            gift.value_usd_amount = int(round(self.to_usd(amount, code) * 100))
            gift.flags |= FLAG_VALUE
        if not self.store_custom(gift):
            BulletinHelper.show_error("Не удалось собрать NFT")
            return
        c["built"] = True
        BulletinHelper.show_success(f"NFT «{gift.title} #{gift.num}» собран. Переоткрой профиль")

    def request_on_ui(self, req, on_result):
        """Sends a request with a loading spinner and calls on_result(response) on the UI thread."""
        loading = self.show_loading()
        state = {"done": False}

        def close_loading():
            if loading:
                try:
                    loading.dismiss()
                except Exception:
                    pass

        def on_response(response, error):
            def finish():
                if state["done"]:
                    return
                state["done"] = True
                close_loading()
                if error or response is None:
                    BulletinHelper.show_error(f"Ошибка: {error.text if error else 'пустой ответ'}")
                    return
                try:
                    on_result(response)
                except Exception as e:
                    self.logger.exception("Picker failed")
                    BulletinHelper.show_error(f"Ошибка плагина: {type(e).__name__}: {e}")
            run_on_ui_thread(finish)

        def on_timeout():
            if not state["done"]:
                state["done"] = True
                close_loading()
                BulletinHelper.show_error("Сервер не ответил. Попробуй ещё раз")

        try:
            send_request(req, on_response)
        except Exception as e:
            self.logger.exception("Could not send the picker request")
            state["done"] = True
            close_loading()
            BulletinHelper.show_error(f"Ошибка плагина: {type(e).__name__}: {e}")
            return
        run_on_ui_thread(on_timeout, 15000)

    def pick_collection(self):
        req = TL_stars.getStarGifts()
        req.hash = 0

        def on_result(response):
            gifts = jlist(getattr(response, "gifts", None))
            self.logger.info(f"Gift catalog: {response.getClass().getSimpleName()}, {len(gifts)} gifts")
            resale = lambda gift: int(getattr(gift, "availability_resale", 0) or 0)
            collections = [
                gift for gift in gifts
                if resale(gift) > 0 or int(getattr(gift, "upgrade_stars", 0) or 0) > 0
            ]
            collections.sort(key=lambda gift: -resale(gift))
            if not collections:
                BulletinHelper.show_error(f"Коллекции не найдены (в каталоге {len(gifts)} подарков)")
                return
            items = [f"{gift.title or 'Без названия'} ({resale(gift)} в продаже)" for gift in collections]
            self.show_items("Коллекция", items, lambda i: self.pick_from_collection(collections[i]))

        self.request_on_ui(req, on_result)

    def pick_from_collection(self, collection):
        req = TL_stars.getResaleStarGifts()
        req.gift_id = collection.id
        req.sort_by_price = True
        req.offset = ""
        req.limit = 50

        def on_result(response):
            uniques = [gift for gift in jlist(response.gifts) if gift.slug]
            base = uniques[0].slug.rsplit("-", 1)[0] if uniques else slug_base(collection.title)
            items = ["🔢 Ввести номер"]
            if uniques:
                items.append("🎲 Случайный")
            items += [describe_unique(gift) for gift in uniques]

            def on_pick(i):
                if i == 0:
                    self.ask_number(collection.title, base)
                elif i == 1:
                    self.add_slug(random.choice(uniques).slug)
                else:
                    self.add_slug(uniques[i - 2].slug)

            self.show_items(collection.title, items, on_pick)

        self.request_on_ui(req, on_result)

    def ask_number(self, title: str, base: str):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER)
        field.setHint("Например 1")
        builder = AlertDialogBuilder(activity)
        builder.set_title(f"{title}: номер")
        builder.set_view(field)

        def on_ok(bld, _):
            number = str(field.getText()).strip()
            bld.dismiss()
            if number.isdigit():
                self.add_slug(f"{base}-{int(number)}")

        builder.set_positive_button("Добавить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def assemble_unique(self, gift_id, title, model, back, pat):
        gift = TL_stars.TL_starGiftUnique()
        gift.id = random.getrandbits(62)
        gift.gift_id = gift_id
        gift.title = title or "Custom"
        gift.num = random.randint(1, 99999)
        store = self.get_custom_store()
        gift.slug = f"winft-custom-{len(store)}-{gift.num}"
        gift.availability_issued = gift.num
        gift.availability_total = 100000
        attrs = ArrayList()
        attrs.add(model)
        if pat is not None:
            attrs.add(pat)
        attrs.add(back)
        gift.attributes = attrs
        return gift

    def store_custom(self, gift) -> bool:
        store = self.get_custom_store()
        try:
            store.append(gift_to_hex(gift))
        except Exception:
            self.logger.exception("Could not serialize the built NFT")
            return False
        self.set_setting("custom_gifts", json.dumps(store))
        self.custom[gift.slug] = gift
        return True

    # ----- Gift collections: local gifts are kept in collections on this device -----

    def get_collections(self) -> dict:
        """collection id (str) -> local keys in order: slugs, "r:<gift id>" for non-upgraded."""
        try:
            return json.loads(self.get_setting("local_collections", "") or "{}")
        except ValueError:
            return {}

    def save_collections(self, data: dict):
        self.set_setting("local_collections", json.dumps({k: v for k, v in data.items() if v}))

    def rename_collection_key(self, old, new):
        data = self.get_collections()
        for keys in data.values():
            if old in keys:
                keys[keys.index(old)] = new
        self.save_collections(data)

    def saved_key(self, saved):
        if saved.saved_id in self.local_saved_ids:
            return self.local_saved_ids[saved.saved_id]
        return getattr(saved.gift, "slug", None)

    def apply_collections(self, saved, key):
        ids = [int(cid) for cid, keys in self.get_collections().items() if key in keys]
        if ids:
            saved.collection_id = ArrayList()
            for cid in ids:
                saved.collection_id.add(Integer(cid))
            saved.flags |= FLAG_COLLECTIONS

    def split_local(self, lst):
        """Takes local gifts out of a Java list of InputSavedStarGift, returns their keys."""
        keys = []
        for i in reversed(range(lst.size())):
            key = self.local_key(lst.get(i))
            if key is not None:
                keys.insert(0, key)
                lst.remove(jint(i))
        return keys

    def collection_request(self, account, request):
        """The server rejects local gifts, so they are taken out of collection requests and
        kept here; the real gifts in the same request still go to the server."""
        if not self.is_own_peer(account, request.peer):
            return None
        if isinstance(request, TL_stars.deleteStarGiftCollection):
            data = self.get_collections()
            data.pop(str(request.collection_id), None)
            self.save_collections(data)
            return None
        if isinstance(request, TL_stars.createStarGiftCollection):
            self.pending_create.append(self.split_local(request.stargift))
            return None
        data = self.get_collections()
        members = data.setdefault(str(request.collection_id), [])
        if request.flags & 2:
            for key in self.split_local(request.delete_stargift):
                if key in members:
                    members.remove(key)
            if request.delete_stargift.size() == 0:
                request.flags &= ~2
        if request.flags & 4:
            for key in self.split_local(request.add_stargift):
                if key not in members:
                    members.insert(0, key)
            if request.add_stargift.size() == 0:
                request.flags &= ~4
        if request.flags & 8:
            order = self.split_local(request.order)
            members.sort(key=lambda k: order.index(k) if k in order else len(order))
            if request.order.size() == 0:
                request.flags &= ~8
        self.save_collections(data)
        return None

    def patch_collections(self, response) -> bool:
        """Adds local gifts to the counts (and icon) of collections the server returns."""
        if isinstance(response, TL_stars.TL_starGiftCollections):
            items = jlist(response.collections)
        elif isinstance(response, TL_stars.TL_starGiftCollection):
            items = [response]
            if self.pending_create and response.collection_id not in [int(c) for c in self.get_collections()]:
                keys = self.pending_create.popleft()
                if keys:
                    data = self.get_collections()
                    data[str(response.collection_id)] = keys
                    self.save_collections(data)
        else:
            return False
        data = self.get_collections()
        changed = False
        for collection in items:
            members = [k for k in data.get(str(collection.collection_id), []) if self.key_gift(k) is not None]
            if not members:
                continue
            collection.gifts_count += len(members)
            if collection.icon is None:
                document = self.key_gift(members[0]).getDocument()
                if document is not None:
                    collection.icon = document
                    collection.flags |= 1
            changed = True
        return changed

    def key_gift(self, key):
        if key.startswith("r:"):
            gift_id = int(key[2:])
            return self.catalog.get(gift_id) if gift_id in self.regular_gift_ids() else None
        return self.gift_lookup(key)

    def trace_request(self, request, result):
        """Logs the gift requests the plugin looks at, to find what fails on a device."""
        try:
            invoice = getattr(request, "invoice", None)
            target = getattr(invoice, "stargift", None) if invoice is not None else getattr(request, "stargift", None)
            ident = ""
            if target is not None and not hasattr(target, "size"):
                ident = f" msg={getattr(target, 'msg_id', '')} saved={getattr(target, 'saved_id', '')}"
            kind = invoice.getClass().getSimpleName() if invoice is not None else ""
            where = "server" if result is None else "local"
            write_log(f"req {request.getClass().getSimpleName()} {kind}{ident} -> {where}")
        except Exception:
            pass

    # ----- Local upgrade of a non-upgraded gift -----

    def regular_gift_id_from_input(self, stargift):
        key = self.local_key(stargift)
        return int(key[2:]) if key and key.startswith("r:") else None

    def prefetch_preview(self, gift_id):
        """Loads upgrade samples while the upgrade screen is open, so pressing the button
        can answer at once with the new gift and Telegram plays its own upgrade animation."""
        if gift_id in self.previews:
            return
        req = TL_stars.getStarGiftUpgradePreview()
        req.gift_id = gift_id

        def on_response(response, error):
            attrs = jlist(getattr(response, "sample_attributes", None))
            models = [a for a in attrs if isinstance(a, TL_stars.starGiftAttributeModel)]
            backs = [a for a in attrs if isinstance(a, TL_stars.starGiftAttributeBackdrop)]
            pats = [a for a in attrs if isinstance(a, TL_stars.starGiftAttributePattern)]
            if models and backs:
                self.previews[gift_id] = (models, backs, pats)

        send_request(req, on_response)

    def upgrade_now(self, gift_id):
        """Builds and stores the upgraded gift from cached samples, or None if not loaded yet."""
        samples = self.previews.get(gift_id)
        if samples is None:
            return None
        models, backs, pats = samples
        collection = self.catalog.get(gift_id)
        gift = self.assemble_unique(gift_id, collection.title if collection is not None else "Gift",
                                    random.choice(models), random.choice(backs),
                                    random.choice(pats) if pats else None)
        if not self.store_custom(gift):
            return None
        self.finish_regular_upgrade(gift_id, gift)
        return gift

    def finish_regular_upgrade(self, gift_id, gift):
        ids = self.regular_gift_ids()
        if gift_id in ids:
            ids.remove(gift_id)  # one copy: the same gift can be owned twice
        self.set_setting("regular_gifts", ",".join(str(i) for i in ids))
        self.rename_collection_key(f"r:{gift_id}", gift.slug)

    def upgrade_updates(self, account, gift):
        """Updates the gift screen reads after an upgrade: a service message with the new
        unique gift. It drives the native upgrade animation and is kept out of the chats."""
        me = TLRPC.TL_peerUser()
        me.user_id = get_user_config(account).getClientUserId()
        action = TLRPC.TL_messageActionStarGiftUnique()
        action.upgrade = True
        action.saved = True
        action.gift = gift
        message = TLRPC.TL_messageService()
        message.id = LOCAL_MSG_ID_BASE + 400000 + len(self.custom)
        message.from_id = me
        message.peer_id = me
        message.dialog_id = me.user_id
        message.date = int(time.time())
        message.out = True
        message.action = action
        self.local_msg_ids[message.id] = gift.slug
        update = TL_update.TL_updateNewMessage()
        update.message = message
        updates = TLRPC.TL_updatesCombined()
        updates.updates.add(update)
        updates.date = message.date
        self.fake_updates.append(updates)
        return updates

    def local_upgrade_result(self, account, gift_id):
        """Updates for a local upgrade: with the new gift when samples are ready, else empty
        (the screen closes and the gift is built in the background as before)."""
        gift = self.upgrade_now(gift_id)
        if gift is not None:
            write_log(f"upgrade: instant {gift.slug}")
            return self.upgrade_updates(account, gift)
        write_log("upgrade: samples not ready, building in background")
        self.do_local_upgrade(gift_id)
        updates = TLRPC.TL_updates()
        updates.date = int(time.time())
        return updates

    def do_local_upgrade(self, gift_id):
        collection = self.catalog.get(gift_id)
        title = collection.title if collection is not None else "Gift"
        req = TL_stars.getStarGiftUpgradePreview()
        req.gift_id = gift_id

        def on_response(response, error):
            attrs = jlist(getattr(response, "sample_attributes", None))
            models = [a for a in attrs if isinstance(a, TL_stars.starGiftAttributeModel)]
            backs = [a for a in attrs if isinstance(a, TL_stars.starGiftAttributeBackdrop)]
            pats = [a for a in attrs if isinstance(a, TL_stars.starGiftAttributePattern)]
            if not models or not backs:
                run_on_ui_thread(lambda: BulletinHelper.show_error("Нет образцов для улучшения"))
                return
            gift = self.assemble_unique(gift_id, title, random.choice(models),
                                        random.choice(backs), random.choice(pats) if pats else None)
            if self.store_custom(gift):
                self.finish_regular_upgrade(gift_id, gift)
                run_on_ui_thread(lambda: BulletinHelper.show_success(
                    f"Подарок улучшен в «{gift.title} #{gift.num}». Переоткрой профиль"))

        send_request(req, on_response)

    def upgrade_gift_locally(self, account, request):
        gift_id = self.regular_gift_id_from_input(request.stargift)
        if gift_id is None:
            return None
        return self.local_upgrade_result(account, gift_id), None

    def remove_custom_gift(self, slug: str):
        store = self.get_custom_store()
        keep = [hx for hx in store if gift_from_hex_slug(hx) != slug]
        self.set_setting("custom_gifts", json.dumps(keep))
        self.custom.pop(slug, None)

    def add_slug(self, slug: str):
        slugs = parse_slugs(self.get_setting("slug", ""))
        if slug not in slugs:
            slugs.append(slug)
        self.save_slugs(slugs)

    def pick_to_remove(self):
        link_slugs = parse_slugs(self.get_setting("slug", ""))
        custom_slugs = list(self.custom.keys())
        if not link_slugs and not custom_slugs:
            BulletinHelper.show_info("Список NFT пуст")
            return
        labels = list(link_slugs)
        for slug in custom_slugs:
            gift = self.custom.get(slug)
            labels.append(f"🔨 {gift.title} #{gift.num}" if gift else slug)

        def on_pick(i):
            if i < len(link_slugs):
                self.save_slugs(link_slugs[:i] + link_slugs[i + 1:])
                BulletinHelper.show_success(f"«{link_slugs[i]}» убран. Переоткрой профиль")
            else:
                slug = custom_slugs[i - len(link_slugs)]
                self.remove_custom_gift(slug)
                BulletinHelper.show_success("Собранный NFT убран. Переоткрой профиль")

        self.show_items("Убрать NFT", labels, on_pick)

    def save_slugs(self, slugs: List[str]):
        text = ", ".join(slugs)
        self.set_setting("slug", text, reload_settings=True)
        self.load_gifts(text)

    def load_gifts(self, text: str):
        # Responses to an older list of links are dropped by comparing generations.
        self.generation += 1
        generation = self.generation
        self.slugs = parse_slugs(text)
        self.gifts = {}
        for slug in self.slugs:
            self.load_gift(slug, generation)

    def load_gift(self, slug: str, generation: int):
        req = TL_stars.getUniqueStarGift()
        req.slug = slug

        def on_response(response, error):
            if generation != self.generation:
                return
            if error or response is None or response.gift is None:
                text = error.text if error else "пустой ответ"
                BulletinHelper.show_error(f"NFT «{slug}» не найден: {text}")
                return
            gift = response.gift
            self.apply_listing(gift)
            if self.gift_meta(slug).get("drop_details"):
                self.strip_original_details(gift)
            self.gifts[slug] = gift
            run_on_ui_thread(self.refresh_own_users)  # a worn status may wait for this gift
            if slug in self.announce:
                self.post_saved_card(self.announce.pop(slug), gift, unique=True)
            BulletinHelper.show_success(
                f"NFT «{gift.title} #{gift.num}» загружен ({len(self.gifts)}/{len(self.slugs)})"
            )

        send_request(req, on_response)

    def all_slugs(self) -> List[str]:
        return self.slugs + list(self.custom.keys())

    def gift_lookup(self, slug: str):
        return self.gifts.get(slug) or self.custom.get(slug)

    def loaded_gifts(self) -> List[Any]:
        """Link-based gifts (in entry order) plus locally built ones."""
        if not self.get_setting("enabled", True):
            return []
        return [self.gift_lookup(slug) for slug in self.all_slugs() if self.gift_lookup(slug)]

    def get_custom_store(self) -> list:
        try:
            return json.loads(self.get_setting("custom_gifts", "") or "[]")
        except ValueError:
            return []

    def load_custom_gifts(self):
        self.custom = {}
        for hx in self.get_custom_store():
            try:
                gift = gift_from_hex(hx)
                if gift is not None and gift.slug:
                    self.custom[gift.slug] = gift
            except Exception:
                self.logger.exception("Could not restore a built NFT")

    def is_own_peer(self, account: int, peer) -> bool:
        if isinstance(peer, TLRPC.TL_inputPeerSelf):
            return True
        if isinstance(peer, TLRPC.TL_inputPeerUser):
            return peer.user_id == get_user_config(account).getClientUserId()
        return False

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        if isinstance(request, TL_account.updateEmojiStatus):
            return self.on_update_emoji_status(account, request)
        if "toggleStarGiftsPinnedToTop" in request_name:
            return self.on_toggle_pinned(account, request)
        if "getSavedStarGifts" in request_name:
            own_first_page = self.is_own_peer(account, request.peer) and not request.offset
            self.pending[account].append(request if own_first_page else None)
        elif "StarGiftCollection" in request_name:
            self.collection_pending[account].append(self.is_own_peer(account, getattr(request, "peer", None)))
        elif "getStarsStatus" in request_name or "getStarsTransactions" in request_name:
            self.tx_pending[account].append({
                "ton": bool(getattr(request, "ton", False)),
                "inbound": bool(getattr(request, "inbound", False)),
                "outbound": bool(getattr(request, "outbound", False)),
                "self": self.is_own_peer(account, getattr(request, "peer", None)),
                "first": not getattr(request, "offset", ""),
            })
        return HookResult()

    def on_update_emoji_status(self, account: int, request) -> HookResult:
        # The app has already put the new status on our user object before sending
        # the request, so keep it locally and do not send anything to the server.
        is_local_gift = (
            isinstance(request.emoji_status, TLRPC.TL_inputEmojiStatusCollectible)
            and request.emoji_status.collectible_id in self.local_gift_ids()
        )
        if not self.get_setting("local_premium", True) and not is_local_gift:
            return HookResult()
        user = get_user_config(account).getCurrentUser()
        if user is None:
            return HookResult()
        self.save_status(user.id, user.emoji_status)
        return HookResult(strategy=HookStrategy.CANCEL)

    def post_request_hook(self, request_name: str, account: int, response: Any, error: Any) -> HookResult:
        if isinstance(response, TLRPC.TL_payments_paymentFormStarGift):
            self.form_prices[response.form_id] = sum(p.amount for p in jlist(response.invoice.prices))
            return HookResult()
        if "getSavedStarGifts" in request_name:
            queue = self.pending[account]
            request = queue.popleft() if queue else None
            if request is None or error or response is None:
                return HookResult()
            saved = []
            if not request.exclude_unique:
                saved += [self.make_saved_gift(account, gift) for gift in self.loaded_gifts()]
            if not request.exclude_unlimited:
                saved += [
                    self.make_saved_regular_gift(account, gift, i)
                    for i, gift in enumerate(self.loaded_regular_gifts())
                ]
            if request.flags & 64:  # a collection: only the local gifts put into it
                members = self.get_collections().get(str(request.collection_id), [])
                saved = [g for g in saved if self.saved_key(g) in members]
                saved.sort(key=lambda g: members.index(self.saved_key(g)))
            if saved:
                for i, gift in enumerate(saved):
                    response.gifts.add(i, gift)
                response.count += len(saved)
                return HookResult(strategy=HookStrategy.MODIFY, response=response)
        elif "StarGiftCollection" in request_name:
            queue = self.collection_pending[account]
            own = queue.popleft() if queue else False
            if own and not error and response is not None:
                if self.patch_collections(response):
                    return HookResult(strategy=HookStrategy.MODIFY, response=response)
        elif "getStarsStatus" in request_name or "getStarsTransactions" in request_name:
            meta = self.tx_pending[account].popleft() if self.tx_pending[account] else None
            # Inject only into the paged transaction list, never the balance status,
            # so a purchase never shows up under "Зачисления".
            if meta and meta["self"] and meta["first"] and "getStarsTransactions" in request_name \
                    and not error and response is not None and self.get_setting("local_balance", True):
                txs = self.transactions_for(meta["ton"], meta["inbound"], meta["outbound"], account)
                if txs:
                    for t in reversed(txs):
                        response.history.add(0, t)
                    response.flags |= 8
                    return HookResult(strategy=HookStrategy.MODIFY, response=response)
        elif request_name == "TL_users_getFullUser":
            added = len(self.loaded_gifts()) + len(self.loaded_regular_gifts())
            if not error and response is not None and added:
                full = response.full_user
                if full is not None and full.id == get_user_config(account).getClientUserId():
                    full.stargifts_count += added
                    full.flags2 |= FLAG_STARGIFTS_COUNT
                    return HookResult(strategy=HookStrategy.MODIFY, response=response)
        return HookResult()

    def get_own_ids(self):
        if not self.own_ids:
            for account in range(UserConfig.MAX_ACCOUNT_COUNT):
                user_id = get_user_config(account).getClientUserId()
                if user_id:
                    self.own_ids.add(user_id)
        return self.own_ids

    def get_status(self, user_id: int):
        if user_id not in self.statuses:
            text = self.get_setting(f"status_{user_id}", "")
            try:
                status = status_from_hex(text) if text else None
            except Exception:
                self.logger.exception("Could not restore the worn status")
                status = None
            rebuilt = self.rebuild_collectible(status)
            if rebuilt is not None:
                status = rebuilt
                self.save_status(user_id, status)
            elif isinstance(status, TLRPC.TL_emojiStatusCollectible) and not status.slug:
                return status  # an older save: rebuilt once the worn NFT has loaded
            self.statuses[user_id] = status
        return self.statuses[user_id]

    def rebuild_collectible(self, status):
        """A worn local NFT's status, rebuilt from the gift. Older saves lost the colors and
        the background pattern: the app leaves slug empty and it was written out of place."""
        if not isinstance(status, TLRPC.TL_emojiStatusCollectible):
            return None
        gift = next((g for g in self.loaded_gifts() if g.id == status.collectible_id), None)
        if gift is None:
            return None
        rebuilt = MessagesController.emojiStatusCollectibleFromGift(gift)
        rebuilt.slug = gift.slug or ""
        if status.flags & 1:
            rebuilt.flags |= 1
            rebuilt.until = status.until
        return rebuilt

    def save_status(self, user_id: int, status):
        empty = status is None or isinstance(status, TLRPC.TL_emojiStatusEmpty)
        if isinstance(status, TLRPC.TL_emojiStatusCollectible):
            # The app leaves these empty; an empty string still serializes, null does not.
            if status.slug is None:
                gift = next((g for g in self.loaded_gifts() if g.id == status.collectible_id), None)
                status.slug = gift.slug if gift is not None and gift.slug else ""
            if status.title is None:
                status.title = ""
        self.statuses[user_id] = None if empty else status
        self.set_setting(f"status_{user_id}", "" if empty else status_to_hex(status))

    def patch_user(self, user):
        if user is None or user.id not in self.get_own_ids():
            return
        if self.get_setting("local_premium", True):
            user.premium = True
        status = self.get_status(user.id)
        if status is not None:
            user.emoji_status = status
        self.patch_usernames(user)
        self.patch_phone(user)

    def patch_usernames(self, user):
        names = self.username_names()
        if user.usernames is None:
            user.usernames = ArrayList()
        # Drop what we added last time, so removed names go away without a restart.
        for i in reversed(range(user.usernames.size())):
            entry = user.usernames.get(i)
            if not entry.editable and entry.username in self.added_usernames:
                user.usernames.remove(jint(i))  # by index, not by value
        self.added_usernames = set(names)
        if names and user.usernames.size() == 0 and user.username:
            own = TLRPC.TL_username()
            own.editable = True
            own.active = True
            own.username = user.username
            user.usernames.add(own)
        present = {user.usernames.get(i).username.lower() for i in range(user.usernames.size())}
        for name in names:
            if name.lower() in present:
                continue
            entry = TLRPC.TL_username()
            entry.active = True
            entry.username = name
            user.usernames.add(entry)
        if names:
            user.flags2 |= FLAG_USERNAMES

        # Choose which username shows under the name (user.username). The rest fall under "also".
        primary = parse_usernames(self.get_setting("primary_username", ""))
        if primary:
            choice = primary[0]
            if self.real_username.get(user.id) is None:
                self.real_username[user.id] = user.username or ""
            user.username = choice
            # The chosen one should not also repeat in the "also" list.
            for i in reversed(range(user.usernames.size())):
                if user.usernames.get(i).username.lower() == choice.lower():
                    user.usernames.remove(jint(i))
        elif user.id in self.real_username:
            user.username = self.real_username[user.id]

    def patch_phone(self, user):
        fake = parse_phone(self.get_setting("anon_number", ""))
        key = f"real_phone_{user.id}"
        if user.phone and not user.phone.startswith("888") and self.real_phones.get(user.id) != user.phone:
            self.real_phones[user.id] = user.phone
            self.set_setting(key, user.phone)
        real = self.real_phones.get(user.id) or self.get_setting(key, "")
        if fake:
            user.phone = fake
        elif user.phone and user.phone.startswith("888") and real:
            user.phone = real

    def refresh_own_users(self):
        self.own_ids = set()
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            config = get_user_config(account)
            if not config.isClientActivated():
                continue
            user = config.getCurrentUser()
            if user is not None:
                self.patch_user(user)
            cached = get_messages_controller(account).getUser(config.getClientUserId())
            if cached is not None and cached is not user:
                self.patch_user(cached)

    def clear_statuses(self):
        for user_id in list(self.get_own_ids()):
            self.save_status(user_id, None)
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            user = get_user_config(account).getCurrentUser()
            if user is not None:
                user.emoji_status = TLRPC.TL_emojiStatusEmpty()
        BulletinHelper.show_success("Статус снят. Переоткрой профиль")

    def local_gift_ids(self):
        return {gift.id for gift in self.gifts.values()} | {gift.id for gift in self.custom.values()}

    def make_saved_gift(self, account: int, gift):
        user_config = get_user_config(account)
        me = TLRPC.TL_peerUser()
        me.user_id = user_config.getClientUserId()

        gift.owner_id = me
        gift.flags = (gift.flags | FLAG_OWNER_ID) & ~(FLAG_OWNER_NAME | FLAG_OWNER_ADDRESS)
        gift.owner_name = None
        gift.owner_address = None

        saved = TL_stars.TL_savedStarGift()
        saved.gift = gift
        saved.date = int(time.time())
        saved.pinned_to_top = self.get_pinned_map().get(gift.slug, self.get_setting("pinned", True))
        # A unique saved_id: without it the app cannot tell our gifts apart and drops
        # their pinned state when the profile is reopened.
        all_slugs = self.all_slugs()
        index = all_slugs.index(gift.slug) if gift.slug in all_slugs else 0
        saved.saved_id = LOCAL_SAVED_ID_BASE + index
        saved.flags |= FLAG_SAVED_ID
        # The gift screen sends this id back when listing the gift for sale.
        saved.msg_id = LOCAL_MSG_ID_BASE + index if gift.slug in self.slugs else 0
        if saved.msg_id:
            saved.flags |= FLAG_MSG_ID
            self.local_msg_ids[saved.msg_id] = gift.slug
        self.local_saved_ids[saved.saved_id] = gift.slug
        self.apply_collections(saved, gift.slug)
        self.apply_meta(saved, gift.slug)
        return saved

    def make_saved_regular_gift(self, account: int, gift, index: int):
        me = TLRPC.TL_peerUser()
        me.user_id = get_user_config(account).getClientUserId()
        saved = TL_stars.TL_savedStarGift()
        saved.gift = gift
        saved.from_id = me
        saved.date = int(time.time())
        saved.saved_id = LOCAL_SAVED_ID_BASE + 100000 + index  # distinct from NFT ids
        saved.flags |= FLAG_SAVED_ID
        # Show the "Улучшить" button and let the upgrade be answered locally.
        saved.can_upgrade = True
        saved.flags |= FLAG_CAN_UPGRADE
        saved.msg_id = REGULAR_MSG_BASE + index
        saved.flags |= FLAG_MSG_ID
        self.local_regular_msg[saved.msg_id] = gift.id
        self.local_saved_ids[saved.saved_id] = f"r:{gift.id}"
        self.apply_collections(saved, f"r:{gift.id}")
        return saved
