    # Local balance and local purchases on the gift marketplace.

    def balance_amount(self, ton: bool):
        # Balance views compare the object they got last time, and a new object on every
        # read replays the star effect each frame. Hand out the same object until it changes.
        if ton:
            value = int(parse_amount(self.get_setting("ton_balance", "1000"), 0) * NANO)
        else:
            value = int(parse_amount(self.get_setting("stars_balance", "100000"), 0))
        cached = self.balance_cache.get(ton)
        if cached is None or cached.amount != value:
            cached = TL_stars.TL_starsTonAmount() if ton else TL_stars.StarsAmount.ofStars(0)
            cached.amount = value
            self.balance_cache[ton] = cached
        return cached

    def notify_balance(self):
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            if get_user_config(account).isClientActivated():
                try:
                    NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.starBalanceUpdated)
                except Exception:
                    self.logger.exception("Could not refresh the balance on screen")

    def regular_gift_ids(self) -> List[int]:
        text = self.get_setting("regular_gifts", "")
        return [int(x) for x in text.split(",") if x.strip().isdigit()]

    def load_catalog(self):
        if not self.regular_gift_ids():
            return
        req = TL_stars.getStarGifts()
        req.hash = 0

        def on_response(response, error):
            for gift in jlist(getattr(response, "gifts", None)):
                self.catalog[gift.id] = gift
            for gift_id in [k for k in self.announce if isinstance(k, int) and k in self.catalog]:
                self.post_saved_card(self.announce.pop(gift_id), self.catalog[gift_id], unique=False)

        send_request(req, on_response)

    def loaded_regular_gifts(self) -> List[Any]:
        if not self.get_setting("enabled", True):
            return []
        return [self.catalog[gift_id] for gift_id in self.regular_gift_ids() if gift_id in self.catalog]

    def clear_regular_gifts(self):
        self.set_setting("regular_gifts", "")
        BulletinHelper.show_success("Обычные подарки убраны. Переоткрой профиль")

    def spend(self, ton: bool, price: int) -> bool:
        """Takes price (stars, or nanoTON for TON) from the local balance. False if it is too low."""
        if not self.get_setting("spend_balance", True):
            return True
        key, default, scale = ("ton_balance", "1000", NANO) if ton else ("stars_balance", "100000", 1)
        balance = parse_amount(self.get_setting(key, default), 0) * scale
        if balance < price:
            BulletinHelper.show_error("Не хватает локального баланса. Пополни его в настройках плагина")
            return False
        left = balance - price
        self.set_setting(key, f"{left / NANO:.2f}" if ton else str(int(left)))
        self.notify_balance()
        return True

    def pay_locally(self, account: int, request):
        """Returns (response, error) for a purchase made locally, or None to send it for real."""
        invoice = request.invoice
        # Removing a caption works for local gifts even when the local balance is off.
        if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftDropOriginalDetails):
            return self.drop_caption_locally(invoice)
        if not self.get_setting("local_balance", True):
            return None
        if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftResale):
            buyer, ton = invoice.to_id, invoice.ton
        elif isinstance(invoice, TLRPC.TL_inputInvoiceStarGift):
            buyer, ton = invoice.peer, False
        else:
            return None
        if not self.is_own_peer(account, buyer):
            return None  # gifts for other people are never faked

        # A second purchase of the same thing right away is a loop in the app, not the user.
        key = invoice.slug if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftResale) else invoice.gift_id
        now = time.time()
        if self.last_purchase and self.last_purchase[0] == key and now - self.last_purchase[1] < 3:
            self.logger.warning(f"Repeated purchase of {key} blocked")
            error = TLRPC.TL_error()
            error.code = 400
            error.text = "LOCAL_REPEATED_PURCHASE"
            return None, error
        self.last_purchase = (key, now)

        price = self.form_prices.get(request.form_id, 0)
        if not self.spend(ton, price):
            error = TLRPC.TL_error()
            error.code = 400
            error.text = "LOCAL_BALANCE_TOO_LOW"
            return None, error

        if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftResale):
            self.forget_listing(invoice.slug)
            self.announce[invoice.slug] = (account, price, ton)
            self.capture_caption(invoice.slug, getattr(invoice, "message", None), not getattr(invoice, "show_name", True))
            self.record_purchase(price, ton, slug=invoice.slug)
            self.add_slug(invoice.slug)
            run_on_ui_thread(lambda: self.open_saved_messages(account, f"NFT «{invoice.slug}» куплен"), 1000)
        else:
            ids = self.regular_gift_ids()
            ids.insert(0, invoice.gift_id)
            self.set_setting("regular_gifts", ",".join(str(i) for i in ids))
            self.record_purchase(price, ton, gift_id=invoice.gift_id)
            if invoice.gift_id in self.catalog:
                self.post_saved_card((account, price, ton), self.catalog[invoice.gift_id], unique=False)
            else:
                self.announce[invoice.gift_id] = (account, price, ton)
                self.load_catalog()
            run_on_ui_thread(lambda: self.open_saved_messages(account, "Подарок куплен"), 1000)

        updates = TLRPC.TL_updates()
        updates.date = int(time.time())
        response = TLRPC.TL_payments_paymentResult()
        response.updates = updates
        return response, None

    # Local transaction history, shown on the Stars and GRAM balance screens.

    def get_transactions(self) -> list:
        try:
            return json.loads(self.get_setting("transactions_json", "") or "[]")
        except ValueError:
            return []

    def record_purchase(self, price, ton: bool, slug=None, gift_id=None):
        txs = self.get_transactions()
        txs.insert(0, {
            "id": f"local{int(time.time() * 1000)}",
            "price": int(price),
            "ton": bool(ton),
            "date": int(time.time()),
            "slug": slug,
            "gift_id": gift_id,
        })
        self.set_setting("transactions_json", json.dumps(txs[:100]))

    def build_transaction(self, rec, account):
        t = TL_stars.TL_starsTransaction()
        t.id = rec["id"]
        t.date = int(rec["date"])
        if rec.get("ton"):
            amount = TL_stars.TL_starsTonAmount()
            amount.amount = -int(rec["price"])
        else:
            amount = TL_stars.StarsAmount.ofStars(-int(rec["price"]))
        t.amount = amount
        # Pay as yourself, like a real gift purchase, not "Вывод через Fragment".
        me = TLRPC.TL_peerUser()
        me.user_id = get_user_config(account).getClientUserId()
        peer = TL_stars.TL_starsTransactionPeer()
        peer.peer = me
        t.peer = peer
        gift = None
        if rec.get("slug"):
            gift = self.gifts.get(rec["slug"])
        elif rec.get("gift_id"):
            gift = self.catalog.get(rec["gift_id"])
        if gift is not None:
            t.stargift = gift
            t.stargift_resale = True  # renders as "Покупка подарка" with the gift sticker
        else:
            t.title = "Покупка подарка"
        return t

    def transactions_for(self, ton: bool, inbound: bool, outbound: bool, account: int) -> list:
        if inbound:
            return []  # our local transactions are all outgoing (purchases)
        recs = [r for r in self.get_transactions() if bool(r.get("ton")) == ton]
        return [self.build_transaction(r, account) for r in recs]

    # Per-gift extras (caption, hidden-from-profile): local, server never sees them.

    def get_meta(self) -> dict:
        try:
            return json.loads(self.get_setting("gift_meta", "") or "{}")
        except ValueError:
            return {}

    def gift_meta(self, slug: str) -> dict:
        return self.get_meta().get(slug, {})

    def update_meta(self, slug: str, **changes):
        meta = self.get_meta()
        entry = meta.get(slug, {})
        entry.update(changes)
        meta[slug] = entry
        self.set_setting("gift_meta", json.dumps(meta))

    def capture_caption(self, slug: str, message, name_hidden: bool):
        text = getattr(message, "text", None) if message is not None else None
        if text:
            self.update_meta(slug, text=text, name_hidden=bool(name_hidden))

    def apply_meta(self, saved, slug: str):
        meta = self.gift_meta(slug)
        if meta.get("text"):
            tw = TLRPC.TL_textWithEntities()
            tw.text = meta["text"]
            tw.entities = ArrayList()
            saved.message = tw
            saved.flags |= FLAG_MESSAGE
        if meta.get("name_hidden"):
            saved.name_hidden = True
            saved.flags |= FLAG_NAME_HIDDEN
        if meta.get("hidden"):
            saved.unsaved = True
            saved.flags |= FLAG_UNSAVED

    def save_gift_locally(self, request):
        slug = self.input_to_slug(request.stargift)
        if slug is None:
            return None  # a real gift: let the server handle it
        self.update_meta(slug, hidden=bool(request.unsave))
        text = "Подарок скрыт из профиля" if request.unsave else "Подарок виден в профиле"
        run_on_ui_thread(lambda: BulletinHelper.show_success(text + " (локально). Переоткрой профиль"))
        return TLRPC.TL_boolTrue(), None

    def drop_details_form(self, request):
        """getPaymentForm for removing a local gift caption: the server has no such gift,
        so hand back a free form and let the flow continue to sendStarsForm."""
        invoice = request.invoice
        if not isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftDropOriginalDetails):
            return None
        if self.input_to_slug(invoice.stargift) is None:
            return None
        form = TLRPC.TL_payments_paymentFormStarGift()
        form.form_id = int(time.time() * 1000)
        form.invoice = TLRPC.TL_invoice()
        form.invoice.prices = ArrayList()  # free, no stars needed
        return form, None

    def drop_caption_locally(self, invoice):
        slug = self.input_to_slug(invoice.stargift)
        if slug is None:
            return None
        self.update_meta(slug, text="", name_hidden=False, drop_details=True)
        gift = self.gifts.get(slug)
        if gift is not None:
            self.strip_original_details(gift)
        run_on_ui_thread(lambda: BulletinHelper.show_success("Подпись убрана (локально). Переоткрой профиль"))
        updates = TLRPC.TL_updates()
        updates.date = int(time.time())
        response = TLRPC.TL_payments_paymentResult()
        response.updates = updates
        return response, None

    def strip_original_details(self, gift):
        attrs = gift.attributes
        if attrs is None:
            return
        for i in reversed(range(attrs.size())):
            if isinstance(attrs.get(i), TL_stars.starGiftAttributeOriginalDetails):
                attrs.remove(jint(i))

    # Per-gift pinned state: what the user pins by hand, not forced by the global toggle.

    def get_pinned_map(self) -> dict:
        try:
            return json.loads(self.get_setting("pinned_slugs", "") or "{}")
        except ValueError:
            return {}

    def input_to_slug(self, entry):
        if isinstance(entry, TL_stars.TL_inputSavedStarGiftSlug):
            return entry.slug if entry.slug in self.slugs else None
        if isinstance(entry, TL_stars.TL_inputSavedStarGiftUser):
            return self.local_msg_ids.get(entry.msg_id)
        return None

    def on_toggle_pinned(self, account: int, request) -> HookResult:
        if not self.is_own_peer(account, getattr(request, "peer", None)):
            return HookResult()
        lst = request.stargift
        pinned, keep = set(), []
        for i in range(lst.size()):
            entry = lst.get(i)
            slug = self.input_to_slug(entry)
            if slug:
                pinned.add(slug)
            else:
                keep.append(entry)
        if len(keep) == lst.size():
            return HookResult()  # no local gifts in this request
        pmap = self.get_pinned_map()
        for slug in self.slugs:
            pmap[slug] = slug in pinned
        self.set_setting("pinned_slugs", json.dumps(pmap))
        new_list = ArrayList()
        for entry in keep:
            new_list.add(entry)
        if new_list.size() == 0:
            return HookResult(strategy=HookStrategy.CANCEL)
        request.stargift = new_list
        return HookResult(strategy=HookStrategy.MODIFY, request=request)

    # Local listings on the marketplace: prices are kept per slug in the "listings" setting.

    def listings(self) -> dict:
        try:
            return json.loads(self.get_setting("listings", "") or "{}")
        except ValueError:
            return {}

    def forget_listing(self, slug: str):
        listings = self.listings()
        if listings.pop(slug, None) is not None:
            self.set_setting("listings", json.dumps(listings))

    def apply_listing(self, gift):
        """A bought gift arrives with the seller's price: show only our own local listing."""
        listing = self.listings().get(gift.slug)
        if not listing:
            gift.resell_amount = None
            gift.flags &= ~FLAG_RESELL_AMOUNT
            gift.resale_ton_only = False
            return
        gift.resell_amount = ArrayList()
        stars = TL_stars.StarsAmount.ofStars(int(listing["stars"]))
        ton = TL_stars.TL_starsTonAmount()
        ton.amount = int(listing["ton"])
        gift.resell_amount.add(stars)
        gift.resell_amount.add(ton)
        gift.resale_ton_only = bool(listing["ton_only"])
        gift.flags |= FLAG_RESELL_AMOUNT

    def local_gift_for(self, stargift):
        """The local gift an InputSavedStarGift points to, or None."""
        if isinstance(stargift, TL_stars.TL_inputSavedStarGiftSlug):
            return next((g for g in self.gifts.values() if g.slug == stargift.slug), None)
        if isinstance(stargift, TL_stars.TL_inputSavedStarGiftUser):
            slug = self.local_msg_ids.get(stargift.msg_id)
            return self.gifts.get(slug) if slug else None
        return None

    def set_price_locally(self, request):
        gift = self.local_gift_for(request.stargift)
        if gift is None:
            return None  # a real gift: let the server handle it
        listings = self.listings()
        amount = request.resell_amount
        if amount is None or (amount.amount == 0 and amount.nanos == 0):
            listings.pop(gift.slug, None)
            BulletinHelper.show_success("Снято с продажи (локально)")
        else:
            is_ton = isinstance(amount, TL_stars.TL_starsTonAmount)
            # The app shows both prices; keep the other currency at the same value as Telegram does.
            stars = amount.amount if not is_ton else 0
            ton = amount.amount if is_ton else 0
            listings[gift.slug] = {"stars": stars, "ton": ton, "ton_only": is_ton}
            BulletinHelper.show_success("Выставлено на продажу (локально)")
        self.set_setting("listings", json.dumps(listings))
        updates = TLRPC.TL_updates()
        updates.date = int(time.time())
        return updates, None

    # Fragment data model: usernames as a JSON list of {name, price}, the +888
    # number and its price, each managed from the settings UI.

    def get_usernames(self) -> list:
        try:
            data = json.loads(self.get_setting("usernames_json", "") or "[]")
        except ValueError:
            data = []
        return [d for d in data if isinstance(d, dict) and d.get("name")]

    def save_usernames(self, items: list):
        self.set_setting("usernames_json", json.dumps(items))
        self.refresh_own_users()

    def username_names(self) -> List[str]:
        return [d["name"] for d in self.get_usernames()]

    def price_of(self, name: str) -> float:
        for d in self.get_usernames():
            if d["name"].lower() == name.lower():
                return float(d.get("price") or DEFAULT_PRICE)
        return float(DEFAULT_PRICE)

    def number_price(self) -> float:
        try:
            return float(self.get_setting("number_price", "") or DEFAULT_PRICE)
        except ValueError:
            return float(DEFAULT_PRICE)

    def migrate_fragment_settings(self):
        if self.get_setting("usernames_json", None) is not None:
            return  # already on the new model
        old = parse_usernames(self.get_setting("fragment_usernames", ""))
        if not old:
            return
        prices = parse_prices(self.get_setting("fragment_prices", ""))
        items = [{"name": n, "price": prices.get(n.lower(), DEFAULT_PRICE)} for n in old]
        self.set_setting("usernames_json", json.dumps(items))
        if "number" in prices:
            self.set_setting("number_price", str(prices["number"]))

    # Subtitles shown on the two entry rows.

    def usernames_subtext(self) -> str:
        items = self.get_usernames()
        if not items:
            return "Нет. Нажми, чтобы добавить"
        primary = (self.get_setting("primary_username", "") or "").lower()
        names = ["@" + d["name"] + (" ⭐" if d["name"].lower() == primary else "") for d in items]
        return ", ".join(names)

    def number_subtext(self) -> str:
        number = parse_phone(self.get_setting("anon_number", ""))
        return format_phone(number) if number else "Не задан. Нажми, чтобы задать"

    # Management screens, built from AlertDialogs so they refresh after every change.

    def price_label(self, gram: float) -> str:
        fiat = FIAT[self.get_setting("fiat_currency", 0)]
        symbol = {"USD": "$", "EUR": "€", "RUB": "₽"}[fiat]
        fiat_value = gram * self.ton_rate(fiat)
        return f"{int(gram)} GRAM (~{symbol}{fiat_value:,.0f})"

    def manage_usernames(self):
        try:
            self.fragment_usernames_sheet()
            return
        except Exception:
            self.logger.exception("Fragment username sheet failed, using dialogs")
        self.manage_usernames_dialog()

    def manage_number(self):
        try:
            self.fragment_number_sheet()
            return
        except Exception:
            self.logger.exception("Fragment number sheet failed, using dialogs")
        self.manage_number_dialog()

    # ----- Fragment-styled screens (custom views) — VARIANT A -----

    # ===== Fragment-styled screens — VARIANT A (marketplace cards) =====
    #
    # Drop-in replacements for the plugin's view-layer methods. Logic/data methods
    # (get_usernames, price_of, username_actions, ...) are reused, never redefined.

    # extra palette (signed 32-bit ints)
    FGA_TABLE = _argb(0xFF212A33)
    FGA_GREEN = _argb(0xFF5AEC8C)
    FGA_GREEN_BG = _argb(0x1A5AEC8C)      # ~10% green
    FGA_ACCENT_BG = _argb(0x1A4DB2FF)     # ~10% accent
    FGA_SUB2 = _argb(0xFF8C9AA9)

    def dp(self, value):
        return AndroidUtilities.dp(value)

    def fg_text(self, activity, text, size, color, bold=False):
        view = TextView(activity)
        view.setText(text)
        view.setTextColor(color)
        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, float(size))
        if bold:
            view.setTypeface(Typeface.DEFAULT_BOLD)
        return view

    def fg_card(self, activity, radius=12):
        bg = GradientDrawable()
        bg.setColor(FG_CARD)
        bg.setCornerRadius(float(self.dp(radius)))
        view = LinearLayout(activity)
        view.setOrientation(LinearLayout.VERTICAL)
        view.setBackground(bg)
        view.setPadding(self.dp(14), self.dp(13), self.dp(14), self.dp(13))
        return view

    def fg_root(self, activity, title, subtitle=None):
        scroll = ScrollView(activity)
        scroll.setBackgroundColor(FG_BG)
        column = LinearLayout(activity)
        column.setOrientation(LinearLayout.VERTICAL)
        column.setPadding(self.dp(16), self.dp(22), self.dp(16), self.dp(22))
        scroll.addView(column)
        gem = self.fg_text(activity, "❖", 40, FG_ACCENT, bold=True)
        gem.setGravity(Gravity.CENTER)
        column.addView(gem)
        head = self.fg_text(activity, title, 23, FG_TEXT, bold=True)
        head.setGravity(Gravity.CENTER)
        head.setPadding(0, self.dp(10), 0, 0)
        column.addView(head)
        sub = self.fg_text(activity, subtitle or "fragment.com", 13, self.FGA_SUB2)
        sub.setGravity(Gravity.CENTER)
        sub.setPadding(0, self.dp(3), 0, self.dp(18))
        column.addView(sub)
        return scroll, column

    def fg_show(self, activity, root):
        builder = BottomSheet.Builder(activity, False)
        builder.setApplyBottomPadding(False)
        builder.setApplyTopPadding(False)
        builder.setCustomView(root)
        sheet = builder.show()
        try:
            sheet.setBackgroundColor(FG_BG)
        except Exception:
            pass
        return sheet

    def fg_button(self, activity, text, on_click, color=FG_BTN):
        bg = GradientDrawable()
        bg.setColor(color)
        bg.setCornerRadius(float(self.dp(10)))
        button = self.fg_text(activity, text, 15, FG_TEXT, bold=True)
        button.setGravity(Gravity.CENTER)
        button.setBackground(bg)
        button.setPadding(0, self.dp(15), 0, self.dp(15))
        button.setOnClickListener(OnClickListener(lambda v: on_click()))
        return button

    # ----- Variant A helpers -----

    def fgA_section(self, activity, column, text):
        label = self.fg_text(activity, text, 13, self.FGA_SUB2, bold=True)
        label.setAllCaps(True)
        label.setPadding(self.dp(4), self.dp(18), self.dp(4), self.dp(9))
        column.addView(label)

    def fgA_avatar(self, activity, letter):
        bg = GradientDrawable()
        bg.setShape(GradientDrawable.OVAL)
        bg.setColor(self.FGA_ACCENT_BG)
        view = self.fg_text(activity, (letter or "?")[:1].upper(), 18, FG_ACCENT, bold=True)
        view.setGravity(Gravity.CENTER)
        view.setBackground(bg)
        size = self.dp(42)
        params = LinearLayout.LayoutParams(size, size)
        params.rightMargin = self.dp(13)
        view.setLayoutParams(params)
        return view

    def fgA_chip(self, activity, text, color, bg_color):
        bg = GradientDrawable()
        bg.setColor(bg_color)
        bg.setCornerRadius(float(self.dp(8)))
        chip = self.fg_text(activity, text, 11, color, bold=True)
        chip.setBackground(bg)
        chip.setPadding(self.dp(8), self.dp(3), self.dp(8), self.dp(3))
        return chip

    def fgA_price_cell(self, activity, gram):
        box = LinearLayout(activity)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setGravity(Gravity.END)
        top = self.fg_text(activity, "♦ " + str(int(gram)), 16, FG_ACCENT, bold=True)
        top.setGravity(Gravity.END)
        box.addView(top)
        label = self.price_label(gram)
        fiat = label.split("(~", 1)[1].rstrip(")") if "(~" in label else ""
        if fiat:
            sub = self.fg_text(activity, "≈ " + fiat, 12, self.FGA_SUB2)
            sub.setGravity(Gravity.END)
            sub.setPadding(0, self.dp(2), 0, 0)
            box.addView(sub)
        return box

    def fgA_card_row(self, activity, column, letter, title, chip, gram, on_click):
        card = self.fg_card(activity)
        card.setOrientation(LinearLayout.HORIZONTAL)
        card.setGravity(Gravity.CENTER_VERTICAL)
        card.addView(self.fgA_avatar(activity, letter))

        middle = LinearLayout(activity)
        middle.setOrientation(LinearLayout.VERTICAL)
        title_row = LinearLayout(activity)
        title_row.setOrientation(LinearLayout.HORIZONTAL)
        title_row.setGravity(Gravity.CENTER_VERTICAL)
        title_row.addView(self.fg_text(activity, title, 17, FG_TEXT, bold=True))
        if chip is not None:
            params = LinearLayout.LayoutParams(-2, -2)
            params.leftMargin = self.dp(8)
            chip.setLayoutParams(params)
            title_row.addView(chip)
        middle.addView(title_row)
        middle.addView(self.fgA_chip_hint(activity))
        middle_params = LinearLayout.LayoutParams(0, -2, 1.0)
        middle.setLayoutParams(middle_params)
        card.addView(middle)

        if gram is not None:
            card.addView(self.fgA_price_cell(activity, gram))

        if on_click is not None:
            card.setOnClickListener(OnClickListener(lambda v: on_click()))
        params = LinearLayout.LayoutParams(-1, -2)
        params.bottomMargin = self.dp(10)
        column.addView(card, params)

    def fgA_chip_hint(self, activity):
        hint = self.fg_text(activity, "нажми, чтобы изменить", 12, self.FGA_SUB2)
        hint.setPadding(0, self.dp(2), 0, 0)
        return hint

    # ----- Username sheet -----

    def fragment_usernames_sheet(self):
        activity = self.get_activity()
        if activity is None:
            return
        scroll, column = self.fg_root(activity, "Мои юзернеймы", "коллекционные юзернеймы")
        items = self.get_usernames()
        primary = (self.get_setting("primary_username", "") or "").lower()

        if not items:
            empty = self.fg_text(activity, "Пока пусто. Добавь свой первый юзернейм.", 15, self.FGA_SUB2)
            empty.setGravity(Gravity.CENTER)
            empty.setPadding(0, self.dp(8), 0, self.dp(16))
            column.addView(empty)
        else:
            self.fgA_section(activity, column, str(len(items)) + " в коллекции")
            for d in items:
                name = d["name"]
                gram = float(d.get("price") or DEFAULT_PRICE)
                is_primary = name.lower() == primary
                chip = self.fgA_chip(activity, "основной", FG_ACCENT, self.FGA_ACCENT_BG) if is_primary else None
                self.fgA_card_row(
                    activity, column, name, "@" + name, chip, gram,
                    lambda n=name: (self.active_sheet_dismiss(), self.username_actions(n)),
                )

        add = self.fg_button(activity, "+  Добавить юзернейм",
                             lambda: (self.active_sheet_dismiss(), self.add_username_dialog()))
        params = LinearLayout.LayoutParams(-1, -2)
        params.topMargin = self.dp(8)
        column.addView(add, params)

        note = self.fg_text(activity, "Видно только тебе. Цена и её курс — как на Fragment.",
                            12, self.FGA_SUB2)
        note.setGravity(Gravity.CENTER)
        note.setPadding(self.dp(4), self.dp(16), self.dp(4), 0)
        column.addView(note)

        self.active_sheet = self.fg_show(activity, scroll)

    # ----- Number sheet -----

    def fragment_number_sheet(self):
        activity = self.get_activity()
        if activity is None:
            return
        scroll, column = self.fg_root(activity, "Анонимный номер", "+888")
        number = parse_phone(self.get_setting("anon_number", ""))

        if number:
            self.fgA_section(activity, column, "твой номер")
            card = self.fg_card(activity)
            card.setOrientation(LinearLayout.HORIZONTAL)
            card.setGravity(Gravity.CENTER_VERTICAL)
            card.addView(self.fgA_avatar(activity, "8"))
            middle = LinearLayout(activity)
            middle.setOrientation(LinearLayout.VERTICAL)
            middle.addView(self.fg_text(activity, format_phone(number), 17, FG_TEXT, bold=True))
            status = self.fgA_chip(activity, "активен", self.FGA_GREEN, self.FGA_GREEN_BG)
            status_params = LinearLayout.LayoutParams(-2, -2)
            status_params.topMargin = self.dp(5)
            status.setLayoutParams(status_params)
            middle.addView(status)
            middle.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1.0))
            card.addView(middle)
            card.addView(self.fgA_price_cell(activity, self.number_price()))
            card_params = LinearLayout.LayoutParams(-1, -2)
            card_params.bottomMargin = self.dp(12)
            column.addView(card, card_params)

            for label, action in (
                ("Изменить номер", lambda: (self.active_sheet_dismiss(), self.set_number_dialog())),
                ("Изменить цену", lambda: (self.active_sheet_dismiss(),
                                           self.price_dialog(self.number_price(), self.set_number_price))),
            ):
                btn = self.fg_button(activity, label, action, color=FG_CARD)
                p = LinearLayout.LayoutParams(-1, -2)
                p.bottomMargin = self.dp(8)
                column.addView(btn, p)
            remove = self.fg_button(activity, "Убрать номер",
                                    lambda: (self.active_sheet_dismiss(), self.remove_number()), color=FG_DANGER)
            column.addView(remove, LinearLayout.LayoutParams(-1, -2))
        else:
            empty = self.fg_text(activity, "Номер +888 не задан.", 15, self.FGA_SUB2)
            empty.setGravity(Gravity.CENTER)
            empty.setPadding(0, self.dp(8), 0, self.dp(16))
            column.addView(empty)
            add = self.fg_button(activity, "Задать номер +888",
                                 lambda: (self.active_sheet_dismiss(), self.set_number_dialog()))
            column.addView(add, LinearLayout.LayoutParams(-1, -2))

        self.active_sheet = self.fg_show(activity, scroll)

    def remove_number(self):
        self.set_setting("anon_number", "")
        self.refresh_own_users()
        BulletinHelper.show_success("Номер убран. Переоткрой профиль")

    def active_sheet_dismiss(self):
        sheet = getattr(self, "active_sheet", None)
        if sheet is not None:
            try:
                sheet.dismiss()
            except Exception:
                pass
            self.active_sheet = None

    # ----- plain dialog fallback for the two screens -----

    def manage_usernames_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        items = self.get_usernames()
        primary = (self.get_setting("primary_username", "") or "").lower()
        rows = []
        for d in items:
            star = " ⭐ основной" if d["name"].lower() == primary else ""
            rows.append(f"@{d['name']}  ·  {self.price_label(float(d.get('price') or DEFAULT_PRICE))}{star}")
        rows.append("➕ Добавить юзернейм")

        builder = AlertDialogBuilder(activity)
        builder.set_title("Мои юзернеймы")

        def on_click(bld, which):
            bld.dismiss()
            if which == len(items):
                self.add_username_dialog()
            else:
                self.username_actions(items[which]["name"])

        builder.set_items(rows, on_click)
        builder.set_negative_button("Закрыть", lambda bld, _: bld.dismiss())
        builder.show()

    def username_actions(self, name: str):
        activity = self.get_activity()
        if activity is None:
            return
        is_primary = (self.get_setting("primary_username", "") or "").lower() == name.lower()
        actions = ["Изменить цену", "Убрать основной" if is_primary else "Сделать основным", "Удалить"]

        builder = AlertDialogBuilder(activity)
        builder.set_title(f"@{name}")

        def on_click(bld, which):
            bld.dismiss()
            if which == 0:
                self.price_dialog(self.price_of(name), lambda value: self.set_username_price(name, value))
            elif which == 1:
                self.set_setting("primary_username", "" if is_primary else name)
                self.refresh_own_users()
                self.manage_usernames()
            else:
                self.save_usernames([d for d in self.get_usernames() if d["name"].lower() != name.lower()])
                if is_primary:
                    self.set_setting("primary_username", "")
                self.manage_usernames()

        builder.set_items(actions, on_click)
        builder.set_negative_button("Назад", lambda bld, _: (bld.dismiss(), self.manage_usernames()))
        builder.show()

    def set_username_price(self, name: str, price: float):
        items = self.get_usernames()
        for d in items:
            if d["name"].lower() == name.lower():
                d["price"] = price
        self.save_usernames(items)
        self.manage_usernames()

    def add_username_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        layout = LinearLayout(activity)
        layout.setOrientation(LinearLayout.VERTICAL)
        pad = AndroidUtilities.dp(22)
        layout.setPadding(pad, 0, pad, 0)
        name_field = EditText(activity)
        name_field.setHint("Юзернейм, например durov")
        name_field.setInputType(InputType.TYPE_CLASS_TEXT)
        price_field = EditText(activity)
        price_field.setHint("Цена в GRAM, например 7000")
        price_field.setInputType(InputType.TYPE_CLASS_NUMBER)
        layout.addView(name_field)
        layout.addView(price_field)

        builder = AlertDialogBuilder(activity)
        builder.set_title("Новый юзернейм")
        builder.set_view(layout)

        def on_ok(bld, _):
            names = parse_usernames(str(name_field.getText()))
            bld.dismiss()
            if not names:
                BulletinHelper.show_error("Юзернейм: 4-32 латинских буквы, цифры или _")
                self.manage_usernames()
                return
            name = names[0]
            try:
                price = float(str(price_field.getText()).replace(",", ".")) if str(price_field.getText()).strip() else DEFAULT_PRICE
            except ValueError:
                price = DEFAULT_PRICE
            items = [d for d in self.get_usernames() if d["name"].lower() != name.lower()]
            items.append({"name": name, "price": price})
            self.save_usernames(items)
            self.manage_usernames()

        builder.set_positive_button("Добавить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: (bld.dismiss(), self.manage_usernames()))
        builder.show()

    def price_dialog(self, current: float, on_value):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER)
        field.setHint("Цена в GRAM")
        field.setText(str(int(current)))

        builder = AlertDialogBuilder(activity)
        builder.set_title("Цена покупки (GRAM)")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            try:
                on_value(float(str(field.getText()).replace(",", ".")))
            except ValueError:
                BulletinHelper.show_error("Нужно число")

        builder.set_positive_button("Сохранить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def manage_number_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        number = parse_phone(self.get_setting("anon_number", ""))
        if number:
            rows = [f"Номер: {format_phone(number)}", f"Цена: {self.price_label(self.number_price())}",
                    "Изменить номер", "Изменить цену", "Убрать номер"]
            offset = 2
        else:
            rows = ["Задать номер +888"]
            offset = 0

        builder = AlertDialogBuilder(activity)
        builder.set_title("Анонимный номер +888")

        def on_click(bld, which):
            bld.dismiss()
            if not number:
                self.set_number_dialog()
                return
            if which == offset:       # change number
                self.set_number_dialog()
            elif which == offset + 1:  # change price
                self.price_dialog(self.number_price(), self.set_number_price)
            elif which == offset + 2:  # remove
                self.set_setting("anon_number", "")
                self.refresh_own_users()
                BulletinHelper.show_success("Номер убран. Переоткрой профиль")

        builder.set_items(rows, on_click)
        builder.set_negative_button("Закрыть", lambda bld, _: bld.dismiss())
        builder.show()

    def set_number_price(self, price: float):
        self.set_setting("number_price", str(price))
        self.manage_number()

    def set_number_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_PHONE)
        field.setHint("+888 0123 4567")
        field.setText("+" + parse_phone(self.get_setting("anon_number", "")))

        builder = AlertDialogBuilder(activity)
        builder.set_title("Анонимный номер +888")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            phone = parse_phone(str(field.getText()))
            if not phone:
                BulletinHelper.show_error("Это не номер +888")
                return
            self.set_setting("anon_number", phone)
            self.refresh_own_users()
            BulletinHelper.show_success("Номер задан. Переоткрой профиль")
            self.manage_number()

        builder.set_positive_button("Сохранить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    # Fragment: purchase info for the local usernames and +888 number.

    def ton_rate(self, fiat: str) -> float:
        """GRAM (TON) price in fiat. Refreshes in the background, never blocks."""
        try:
            cached = json.loads(self.get_setting("ton_rates", "") or "{}")
        except ValueError:
            cached = {}
        if time.time() - cached.get("time", 0) > RATES_TTL and not self.rates_loading:
            self.rates_loading = True
            threading.Thread(target=self.load_rates, daemon=True).start()
        return float(cached.get(fiat) or FALLBACK_RATES[fiat])

    def load_rates(self):
        try:
            data = json.loads(http_get(RATES_URL))["the-open-network"]
            rates = {fiat: float(data[fiat.lower()]) for fiat in FIAT}
            rates["time"] = time.time()
            self.set_setting("ton_rates", json.dumps(rates))
        except Exception:
            self.logger.exception("Could not load GRAM rates, using the last known ones")
        finally:
            self.rates_loading = False

    def collectible_info(self, request):
        collectible = request.collectible
        if isinstance(collectible, TL_fragment.TL_inputCollectibleUsername):
            name = next((n for n in self.username_names()
                         if n.lower() == (collectible.username or "").lower()), None)
            if name is None:
                return None
            key, url, price = name.lower(), f"https://fragment.com/username/{name}", self.price_of(name)
        elif isinstance(collectible, TL_fragment.TL_inputCollectiblePhone):
            phone = parse_phone(self.get_setting("anon_number", ""))
            if not phone or re.sub(r"\D", "", collectible.phone or "") != phone:
                return None
            key, url, price = "number", f"https://fragment.com/number/{phone}", self.number_price()
        else:
            return None

        fiat = FIAT[self.get_setting("fiat_currency", 0)]
        date_key = f"bought_at_{key}"
        bought_at = self.get_setting(date_key, 0)
        if not bought_at:
            bought_at = int(time.time())
            self.set_setting(date_key, bought_at)

        info = TL_fragment.TL_collectibleInfo()
        info.purchase_date = int(bought_at)
        info.crypto_currency = "TON"
        info.crypto_amount = int(price * NANO)
        info.currency = fiat
        info.amount = int(round(price * self.ton_rate(fiat) * 100))  # cents / kopecks
        info.url = url
        return info, None

    def open_saved_messages(self, account: int, text: str):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            args = Bundle()
            args.putLong("user_id", get_user_config(account).getClientUserId())
            chat = ChatActivity(args)
            fragment.presentFragment(chat)
            run_on_ui_thread(lambda: BulletinHelper.show_success(text, chat), 400)
        except Exception:
            self.logger.exception("Could not open Saved Messages")
            BulletinHelper.show_success(text)

    # Cards in Saved Messages for local purchases. They are only in this app's database.

    def post_saved_card(self, purchase, gift, unique: bool):
        """purchase is (account, price, ton): price in stars, or nanoTON when ton."""
        account, price, ton = purchase
        try:
            user_id = get_user_config(account).getClientUserId()
            me = TLRPC.TL_peerUser()
            me.user_id = user_id

            if unique:
                action = TLRPC.TL_messageActionStarGiftUnique()
                action.saved = True
                action.flags |= 4
                # With a resale amount the app writes "You bought this gift for ...".
                if ton:
                    action.resale_amount = TL_stars.TL_starsTonAmount()
                    action.resale_amount.amount = int(price)
                else:
                    action.resale_amount = TL_stars.StarsAmount.ofStars(int(price))
                action.flags |= 256
            else:
                action = TLRPC.TL_messageActionStarGift()
                action.saved = True
                action.flags |= 4
            action.gift = gift

            message = TLRPC.TL_messageService()
            message.id = get_user_config(account).getNewMessageId()
            message.from_id = me
            message.peer_id = me
            message.dialog_id = user_id
            message.date = int(time.time())
            message.out = True
            message.flags |= 2 | 256
            message.action = action

            messages = ArrayList()
            messages.add(message)
            try:
                MessagesStorage.getInstance(account).putMessages(messages, False, True, False, 0, 0, 0)
            except Exception:
                self.logger.exception("Could not save the purchase card, it will vanish after restart")
            objects = ArrayList()
            objects.add(MessageObject(account, message, True, True))
            run_on_ui_thread(lambda: get_messages_controller(account).updateInterfaceWithMessages(user_id, objects, 0))
        except Exception:
            self.logger.exception("Could not post the purchase card to Saved Messages")

    # Picker: collection -> NFT on resale, by number or a random one.

    def get_activity(self):
        fragment = get_last_fragment()
        return fragment.getParentActivity() if fragment else None

    def show_loading(self):
        activity = self.get_activity()
        if activity is None:
            return None
        dialog = AlertDialogBuilder(activity, AlertDialogBuilder.ALERT_TYPE_SPINNER)
        dialog.show()
        return dialog

    def show_items(self, title: str, items: List[str], on_pick):
        activity = self.get_activity()
        if activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(title)

        def on_click(bld, which):
            bld.dismiss()
            on_pick(which)

        builder.set_items(items, on_click)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def request_on_ui(self, req, on_result):
        """Sends a request with a loading spinner and calls on_result(response) on the UI thread."""
        loading = self.show_loading()
        state = {"done": False}

        def close_loading():
            if loading:
                try:
                    loading.dismiss()
                except Exception:
                    pass

        def on_response(response, error):
            def finish():
                if state["done"]:
                    return
                state["done"] = True
                close_loading()
                if error or response is None:
                    BulletinHelper.show_error(f"Ошибка: {error.text if error else 'пустой ответ'}")
                    return
                try:
                    on_result(response)
                except Exception as e:
                    self.logger.exception("Picker failed")
                    BulletinHelper.show_error(f"Ошибка плагина: {type(e).__name__}: {e}")
            run_on_ui_thread(finish)

        def on_timeout():
            if not state["done"]:
                state["done"] = True
                close_loading()
                BulletinHelper.show_error("Сервер не ответил. Попробуй ещё раз")

        try:
            send_request(req, on_response)
        except Exception as e:
            self.logger.exception("Could not send the picker request")
            state["done"] = True
            close_loading()
            BulletinHelper.show_error(f"Ошибка плагина: {type(e).__name__}: {e}")
            return
        run_on_ui_thread(on_timeout, 15000)

    def pick_collection(self):
        req = TL_stars.getStarGifts()
        req.hash = 0

        def on_result(response):
            gifts = jlist(getattr(response, "gifts", None))
            self.logger.info(f"Gift catalog: {response.getClass().getSimpleName()}, {len(gifts)} gifts")
            resale = lambda gift: int(getattr(gift, "availability_resale", 0) or 0)
            collections = [
                gift for gift in gifts
                if resale(gift) > 0 or int(getattr(gift, "upgrade_stars", 0) or 0) > 0
            ]
            collections.sort(key=lambda gift: -resale(gift))
            if not collections:
                BulletinHelper.show_error(f"Коллекции не найдены (в каталоге {len(gifts)} подарков)")
                return
            items = [f"{gift.title or 'Без названия'} ({resale(gift)} в продаже)" for gift in collections]
            self.show_items("Коллекция", items, lambda i: self.pick_from_collection(collections[i]))

        self.request_on_ui(req, on_result)

    def pick_from_collection(self, collection):
        req = TL_stars.getResaleStarGifts()
        req.gift_id = collection.id
        req.sort_by_price = True
        req.offset = ""
        req.limit = 50

        def on_result(response):
            uniques = [gift for gift in jlist(response.gifts) if gift.slug]
            base = uniques[0].slug.rsplit("-", 1)[0] if uniques else slug_base(collection.title)
            items = ["🔢 Ввести номер"]
            if uniques:
                items.append("🎲 Случайный")
            items += [describe_unique(gift) for gift in uniques]

            def on_pick(i):
                if i == 0:
                    self.ask_number(collection.title, base)
                elif i == 1:
                    self.add_slug(random.choice(uniques).slug)
                else:
                    self.add_slug(uniques[i - 2].slug)

            self.show_items(collection.title, items, on_pick)

        self.request_on_ui(req, on_result)

    def ask_number(self, title: str, base: str):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER)
        field.setHint("Например 1")
        builder = AlertDialogBuilder(activity)
        builder.set_title(f"{title}: номер")
        builder.set_view(field)

        def on_ok(bld, _):
            number = str(field.getText()).strip()
            bld.dismiss()
            if number.isdigit():
                self.add_slug(f"{base}-{int(number)}")

        builder.set_positive_button("Добавить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def add_slug(self, slug: str):
        slugs = parse_slugs(self.get_setting("slug", ""))
        if slug not in slugs:
            slugs.append(slug)
        self.save_slugs(slugs)

    def pick_to_remove(self):
        slugs = parse_slugs(self.get_setting("slug", ""))
        if not slugs:
            BulletinHelper.show_info("Список NFT пуст")
            return

        def on_pick(i):
            self.save_slugs(slugs[:i] + slugs[i + 1:])
            BulletinHelper.show_success(f"«{slugs[i]}» убран. Переоткрой профиль")

        self.show_items("Убрать NFT", slugs, on_pick)

    def save_slugs(self, slugs: List[str]):
        text = ", ".join(slugs)
        self.set_setting("slug", text, reload_settings=True)
        self.load_gifts(text)

    def load_gifts(self, text: str):
        # Responses to an older list of links are dropped by comparing generations.
        self.generation += 1
        generation = self.generation
        self.slugs = parse_slugs(text)
        self.gifts = {}
        for slug in self.slugs:
            self.load_gift(slug, generation)

    def load_gift(self, slug: str, generation: int):
        req = TL_stars.getUniqueStarGift()
        req.slug = slug

        def on_response(response, error):
            if generation != self.generation:
                return
            if error or response is None or response.gift is None:
                text = error.text if error else "пустой ответ"
                BulletinHelper.show_error(f"NFT «{slug}» не найден: {text}")
                return
            gift = response.gift
            self.apply_listing(gift)
            if self.gift_meta(slug).get("drop_details"):
                self.strip_original_details(gift)
            self.gifts[slug] = gift
            if slug in self.announce:
                self.post_saved_card(self.announce.pop(slug), gift, unique=True)
            BulletinHelper.show_success(
                f"NFT «{gift.title} #{gift.num}» загружен ({len(self.gifts)}/{len(self.slugs)})"
            )

        send_request(req, on_response)

    def loaded_gifts(self) -> List[Any]:
        """Loaded gifts in the order the links were entered."""
        if not self.get_setting("enabled", True):
            return []
        return [self.gifts[slug] for slug in self.slugs if slug in self.gifts]

    def is_own_peer(self, account: int, peer) -> bool:
        if isinstance(peer, TLRPC.TL_inputPeerSelf):
            return True
        if isinstance(peer, TLRPC.TL_inputPeerUser):
            return peer.user_id == get_user_config(account).getClientUserId()
        return False

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        if isinstance(request, TL_account.updateEmojiStatus):
            return self.on_update_emoji_status(account, request)
        if "toggleStarGiftsPinnedToTop" in request_name:
            return self.on_toggle_pinned(account, request)
        if "getSavedStarGifts" in request_name:
            own_first_page = (
                self.is_own_peer(account, request.peer)
                and not request.offset
                and (request.flags & 64) == 0  # not a collection
            )
            self.pending[account].append(request if own_first_page else None)
        elif "getStarsStatus" in request_name or "getStarsTransactions" in request_name:
            self.tx_pending[account].append({
                "ton": bool(getattr(request, "ton", False)),
                "inbound": bool(getattr(request, "inbound", False)),
                "outbound": bool(getattr(request, "outbound", False)),
                "self": self.is_own_peer(account, getattr(request, "peer", None)),
                "first": not getattr(request, "offset", ""),
            })
        return HookResult()

    def on_update_emoji_status(self, account: int, request) -> HookResult:
        # The app has already put the new status on our user object before sending
        # the request, so keep it locally and do not send anything to the server.
        is_local_gift = (
            isinstance(request.emoji_status, TLRPC.TL_inputEmojiStatusCollectible)
            and request.emoji_status.collectible_id in self.local_gift_ids()
        )
        if not self.get_setting("local_premium", True) and not is_local_gift:
            return HookResult()
        user = get_user_config(account).getCurrentUser()
        if user is None:
            return HookResult()
        self.save_status(user.id, user.emoji_status)
        return HookResult(strategy=HookStrategy.CANCEL)

    def post_request_hook(self, request_name: str, account: int, response: Any, error: Any) -> HookResult:
        if isinstance(response, TLRPC.TL_payments_paymentFormStarGift):
            self.form_prices[response.form_id] = sum(p.amount for p in jlist(response.invoice.prices))
            return HookResult()
        if "getSavedStarGifts" in request_name:
            queue = self.pending[account]
            request = queue.popleft() if queue else None
            if request is None or error or response is None:
                return HookResult()
            saved = []
            if not request.exclude_unique:
                saved += [self.make_saved_gift(account, gift) for gift in self.loaded_gifts()]
            if not request.exclude_unlimited:
                saved += [
                    self.make_saved_regular_gift(account, gift, i)
                    for i, gift in enumerate(self.loaded_regular_gifts())
                ]
            if saved:
                for i, gift in enumerate(saved):
                    response.gifts.add(i, gift)
                response.count += len(saved)
                return HookResult(strategy=HookStrategy.MODIFY, response=response)
        elif "getStarsStatus" in request_name or "getStarsTransactions" in request_name:
            meta = self.tx_pending[account].popleft() if self.tx_pending[account] else None
            # Inject only into the paged transaction list, never the balance status,
            # so a purchase never shows up under "Зачисления".
            if meta and meta["self"] and meta["first"] and "getStarsTransactions" in request_name \
                    and not error and response is not None and self.get_setting("local_balance", True):
                txs = self.transactions_for(meta["ton"], meta["inbound"], meta["outbound"], account)
                if txs:
                    for t in reversed(txs):
                        response.history.add(0, t)
                    response.flags |= 8
                    return HookResult(strategy=HookStrategy.MODIFY, response=response)
        elif request_name == "TL_users_getFullUser":
            added = len(self.loaded_gifts()) + len(self.loaded_regular_gifts())
            if not error and response is not None and added:
                full = response.full_user
                if full is not None and full.id == get_user_config(account).getClientUserId():
                    full.stargifts_count += added
                    full.flags2 |= FLAG_STARGIFTS_COUNT
                    return HookResult(strategy=HookStrategy.MODIFY, response=response)
        return HookResult()

    def get_own_ids(self):
        if not self.own_ids:
            for account in range(UserConfig.MAX_ACCOUNT_COUNT):
                user_id = get_user_config(account).getClientUserId()
                if user_id:
                    self.own_ids.add(user_id)
        return self.own_ids

    def get_status(self, user_id: int):
        if user_id not in self.statuses:
            text = self.get_setting(f"status_{user_id}", "")
            try:
                self.statuses[user_id] = status_from_hex(text) if text else None
            except Exception:
                self.logger.exception("Could not restore the worn status")
                self.statuses[user_id] = None
        return self.statuses[user_id]

    def save_status(self, user_id: int, status):
        empty = status is None or isinstance(status, TLRPC.TL_emojiStatusEmpty)
        self.statuses[user_id] = None if empty else status
        self.set_setting(f"status_{user_id}", "" if empty else status_to_hex(status))

    def patch_user(self, user):
        if user is None or user.id not in self.get_own_ids():
            return
        if self.get_setting("local_premium", True):
            user.premium = True
        status = self.get_status(user.id)
        if status is not None:
            user.emoji_status = status
        self.patch_usernames(user)
        self.patch_phone(user)

    def patch_usernames(self, user):
        names = self.username_names()
        if user.usernames is None:
            user.usernames = ArrayList()
        # Drop what we added last time, so removed names go away without a restart.
        for i in reversed(range(user.usernames.size())):
            entry = user.usernames.get(i)
            if not entry.editable and entry.username in self.added_usernames:
                user.usernames.remove(jint(i))  # by index, not by value
        self.added_usernames = set(names)
        if names and user.usernames.size() == 0 and user.username:
            own = TLRPC.TL_username()
            own.editable = True
            own.active = True
            own.username = user.username
            user.usernames.add(own)
        present = {user.usernames.get(i).username.lower() for i in range(user.usernames.size())}
        for name in names:
            if name.lower() in present:
                continue
            entry = TLRPC.TL_username()
            entry.active = True
            entry.username = name
            user.usernames.add(entry)
        if names:
            user.flags2 |= FLAG_USERNAMES

        # Choose which username shows under the name (user.username). The rest fall under "also".
        primary = parse_usernames(self.get_setting("primary_username", ""))
        if primary:
            choice = primary[0]
            if self.real_username.get(user.id) is None:
                self.real_username[user.id] = user.username or ""
            user.username = choice
            # The chosen one should not also repeat in the "also" list.
            for i in reversed(range(user.usernames.size())):
                if user.usernames.get(i).username.lower() == choice.lower():
                    user.usernames.remove(jint(i))
        elif user.id in self.real_username:
            user.username = self.real_username[user.id]

    def patch_phone(self, user):
        fake = parse_phone(self.get_setting("anon_number", ""))
        key = f"real_phone_{user.id}"
        if user.phone and not user.phone.startswith("888") and self.real_phones.get(user.id) != user.phone:
            self.real_phones[user.id] = user.phone
            self.set_setting(key, user.phone)
        real = self.real_phones.get(user.id) or self.get_setting(key, "")
        if fake:
            user.phone = fake
        elif user.phone and user.phone.startswith("888") and real:
            user.phone = real

    def refresh_own_users(self):
        self.own_ids = set()
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            config = get_user_config(account)
            if not config.isClientActivated():
                continue
            user = config.getCurrentUser()
            if user is not None:
                self.patch_user(user)
            cached = get_messages_controller(account).getUser(config.getClientUserId())
            if cached is not None and cached is not user:
                self.patch_user(cached)

    def clear_statuses(self):
        for user_id in list(self.get_own_ids()):
            self.save_status(user_id, None)
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            user = get_user_config(account).getCurrentUser()
            if user is not None:
                user.emoji_status = TLRPC.TL_emojiStatusEmpty()
        BulletinHelper.show_success("Статус снят. Переоткрой профиль")

    def local_gift_ids(self):
        return {gift.id for gift in self.gifts.values()}

    def make_saved_gift(self, account: int, gift):
        user_config = get_user_config(account)
        me = TLRPC.TL_peerUser()
        me.user_id = user_config.getClientUserId()

        gift.owner_id = me
        gift.flags = (gift.flags | FLAG_OWNER_ID) & ~(FLAG_OWNER_NAME | FLAG_OWNER_ADDRESS)
        gift.owner_name = None
        gift.owner_address = None

        saved = TL_stars.TL_savedStarGift()
        saved.gift = gift
        saved.date = int(time.time())
        saved.pinned_to_top = self.get_pinned_map().get(gift.slug, self.get_setting("pinned", True))
        # A unique saved_id: without it the app cannot tell our gifts apart and drops
        # their pinned state when the profile is reopened.
        index = self.slugs.index(gift.slug) if gift.slug in self.slugs else 0
        saved.saved_id = LOCAL_SAVED_ID_BASE + index
        saved.flags |= FLAG_SAVED_ID
        # The gift screen sends this id back when listing the gift for sale.
        saved.msg_id = LOCAL_MSG_ID_BASE + index if gift.slug in self.slugs else 0
        if saved.msg_id:
            saved.flags |= FLAG_MSG_ID
            self.local_msg_ids[saved.msg_id] = gift.slug
        self.apply_meta(saved, gift.slug)
        return saved

    def make_saved_regular_gift(self, account: int, gift, index: int):
        me = TLRPC.TL_peerUser()
        me.user_id = get_user_config(account).getClientUserId()
        saved = TL_stars.TL_savedStarGift()
        saved.gift = gift
        saved.from_id = me
        saved.date = int(time.time())
        saved.saved_id = LOCAL_SAVED_ID_BASE + 100000 + index  # distinct from NFT ids
        saved.flags |= FLAG_SAVED_ID
        return saved
