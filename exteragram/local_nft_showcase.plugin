def parse_slug(text: str) -> str:
    """Accepts 'PlushPepe-1', 't.me/nft/PlushPepe-1' or 'https://t.me/nft/PlushPepe-1'."""
    text = (text or "").strip()
    if "/nft/" in text:
        text = text.split("/nft/", 1)[1]
    return text.split("?", 1)[0].strip("/ ")


def status_to_hex(status) -> str:
    data = SerializedData(status.getObjectSize())
    status.serializeToStream(data)
    return Utilities.bytesToHex(data.toByteArray())


def status_from_hex(text: str):
    data = SerializedData(Utilities.hexToBytes(text))
    return TLRPC.EmojiStatus.TLdeserialize(
        data, data.readInt32(False), False
    )


def gift_to_hex(gift) -> str:
    data = SerializedData(gift.getObjectSize())
    gift.serializeToStream(data)
    return Utilities.bytesToHex(data.toByteArray())


def gift_from_hex(text: str):
    data = SerializedData(Utilities.hexToBytes(text))
    return TL_stars.StarGift.TLdeserialize(
        data, data.readInt32(False), False
    )


def gift_from_hex_slug(text: str):
    try:
        g = gift_from_hex(text)
        return g.slug if g is not None else None
    except Exception:
        return None


def attr_name(attr) -> str:
    return getattr(attr, "name", None) or "—"


def backdrop_argb(backdrop) -> int:
    color = int(getattr(backdrop, "center_color", 0) or 0)
    return (0xFF000000 | (color & 0xFFFFFF)) - 0x100000000


def backdrop_edge_argb(backdrop) -> int:
    color = int(
        getattr(backdrop, "edge_color", 0)
        or getattr(backdrop, "center_color", 0)
        or 0
    )
    return (0xFF000000 | (color & 0xFFFFFF)) - 0x100000000


def attr_permille(attr) -> str:
    try:
        p = int(attr.getRarityPermille())
    except Exception:
        return ""
    return f"{p / 10:.1f}%" if p else ""


class PatchUserHook(MethodHook):
    """Puts local Premium and the locally worn status on our own user objects."""

    def __init__(self, plugin, arg_index):
        self.plugin = plugin
        self.arg_index = arg_index

    def before_hooked_method(self, param):
        self.plugin.patch_user(param.args[self.arg_index])


def bulletin_delegate(extra_bottom, inner=None, fragment=None):
    """Bulletin.Delegate that forwards to inner (the screen's own delegate, if any) and keeps
    bulletins at least extra_bottom px above the screen bottom (the space a floating tab bar
    takes); an offset that already clears it is left alone. Every method is written out: a
    proxy has no Java default methods to fall back on."""
    from java import dynamic_proxy
    from org.telegram.ui.Components import Bulletin

    logged = []  # log the first offset once

    class _Delegate(dynamic_proxy(Bulletin.Delegate)):
        def getBottomOffset(self, tag):
            if inner is not None:
                base = inner.getBottomOffset(tag)
            else:
                base = (
                    fragment.getBottomInset()
                    if fragment is not None
                    else 0
                )  # Telegram's default
            result = (
                base if base >= extra_bottom else base + extra_bottom
            )
            if not logged:
                logged.append(True)
                write_log(
                    f"bulletin: offset base={base} -> {result} (bar {extra_bottom})"
                )
            return result

        def bottomOffsetAnimated(self):
            return (
                inner.bottomOffsetAnimated()
                if inner is not None
                else True
            )

        def getLeftPadding(self):
            return inner.getLeftPadding() if inner is not None else 0

        def getRightPadding(self):
            return inner.getRightPadding() if inner is not None else 0

        def getTopOffset(self, tag):
            return inner.getTopOffset(tag) if inner is not None else 0

        def clipWithGradient(self, tag):
            return (
                inner.clipWithGradient(tag)
                if inner is not None
                else False
            )

        def onBottomOffsetChange(self, offset):
            if inner is not None:
                inner.onBottomOffsetChange(offset)

        def onShow(self, bulletin):
            if inner is not None:
                inner.onShow(bulletin)

        def onHide(self, bulletin):
            if inner is not None:
                inner.onHide(bulletin)

        def allowLayoutChanges(self):
            return (
                inner.allowLayoutChanges()
                if inner is not None
                else True
            )

    return _Delegate()


class ErrorGateHook(MethodHook):
    """BulletinFactory.showForError / makeForError: while one runs, the error bulletin it
    builds is marked, and BulletinShowHook keeps it off the screen."""

    def __init__(self, plugin, remember_result):
        self.plugin = plugin
        self.remember_result = remember_result

    def before_hooked_method(self, param):
        self.plugin.error_depth += 1

    def after_hooked_method(self, param):
        self.plugin.error_depth = max(0, self.plugin.error_depth - 1)
        if self.remember_result and param.getResult() is not None:
            self.plugin.muted_bulletins = (
                self.plugin.muted_bulletins + [param.getResult()]
            )[-20:]


class BulletinShowHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.get_setting("hide_errors", True):
            self.plugin.lift_profile_bulletins(param.thisObject)
            return
        bulletin = param.thisObject
        muted = (
            self.plugin.error_depth > 0
            or self.plugin.is_error_bulletin(bulletin)
        )
        for i, b in enumerate(self.plugin.muted_bulletins):
            if b.equals(bulletin):
                del self.plugin.muted_bulletins[i]
                muted = True
                break
        if muted:
            param.setResult(bulletin)
            return
        self.plugin.lift_profile_bulletins(bulletin)


class PinnedBadgeHook(MethodHook):
    """GiftSheet.GiftCell.setStarsGift: the app hides the pin badge on a pinned NFT whose
    sender name is visible, so pinned NFTs looked unpinned in the profile grid. Show it on
    every pinned gift."""

    def after_hooked_method(self, param):
        try:
            gift = param.args[0]
            if (
                gift is not None
                and gift.pinned_to_top
                and not gift.unsaved
            ):
                cell = param.thisObject
                # On a rebind the app animates the badge away (its end action hides it):
                # stop that animation first, or it removes the badge right after us.
                badge = get_private_field(cell, "pinnedView")
                if badge is not None:
                    badge.animate().cancel()
                    badge.setVisibility(0)  # View.VISIBLE
                    badge.setAlpha(1.0)
                    badge.setScaleX(1.0)
                    badge.setScaleY(1.0)
                cell.setPinned(True, False)
        except Exception:
            pass


class ReactionsMergeHook(MethodHook):
    """Puts the locally kept reactions back into reactions coming from the server:
    MessageObject.updateReactions(message, reactions) for live updates and
    MessagesStorage.updateMessageReactions(dialogId, msgId, reactions) for the cache.
    """

    def __init__(self, plugin, kind):
        self.plugin = plugin
        self.kind = kind

    def before_hooked_method(self, param):
        try:
            if not self.plugin.local_reactions(
                UserConfig.selectedAccount
            ):
                return
            args = list(param.args)
            if self.kind == "update":
                if (
                    len(args) < 2
                    or args[0] is None
                    or args[1] is None
                ):
                    return
                did = MessageObject.getDialogId(args[0])
                self.plugin.merge_local_reactions(
                    UserConfig.selectedAccount,
                    did,
                    args[0].id,
                    args[1],
                )
            else:
                if len(args) < 3 or args[2] is None:
                    return
                account = (
                    get_private_field(
                        param.thisObject, "currentAccount"
                    )
                    or UserConfig.selectedAccount
                )
                self.plugin.merge_local_reactions(
                    account, int(args[0]), int(args[1]), args[2]
                )
        except Exception:
            pass


class OwnNumberEditRowHook(MethodHook):
    """ProfileActivity.editRow(view, position): on your own profile exteraGram sends a tap
    on the number here and shows Копировать / Изменить номер. A tap opens the Fragment sheet;
    a long press (seen on the call stack) keeps the menu."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            from java.lang import Thread

            if any(
                "LongClick" in str(frame.getMethodName())
                or "LongPress" in str(frame.getMethodName())
                or "LongClick" in str(frame.getClassName())
                for frame in Thread.currentThread().getStackTrace()
            ):
                return
            write_log("editRow called")
            if self.plugin.open_own_number_sheet(
                param.thisObject, int(param.args[1])
            ):
                param.setResult(True)
        except Exception:
            write_log(
                f"editRow hook failed:\n{traceback.format_exc()}"
            )


