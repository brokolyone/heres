"""
Local NFT Showcase: shows any existing collectible gift in YOUR OWN profile,
only on your own screen. Nothing is sent to Telegram servers and nobody else
sees it: other people opening your profile see your real gifts.

Local Premium makes the app think your account has Premium, so you can wear
gifts and set emoji statuses. Those statuses are also kept only on your device.
"""

__id__ = "local_nft_showcase"
__name__ = "Local NFT Showcase"
__description__ = "Локально показывает NFT-подарки в твоём профиле, локальный премиум и ношение подарков (видишь только ты)"
__author__ = "brokolyone"
__version__ = "1.3.0"

import random
import re
import time
from collections import defaultdict, deque
from typing import Any, List

from base_plugin import BasePlugin, HookResult, HookStrategy, MethodHook
from android_utils import run_on_ui_thread
from client_utils import get_last_fragment, get_messages_controller, get_user_config, send_request
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input, Switch, Text

from android.text import InputType
from android.widget import EditText
from org.telegram.messenger import UserConfig, Utilities
from org.telegram.tgnet import SerializedData, TLRPC
from org.telegram.tgnet.tl import TL_account, TL_stars

FLAG_OWNER_ID = 1
FLAG_OWNER_NAME = 2
FLAG_OWNER_ADDRESS = 4
FLAG_STARGIFTS_COUNT = 1 << 18  # UserFull.flags2


def parse_slug(text: str) -> str:
    """Accepts 'PlushPepe-1', 't.me/nft/PlushPepe-1' or 'https://t.me/nft/PlushPepe-1'."""
    text = (text or "").strip()
    if "/nft/" in text:
        text = text.split("/nft/", 1)[1]
    return text.split("?", 1)[0].strip("/ ")


def status_to_hex(status) -> str:
    data = SerializedData(status.getObjectSize())
    status.serializeToStream(data)
    return Utilities.bytesToHex(data.toByteArray())


def status_from_hex(text: str):
    data = SerializedData(Utilities.hexToBytes(text))
    return TLRPC.EmojiStatus.TLdeserialize(data, data.readInt32(False), False)


class PatchUserHook(MethodHook):
    """Puts local Premium and the locally worn status on our own user objects."""

    def __init__(self, plugin, arg_index):
        self.plugin = plugin
        self.arg_index = arg_index

    def before_hooked_method(self, param):
        self.plugin.patch_user(param.args[self.arg_index])


class PremiumHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.get_setting("local_premium", True):
            param.setResult(True)


def slug_base(title: str) -> str:
    """'Durov's Cap' -> 'DurovsCap', the part of the slug before the number."""
    return re.sub(r"[^0-9A-Za-z]", "", title or "")


def describe_unique(gift) -> str:
    names = {}
    for attr in gift.attributes:
        if isinstance(attr, TL_stars.starGiftAttributeModel):
            names["model"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributeBackdrop):
            names["backdrop"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributePattern):
            names["pattern"] = attr.name
    parts = [names[k] for k in ("model", "backdrop", "pattern") if k in names]
    return f"#{gift.num} · " + " · ".join(parts)


def parse_slugs(text: str) -> List[str]:
    """Several links separated by commas, spaces or new lines, without duplicates."""
    slugs = []
    for part in re.split(r"[\s,;]+", text or ""):
        slug = parse_slug(part)
        if slug and slug not in slugs:
            slugs.append(slug)
    return slugs


class LocalNftShowcasePlugin(BasePlugin):
    def on_plugin_load(self):
        self.slugs = []
        self.gifts = {}
        self.generation = 0
        # Requests for gift lists are answered in order, so remember for each
        # account whether the pending ones were for our own profile.
        self.pending = defaultdict(deque)
        self.add_hook("getSavedStarGifts", match_substring=True)
        self.add_hook("TL_users_getFullUser")
        self.add_hook("updateEmojiStatus", match_substring=True)
        self.own_ids = set()
        self.statuses = {}
        self.install_java_hooks()
        self.load_gifts(self.get_setting("slug", ""))

    def install_java_hooks(self):
        # Take java.lang.Class from live objects: find_class may return a Python proxy.
        user_config = get_user_config().getClass()
        controller = get_messages_controller().getClass()
        self.hook_method(user_config.getDeclaredMethod("isPremium"), PremiumHook(self))
        self.hook_all_methods(user_config, "setCurrentUser", PatchUserHook(self, 0))
        self.hook_all_methods(controller, "putUser", PatchUserHook(self, 0))

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Локальный NFT"),
            Switch(
                key="enabled",
                text="Показывать NFT в профиле",
                default=True,
                icon="msg_gift_premium",
            ),
            Text(
                text="Выбрать NFT из списка",
                icon="msg_add",
                accent=True,
                on_click=lambda _: self.pick_collection(),
            ),
            Text(
                text="Убрать NFT",
                icon="msg_delete",
                on_click=lambda _: self.pick_to_remove(),
            ),
            Input(
                key="slug",
                text="Ссылки на NFT",
                default="",
                subtext="Через запятую: t.me/nft/PlushPepe-1, t.me/nft/DurovsCap-1",
                icon="msg_link",
                on_change=self.load_gifts,
            ),
            Switch(
                key="pinned",
                text="Закрепить у аватарки",
                default=True,
                icon="msg_pin",
            ),
            Divider(text="Подарки видны только тебе. В Telegram ничего не меняется, "
                         "другие люди в твоём профиле их не увидят. После смены "
                         "настроек переоткрой профиль."),
            Header(text="Локальный премиум"),
            Switch(
                key="local_premium",
                text="Локальный премиум",
                default=True,
                subtext="Можно носить подарки и ставить эмодзи-статус",
                icon="msg_premium_prolfilestar",
                on_change=lambda _: self.refresh_own_users(),
            ),
            Text(
                text="Снять надетый подарок/статус",
                icon="msg_delete",
                red=True,
                on_click=lambda _: self.clear_statuses(),
            ),
            Divider(text="Премиум и статус тоже видны только тебе. Функции, которые "
                         "проверяет сервер (передача и продажа подарков, большие файлы и т.п.), "
                         "работать не будут. Для применения иногда нужен перезапуск."),
        ]

    # Picker: collection -> NFT on resale, by number or a random one.

    def get_activity(self):
        fragment = get_last_fragment()
        return fragment.getParentActivity() if fragment else None

    def show_loading(self):
        activity = self.get_activity()
        if activity is None:
            return None
        dialog = AlertDialogBuilder(activity, AlertDialogBuilder.ALERT_TYPE_SPINNER)
        dialog.show()
        return dialog

    def show_items(self, title: str, items: List[str], on_pick):
        activity = self.get_activity()
        if activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(title)

        def on_click(bld, which):
            bld.dismiss()
            on_pick(which)

        builder.set_items(items, on_click)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def request_on_ui(self, req, on_result):
        """Sends a request with a loading spinner and calls on_result(response) on the UI thread."""
        loading = self.show_loading()

        def on_response(response, error):
            def finish():
                if loading:
                    loading.dismiss()
                if error or response is None:
                    BulletinHelper.show_error(f"Ошибка: {error.text if error else 'пустой ответ'}")
                    return
                on_result(response)
            run_on_ui_thread(finish)

        send_request(req, on_response)

    def pick_collection(self):
        req = TL_stars.getStarGifts()
        req.hash = 0

        def on_result(response):
            collections = [
                gift for gift in getattr(response, "gifts", [])
                if gift.availability_resale > 0 or gift.upgrade_stars > 0
            ]
            collections.sort(key=lambda gift: -gift.availability_resale)
            if not collections:
                BulletinHelper.show_error("Коллекции не найдены")
                return
            items = [f"{gift.title} ({gift.availability_resale} в продаже)" for gift in collections]
            self.show_items("Коллекция", items, lambda i: self.pick_from_collection(collections[i]))

        self.request_on_ui(req, on_result)

    def pick_from_collection(self, collection):
        req = TL_stars.getResaleStarGifts()
        req.gift_id = collection.id
        req.sort_by_price = True
        req.offset = ""
        req.limit = 50

        def on_result(response):
            uniques = [gift for gift in response.gifts if gift.slug]
            base = uniques[0].slug.rsplit("-", 1)[0] if uniques else slug_base(collection.title)
            items = ["🔢 Ввести номер"]
            if uniques:
                items.append("🎲 Случайный")
            items += [describe_unique(gift) for gift in uniques]

            def on_pick(i):
                if i == 0:
                    self.ask_number(collection.title, base)
                elif i == 1:
                    self.add_slug(random.choice(uniques).slug)
                else:
                    self.add_slug(uniques[i - 2].slug)

            self.show_items(collection.title, items, on_pick)

        self.request_on_ui(req, on_result)

    def ask_number(self, title: str, base: str):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER)
        field.setHint("Например 1")
        builder = AlertDialogBuilder(activity)
        builder.set_title(f"{title}: номер")
        builder.set_view(field)

        def on_ok(bld, _):
            number = str(field.getText()).strip()
            bld.dismiss()
            if number.isdigit():
                self.add_slug(f"{base}-{int(number)}")

        builder.set_positive_button("Добавить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def add_slug(self, slug: str):
        slugs = parse_slugs(self.get_setting("slug", ""))
        if slug not in slugs:
            slugs.append(slug)
        self.save_slugs(slugs)

    def pick_to_remove(self):
        slugs = parse_slugs(self.get_setting("slug", ""))
        if not slugs:
            BulletinHelper.show_info("Список NFT пуст")
            return

        def on_pick(i):
            self.save_slugs(slugs[:i] + slugs[i + 1:])
            BulletinHelper.show_success(f"«{slugs[i]}» убран. Переоткрой профиль")

        self.show_items("Убрать NFT", slugs, on_pick)

    def save_slugs(self, slugs: List[str]):
        text = ", ".join(slugs)
        self.set_setting("slug", text, reload_settings=True)
        self.load_gifts(text)

    def load_gifts(self, text: str):
        # Responses to an older list of links are dropped by comparing generations.
        self.generation += 1
        generation = self.generation
        self.slugs = parse_slugs(text)
        self.gifts = {}
        for slug in self.slugs:
            self.load_gift(slug, generation)

    def load_gift(self, slug: str, generation: int):
        req = TL_stars.getUniqueStarGift()
        req.slug = slug

        def on_response(response, error):
            if generation != self.generation:
                return
            if error or response is None or response.gift is None:
                text = error.text if error else "пустой ответ"
                BulletinHelper.show_error(f"NFT «{slug}» не найден: {text}")
                return
            gift = response.gift
            self.gifts[slug] = gift
            BulletinHelper.show_success(
                f"NFT «{gift.title} #{gift.num}» загружен ({len(self.gifts)}/{len(self.slugs)})"
            )

        send_request(req, on_response)

    def loaded_gifts(self) -> List[Any]:
        """Loaded gifts in the order the links were entered."""
        if not self.get_setting("enabled", True):
            return []
        return [self.gifts[slug] for slug in self.slugs if slug in self.gifts]

    def is_own_peer(self, account: int, peer) -> bool:
        if isinstance(peer, TLRPC.TL_inputPeerSelf):
            return True
        if isinstance(peer, TLRPC.TL_inputPeerUser):
            return peer.user_id == get_user_config(account).getClientUserId()
        return False

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        if isinstance(request, TL_account.updateEmojiStatus):
            return self.on_update_emoji_status(account, request)
        if "getSavedStarGifts" in request_name:
            own_first_page = (
                self.is_own_peer(account, request.peer)
                and not request.offset
                and not request.exclude_unique
                and (request.flags & 64) == 0  # not a collection
            )
            self.pending[account].append(own_first_page)
        return HookResult()

    def on_update_emoji_status(self, account: int, request) -> HookResult:
        # The app has already put the new status on our user object before sending
        # the request, so keep it locally and do not send anything to the server.
        is_local_gift = (
            isinstance(request.emoji_status, TLRPC.TL_inputEmojiStatusCollectible)
            and request.emoji_status.collectible_id in self.local_gift_ids()
        )
        if not self.get_setting("local_premium", True) and not is_local_gift:
            return HookResult()
        user = get_user_config(account).getCurrentUser()
        if user is None:
            return HookResult()
        self.save_status(user.id, user.emoji_status)
        return HookResult(strategy=HookStrategy.CANCEL)

    def post_request_hook(self, request_name: str, account: int, response: Any, error: Any) -> HookResult:
        if "getSavedStarGifts" in request_name:
            queue = self.pending[account]
            own_first_page = queue.popleft() if queue else False
            gifts = self.loaded_gifts()
            if own_first_page and not error and response is not None and gifts:
                for i, gift in enumerate(gifts):
                    response.gifts.add(i, self.make_saved_gift(account, gift))
                response.count += len(gifts)
                return HookResult(strategy=HookStrategy.MODIFY, response=response)
        elif request_name == "TL_users_getFullUser":
            gifts = self.loaded_gifts()
            if not error and response is not None and gifts:
                full = response.full_user
                if full is not None and full.id == get_user_config(account).getClientUserId():
                    full.stargifts_count += len(gifts)
                    full.flags2 |= FLAG_STARGIFTS_COUNT
                    return HookResult(strategy=HookStrategy.MODIFY, response=response)
        return HookResult()

    def get_own_ids(self):
        if not self.own_ids:
            for account in range(UserConfig.MAX_ACCOUNT_COUNT):
                user_id = get_user_config(account).getClientUserId()
                if user_id:
                    self.own_ids.add(user_id)
        return self.own_ids

    def get_status(self, user_id: int):
        if user_id not in self.statuses:
            text = self.get_setting(f"status_{user_id}", "")
            try:
                self.statuses[user_id] = status_from_hex(text) if text else None
            except Exception:
                self.logger.exception("Could not restore the worn status")
                self.statuses[user_id] = None
        return self.statuses[user_id]

    def save_status(self, user_id: int, status):
        empty = status is None or isinstance(status, TLRPC.TL_emojiStatusEmpty)
        self.statuses[user_id] = None if empty else status
        self.set_setting(f"status_{user_id}", "" if empty else status_to_hex(status))

    def patch_user(self, user):
        if user is None or user.id not in self.get_own_ids():
            return
        if self.get_setting("local_premium", True):
            user.premium = True
        status = self.get_status(user.id)
        if status is not None:
            user.emoji_status = status

    def refresh_own_users(self):
        self.own_ids = set()
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            user = get_user_config(account).getCurrentUser()
            if user is not None:
                self.patch_user(user)

    def clear_statuses(self):
        for user_id in list(self.get_own_ids()):
            self.save_status(user_id, None)
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            user = get_user_config(account).getCurrentUser()
            if user is not None:
                user.emoji_status = TLRPC.TL_emojiStatusEmpty()
        BulletinHelper.show_success("Статус снят. Переоткрой профиль")

    def local_gift_ids(self):
        return {gift.id for gift in self.gifts.values()}

    def make_saved_gift(self, account: int, gift):
        user_config = get_user_config(account)
        me = TLRPC.TL_peerUser()
        me.user_id = user_config.getClientUserId()

        gift.owner_id = me
        gift.flags = (gift.flags | FLAG_OWNER_ID) & ~(FLAG_OWNER_NAME | FLAG_OWNER_ADDRESS)
        gift.owner_name = None
        gift.owner_address = None

        saved = TL_stars.TL_savedStarGift()
        saved.gift = gift
        saved.date = int(time.time())
        saved.pinned_to_top = self.get_setting("pinned", True)
        return saved
