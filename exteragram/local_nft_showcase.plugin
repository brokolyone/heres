def parse_slug(text: str) -> str:
    """Accepts 'PlushPepe-1', 't.me/nft/PlushPepe-1' or 'https://t.me/nft/PlushPepe-1'."""
    text = (text or "").strip()
    if "/nft/" in text:
        text = text.split("/nft/", 1)[1]
    return text.split("?", 1)[0].strip("/ ")


def status_to_hex(status) -> str:
    data = SerializedData(status.getObjectSize())
    status.serializeToStream(data)
    return Utilities.bytesToHex(data.toByteArray())


def status_from_hex(text: str):
    data = SerializedData(Utilities.hexToBytes(text))
    return TLRPC.EmojiStatus.TLdeserialize(data, data.readInt32(False), False)


def gift_to_hex(gift) -> str:
    data = SerializedData(gift.getObjectSize())
    gift.serializeToStream(data)
    return Utilities.bytesToHex(data.toByteArray())


def gift_from_hex(text: str):
    data = SerializedData(Utilities.hexToBytes(text))
    return TL_stars.StarGift.TLdeserialize(data, data.readInt32(False), False)


def gift_from_hex_slug(text: str):
    try:
        g = gift_from_hex(text)
        return g.slug if g is not None else None
    except Exception:
        return None


def attr_name(attr) -> str:
    return getattr(attr, "name", None) or "—"


def backdrop_argb(backdrop) -> int:
    color = int(getattr(backdrop, "center_color", 0) or 0)
    return (0xFF000000 | (color & 0xFFFFFF)) - 0x100000000


def backdrop_edge_argb(backdrop) -> int:
    color = int(getattr(backdrop, "edge_color", 0) or getattr(backdrop, "center_color", 0) or 0)
    return (0xFF000000 | (color & 0xFFFFFF)) - 0x100000000


def attr_permille(attr) -> str:
    try:
        p = int(attr.getRarityPermille())
    except Exception:
        return ""
    return f"{p / 10:.1f}%" if p else ""


class PatchUserHook(MethodHook):
    """Puts local Premium and the locally worn status on our own user objects."""

    def __init__(self, plugin, arg_index):
        self.plugin = plugin
        self.arg_index = arg_index

    def before_hooked_method(self, param):
        self.plugin.patch_user(param.args[self.arg_index])


class PremiumHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.get_setting("local_premium", True):
            param.setResult(True)


def jlist(java_list) -> list:
    """Java ArrayList -> Python list. In this app Java lists cannot be iterated with `for`."""
    if java_list is None:
        return []
    return [java_list.get(i) for i in range(java_list.size())]


def slug_base(title: str) -> str:
    """'Durov's Cap' -> 'DurovsCap', the part of the slug before the number."""
    return re.sub(r"[^0-9A-Za-z]", "", title or "")


def describe_unique(gift) -> str:
    names = {}
    for attr in jlist(gift.attributes):
        if isinstance(attr, TL_stars.starGiftAttributeModel):
            names["model"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributeBackdrop):
            names["backdrop"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributePattern):
            names["pattern"] = attr.name
    parts = [names[k] for k in ("model", "backdrop", "pattern") if k in names]
    return f"#{gift.num} · " + " · ".join(parts)


def parse_amount(text, default: float) -> float:
    try:
        return max(0.0, float(str(text).replace(",", ".").replace(" ", "")))
    except ValueError:
        return default


def find_method(clazz, name: str, param_count: int):
    for method in clazz.getDeclaredMethods():
        if method.getName() == name and method.getParameterCount() == param_count:
            method.setAccessible(True)
            return method
    return None


class BalanceHook(MethodHook):
    """StarsController.getBalance(boolean, Runnable, boolean): every balance read goes through it."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.get_setting("local_balance", True):
            amount = self.plugin.balance_amount(param.thisObject.ton)
            # Some screens read the field directly. If it keeps the real balance they open
            # "Stars needed", and that sheet buys again on every balance change: a purchase loop.
            param.thisObject.balance = amount
            param.setResult(amount)


class StarsNeededHook(MethodHook):
    """StarsIntroActivity.StarsNeededSheet.show(): with the local balance this sheet only does harm.
    Shown with enough balance it buys again at once, and it rebuys on every balance change."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.get_setting("local_balance", True):
            param.setResult(None)


def log_path() -> str:
    from org.telegram.messenger import ApplicationLoader
    return str(ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()) + "/winft_log.txt"


def write_log(text: str):
    """Synchronous append, so the line survives even if the app dies right after."""
    try:
        path = log_path()
        with open(path, "a", encoding="utf-8") as f:
            f.write(time.strftime("%H:%M:%S ") + text + "\n")
        import os
        if os.path.getsize(path) > 96 * 1024:
            with open(path, "r", encoding="utf-8") as f:
                tail = f.read()[-48 * 1024:]
            with open(path, "w", encoding="utf-8") as f:
                f.write(tail)
    except Exception:
        pass


def layout_listener(fn):
    """View.OnLayoutChangeListener backed by a Python callable."""
    from java import dynamic_proxy
    from android.view import View

    class _Listener(dynamic_proxy(View.OnLayoutChangeListener)):
        def onLayoutChange(self, v, left, top, right, bottom, ol, ot, orr, ob):
            fn()

    return _Listener()


def java_field(obj, name):
    """Reads a field declared anywhere up obj's class chain (public or not)."""
    cls = obj.getClass()
    while cls is not None:
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            return field.get(obj)
        except Exception:
            cls = cls.getSuperclass()
    return None


def long_press_listener(on_start, on_release):
    """RecyclerListView.OnItemLongClickListenerExtended backed by Python callables."""
    from java import dynamic_proxy
    from org.telegram.ui.Components import RecyclerListView

    class _Listener(dynamic_proxy(RecyclerListView.OnItemLongClickListenerExtended)):
        def onItemClick(self, view, position, x, y):
            return bool(on_start(view, position))

        def onMove(self, dx, dy):
            pass

        def onLongClickRelease(self):
            on_release()

    return _Listener()


class MarketRedirectHook(MethodHook):
    """While the NFT constructor market is open, a tap on a gift in Telegram's market
    opens Telegram's own preview sheet (the constructor) instead of buying or resale."""

    def __init__(self, plugin, extract, name):
        self.plugin = plugin
        self.extract = extract
        self.name = name

    def before_hooked_method(self, param):
        if not self.plugin.market_active():
            return
        try:
            target = self.extract(param)
        except Exception:
            write_log(f"redirect {self.name} failed:\n{traceback.format_exc()}")
            return
        write_log(f"redirect via {self.name}: {target}")
        if target is None:
            return
        param.setResult(None)
        gift_id, title = target
        run_on_ui_thread(lambda: self.plugin.open_constructor_for(gift_id, title))


class MarketFillHook(MethodHook):
    """GiftSheet.fillItems: before the market grid is (re)built, hide resale listings
    in the very lists it reads, so only non-upgraded versions are shown."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.is_market_sheet(param.thisObject):
            self.plugin.hide_resale_now()


class SendRequestHook(MethodHook):
    """ConnectionsManager.sendRequest(...): every gift purchase ends with payments.sendStarsForm,
    whichever screen started it, so local purchases are answered here without the server."""

    def __init__(self, plugin):
        self.plugin = plugin

    # sendRequest runs for every network request, so only these requests reach Python.
    @hook_filters(HookFilter.Or(
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.TL_payments_sendStarsForm().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.updateStarGiftPrice().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_fragment.TL_getCollectibleInfo().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.saveStarGift().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TLRPC.TL_payments_getPaymentForm().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.upgradeStarGift().getClass()),
    ))
    def before_hooked_method(self, param):
        args = list(param.args)
        if not args:
            return
        delegate = next((a for a in args[1:] if a is not None and hasattr(a, "run")), None)
        account = get_private_field(param.thisObject, "currentAccount") or 0
        if isinstance(args[0], TL_stars.TL_payments_sendStarsForm):
            result = self.plugin.pay_locally(account, args[0])
        elif isinstance(args[0], TL_stars.updateStarGiftPrice):
            result = self.plugin.set_price_locally(args[0])
        elif isinstance(args[0], TL_fragment.TL_getCollectibleInfo):
            result = self.plugin.collectible_info(args[0])
        elif isinstance(args[0], TL_stars.saveStarGift):
            result = self.plugin.save_gift_locally(args[0])
        elif isinstance(args[0], TLRPC.TL_payments_getPaymentForm):
            result = self.plugin.drop_details_form(args[0])
        elif isinstance(args[0], TL_stars.upgradeStarGift):
            result = self.plugin.upgrade_gift_locally(args[0])
        else:
            return
        if result is None:
            return  # not ours: let the real request go
        param.setResult(0)
        if delegate is None:
            return
        response, error = result
        try:
            delegate.run(response, error)
        except Exception:
            delegate.run(response, error, 0)  # RequestDelegateTimestamp


def parse_usernames(text: str) -> List[str]:
    """'@durov, t.me/telegram fragment' -> ['durov', 'telegram', 'fragment']"""
    names = []
    for part in re.split(r"[\s,;]+", text or ""):
        name = part.strip().split("t.me/")[-1].lstrip("@").strip("/")
        if re.fullmatch(r"[A-Za-z0-9_]{4,32}", name) and name.lower() not in [n.lower() for n in names]:
            names.append(name)
    return names


def parse_phone(text: str) -> str:
    """'+888 0123 4567' -> '88801234567', empty when it is not a +888 number."""
    digits = re.sub(r"\D", "", text or "")
    return digits if digits.startswith("888") and len(digits) >= 7 else ""


def format_phone(digits: str) -> str:
    """'88801234567' -> '+888 0123 4567'."""
    if not digits:
        return ""
    rest = digits[3:]
    groups = [digits[:3]] + [rest[i:i + 4] for i in range(0, len(rest), 4)]
    return "+" + " ".join(groups)


def parse_prices(text: str) -> dict:
    """'durov=7000, telegram=15k, number=3000' -> {'durov': 7000.0, 'telegram': 15000.0, 'number': 3000.0}"""
    prices = {}
    for part in re.split(r"[,;\n]+", text or ""):
        if "=" not in part:
            continue
        name, value = part.split("=", 1)
        name = name.strip().lstrip("@").lower()
        value = value.strip().lower().replace(" ", "").replace(",", ".")
        scale = 1
        if value.endswith(("k", "к")):
            value, scale = value[:-1], 1000
        try:
            prices[name] = float(value) * scale
        except ValueError:
            continue
    return prices


def http_get(url: str) -> str:
    """Through Java: the app's Python may lack CA certificates for urllib."""
    connection = URL(url).openConnection()
    connection.setConnectTimeout(10000)
    connection.setReadTimeout(10000)
    reader = BufferedReader(InputStreamReader(connection.getInputStream()))
    lines = []
    while True:
        line = reader.readLine()
        if line is None:
            break
        lines.append(line)
    reader.close()
    return "\n".join(lines)


def parse_slugs(text: str) -> List[str]:
    """Several links separated by commas, spaces or new lines, without duplicates."""
    slugs = []
    for part in re.split(r"[\s,;]+", text or ""):
        slug = parse_slug(part)
        if slug and slug not in slugs:
            slugs.append(slug)
    return slugs


class LocalNftShowcasePlugin(BasePlugin):
    def install_crash_handler(self):
        """Write Java crashes to the winft log before Telegram goes down."""
        from java import dynamic_proxy
        from java.lang import Thread
        from android.util import Log
        previous = Thread.getDefaultUncaughtExceptionHandler()

        class Handler(dynamic_proxy(Thread.UncaughtExceptionHandler)):
            def uncaughtException(self, thread, error):
                try:
                    write_log(f"CRASH in {thread.getName()}:\n{Log.getStackTraceString(error)}")
                except Exception:
                    pass
                if previous is not None:
                    previous.uncaughtException(thread, error)

        self.crash_previous = previous
        self.crash_handler = Handler()
        Thread.setDefaultUncaughtExceptionHandler(self.crash_handler)

    def on_plugin_unload(self):
        try:
            from java.lang import Thread
            if getattr(self, "crash_handler", None) is not None:
                Thread.setDefaultUncaughtExceptionHandler(self.crash_previous)
        except Exception:
            pass
        self.restore_resale()

    def show_log(self):
        activity = self.get_activity()
        if activity is None:
            return
        try:
            with open(log_path(), "r", encoding="utf-8") as f:
                text = f.read()
        except Exception:
            text = ""
        text = text[-6000:] or "Лог пуст"
        builder = AlertDialogBuilder(activity)
        builder.set_title("Лог winft")
        builder.set_message(text)
        builder.set_positive_button("Скопировать", lambda bld, _: (copy_to_clipboard(text), bld.dismiss()))
        builder.set_neutral_button("Очистить", lambda bld, _: (self.clear_log(), bld.dismiss()))
        builder.set_negative_button("Закрыть", lambda bld, _: bld.dismiss())
        builder.show()

    def clear_log(self):
        try:
            open(log_path(), "w").close()
        except Exception:
            pass

    def on_plugin_load(self):
        try:
            self.install_crash_handler()
        except Exception:
            write_log(f"crash handler failed:\n{traceback.format_exc()}")
        write_log(f"plugin loaded {__version__}")
        self.slugs = []
        self.gifts = {}
        self.custom = {}  # synthetic slug -> locally built TL_starGiftUnique
        self.ctor = None  # constructor state
        self.generation = 0
        # Requests for gift lists are answered in order, so remember for each
        # account whether the pending ones were for our own profile.
        self.pending = defaultdict(deque)
        self.add_hook("getSavedStarGifts", match_substring=True)
        self.add_hook("TL_users_getFullUser")
        self.add_hook("updateEmojiStatus", match_substring=True)
        self.add_hook("getPaymentForm", match_substring=True)
        self.add_hook("getStarsStatus", match_substring=True)
        self.add_hook("getStarsTransactions", match_substring=True)
        self.add_hook("toggleStarGiftsPinnedToTop", match_substring=True)
        self.tx_pending = defaultdict(deque)
        self.form_prices = {}  # payment form id -> price (stars, or nanoTON)
        self.balance_cache = {}
        self.rates_loading = False
        self.last_purchase = None  # (slug or gift id, time)
        self.local_msg_ids = {}  # fake SavedStarGift.msg_id -> slug
        self.local_regular_msg = {}  # fake msg_id -> catalog gift id (for local upgrade)
        self.announce = {}  # slug or gift id -> account: post a card in Saved Messages once loaded
        self.own_ids = set()
        self.added_usernames = set()
        self.real_username = {}  # user id -> real main username, to restore it later
        self.real_phones = {}  # user id -> real phone, to restore when the +888 number is cleared
        self.statuses = {}
        self.catalog = {}  # gift id -> regular gift from the gift catalog
        self.install_java_hooks()
        self.load_gifts(self.get_setting("slug", ""))
        self.load_custom_gifts()
        self.migrate_fragment_settings()
        self.load_catalog()

    def install_java_hooks(self):
        # Take java.lang.Class from live objects: find_class may return a Python proxy.
        user_config = get_user_config().getClass()
        controller = get_messages_controller().getClass()
        self.hook_method(user_config.getDeclaredMethod("isPremium"), PremiumHook(self))
        self.hook_all_methods(user_config, "setCurrentUser", PatchUserHook(self, 0))
        self.hook_all_methods(controller, "putUser", PatchUserHook(self, 0))
        stars = StarsController.getInstance(0).getClass()
        method = find_method(stars, "getBalance", 3)
        if method is None:
            self.logger.error("StarsController.getBalance not found, local balance is off")
        else:
            self.hook_method(method, BalanceHook(self))
        try:
            loader = stars.getClassLoader()
            sheet = loader.loadClass("org.telegram.ui.Stars.StarsIntroActivity$StarsNeededSheet")
            self.hook_method(find_method(sheet, "show", 0), StarsNeededHook(self))
        except Exception:
            self.logger.exception("StarsNeededSheet not found, purchases may repeat")
        try:
            self.install_market_hooks(stars.getClassLoader())
        except Exception:
            self.logger.exception("NFT constructor market hooks failed")
        connections = get_private_field(get_messages_controller(), "connectionsManager")
        connections_class = (connections or ConnectionsManager.getInstance(0)).getClass()
        if not self.hook_all_methods(connections_class, "sendRequest", SendRequestHook(self)):
            self.logger.error("ConnectionsManager.sendRequest not found, local purchases are off")

    def install_market_hooks(self, loader):
        def cls(name):
            try:
                return loader.loadClass(name)
            except Exception:
                self.logger.error(f"{name} not found")
                return None

        def by_gift(gift):
            return (gift.id, gift.title) if gift is not None and getattr(gift, "title", None) else None

        send = cls("org.telegram.ui.Gifts.SendGiftSheet")
        if send is not None:
            method = find_method(send, "show", 0)
            if method is not None:
                self.hook_method(method, MarketRedirectHook(
                    self, lambda p: by_gift(get_private_field(p.thisObject, "starGift")), "SendGiftSheet.show"))

        resale = cls("org.telegram.ui.Gifts.ResaleGiftsFragment")
        fragment = cls("org.telegram.ui.ActionBar.BaseFragment")
        if resale is not None and fragment is not None:
            method = find_method(fragment, "showAsSheet", 2)
            if method is not None:
                self.hook_method(method, MarketRedirectHook(
                    self, lambda p: (get_private_field(p.args[0], "gift_id"),
                                     get_private_field(p.args[0], "gift_name"))
                    if p.args[0] is not None and resale.isInstance(p.args[0]) else None, "showAsSheet"))

        intro = cls("org.telegram.ui.Stars.StarsIntroActivity")
        if intro is not None:
            method = find_method(intro, "showSoldOutGiftSheet", 4)
            if method is not None:
                self.hook_method(method, MarketRedirectHook(self, lambda p: by_gift(p.args[2]), "soldOut"))

        auction = cls("org.telegram.ui.Gifts.AuctionJoinSheet")
        if auction is not None:
            method = find_method(auction, "show", 6)
            if method is not None:
                self.hook_method(method, MarketRedirectHook(
                    self, lambda p: (int(p.args[4]), self.catalog_title(int(p.args[4]))), "auction"))

        gift_sheet = cls("org.telegram.ui.Gifts.GiftSheet")
        if gift_sheet is not None:
            method = find_method(gift_sheet, "fillItems", 2)
            if method is not None:
                self.hook_method(method, MarketFillHook(self))
        write_log("market hooks installed")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Локальный NFT"),
            Switch(
                key="enabled",
                text="Показывать NFT в профиле",
                default=True,
                icon="msg_gift_premium",
            ),
            Text(
                text="NFT конструктор",
                subtext="Тап по подарку: конструктор. Зажми на 5 сек: добавить неулучшенный",
                icon="msg_colors",
                accent=True,
                on_click=lambda _: self.open_nft_market(),
            ),
            Text(
                text="Убрать NFT",
                icon="msg_delete",
                on_click=lambda _: self.pick_to_remove(),
            ),
            Input(
                key="slug",
                text="Ссылки на NFT",
                default="",
                subtext="Через запятую: t.me/nft/PlushPepe-1, t.me/nft/DurovsCap-1",
                icon="msg_link",
                on_change=self.load_gifts,
            ),
            Switch(
                key="pinned",
                text="Закрепить у аватарки",
                default=True,
                icon="msg_pin",
            ),
            Divider(text="Подарки видны только тебе. В Telegram ничего не меняется, "
                         "другие люди в твоём профиле их не увидят. После смены "
                         "настроек переоткрой профиль."),
            Header(text="Локальный баланс"),
            Switch(
                key="local_balance",
                text="Локальный баланс",
                default=True,
                subtext="Свой баланс звёзд и TON, покупка NFT на маркете себе",
                icon="msg_stars",
            ),
            Input(
                key="stars_balance",
                text="Звёзды",
                default="100000",
                icon="msg_stars",
                on_change=lambda _: self.notify_balance(),
            ),
            Input(
                key="ton_balance",
                text="TON",
                default="1000",
                icon="msg_ton",
                on_change=lambda _: self.notify_balance(),
            ),
            Switch(
                key="spend_balance",
                text="Списывать при покупке",
                default=True,
                subtext="Выключи, чтобы баланс не уменьшался",
                icon="msg_payment_card",
            ),
            Text(
                text="Убрать купленные обычные подарки",
                icon="msg_delete",
                on_click=lambda _: self.clear_regular_gifts(),
            ),
            Divider(text="Купленные себе подарки (обычные и NFT с маркета) добавляются "
                         "в твой локальный список. Купить в подарок другому человеку "
                         "локально нельзя: такая покупка идёт как обычно, с настоящими звёздами."),
            Header(text="Fragment"),
            Text(
                text="Мои юзернеймы",
                subtext=self.usernames_subtext(),
                icon="msg_mention",
                on_click=lambda _: self.manage_usernames(),
            ),
            Text(
                text="Анонимный номер +888",
                subtext=self.number_subtext(),
                icon="msg_calls",
                on_click=lambda _: self.manage_number(),
            ),
            Selector(
                key="fiat_currency",
                text="Эквивалент в",
                default=0,
                items=["Доллары ($)", "Евро (€)", "Рубли (₽)"],
                icon="msg_currency",
            ),
            Divider(text="Юзернеймы и номер показываются только у тебя в профиле. "
                         "Нажми на юзернейм или номер: покажется цена покупки и её "
                         "эквивалент по текущему курсу GRAM. "
                         "Входить и звонить всё так же по настоящему номеру. "
                         "После смены переоткрой профиль."),
            Header(text="Локальный премиум"),
            Switch(
                key="local_premium",
                text="Локальный премиум",
                default=True,
                subtext="Можно носить подарки и ставить эмодзи-статус",
                icon="msg_premium_prolfilestar",
                on_change=lambda _: self.refresh_own_users(),
            ),
            Text(
                text="Снять надетый подарок/статус",
                icon="msg_delete",
                red=True,
                on_click=lambda _: self.clear_statuses(),
            ),
            Text(
                text="Лог winft",
                subtext="Для отладки: что случилось при вылете",
                icon="msg_log",
                on_click=lambda _: self.show_log(),
            ),
            Divider(text="Премиум и статус тоже видны только тебе. Функции, которые "
                         "проверяет сервер (передача и продажа подарков, большие файлы и т.п.), "
                         "работать не будут. Для применения иногда нужен перезапуск."),
        ]

    # Local balance and local purchases on the gift marketplace.

    def balance_amount(self, ton: bool):
        # Balance views compare the object they got last time, and a new object on every
        # read replays the star effect each frame. Hand out the same object until it changes.
        if ton:
            value = int(parse_amount(self.get_setting("ton_balance", "1000"), 0) * NANO)
        else:
            value = int(parse_amount(self.get_setting("stars_balance", "100000"), 0))
        cached = self.balance_cache.get(ton)
        if cached is None or cached.amount != value:
            cached = TL_stars.TL_starsTonAmount() if ton else TL_stars.StarsAmount.ofStars(0)
            cached.amount = value
            self.balance_cache[ton] = cached
        return cached

    def notify_balance(self):
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            if get_user_config(account).isClientActivated():
                try:
                    NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.starBalanceUpdated)
                except Exception:
                    self.logger.exception("Could not refresh the balance on screen")

    def regular_gift_ids(self) -> List[int]:
        text = self.get_setting("regular_gifts", "")
        return [int(x) for x in text.split(",") if x.strip().isdigit()]

    def load_catalog(self):
        if not self.regular_gift_ids():
            return
        req = TL_stars.getStarGifts()
        req.hash = 0

        def on_response(response, error):
            for gift in jlist(getattr(response, "gifts", None)):
                self.catalog[gift.id] = gift
            for gift_id in [k for k in self.announce if isinstance(k, int) and k in self.catalog]:
                self.post_saved_card(self.announce.pop(gift_id), self.catalog[gift_id], unique=False)

        send_request(req, on_response)

    def loaded_regular_gifts(self) -> List[Any]:
        if not self.get_setting("enabled", True):
            return []
        return [self.catalog[gift_id] for gift_id in self.regular_gift_ids() if gift_id in self.catalog]

    def clear_regular_gifts(self):
        self.set_setting("regular_gifts", "")
        BulletinHelper.show_success("Обычные подарки убраны. Переоткрой профиль")

    def spend(self, ton: bool, price: int) -> bool:
        """Takes price (stars, or nanoTON for TON) from the local balance. False if it is too low."""
        if not self.get_setting("spend_balance", True):
            return True
        key, default, scale = ("ton_balance", "1000", NANO) if ton else ("stars_balance", "100000", 1)
        balance = parse_amount(self.get_setting(key, default), 0) * scale
        if balance < price:
            BulletinHelper.show_error("Не хватает локального баланса. Пополни его в настройках плагина")
            return False
        left = balance - price
        self.set_setting(key, f"{left / NANO:.2f}" if ton else str(int(left)))
        self.notify_balance()
        return True

    def pay_locally(self, account: int, request):
        """Returns (response, error) for a purchase made locally, or None to send it for real."""
        invoice = request.invoice
        # Removing a caption works for local gifts even when the local balance is off.
        if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftDropOriginalDetails):
            return self.drop_caption_locally(invoice)
        if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftUpgrade):
            gift_id = self.regular_gift_id_from_input(invoice.stargift)
            if gift_id is None:
                return None
            self.do_local_upgrade(gift_id)
            updates = TLRPC.TL_updates()
            updates.date = int(time.time())
            response = TLRPC.TL_payments_paymentResult()
            response.updates = updates
            return response, None
        if not self.get_setting("local_balance", True):
            return None
        if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftResale):
            buyer, ton = invoice.to_id, invoice.ton
        elif isinstance(invoice, TLRPC.TL_inputInvoiceStarGift):
            buyer, ton = invoice.peer, False
        else:
            return None
        if not self.is_own_peer(account, buyer):
            return None  # gifts for other people are never faked

        # A second purchase of the same thing right away is a loop in the app, not the user.
        key = invoice.slug if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftResale) else invoice.gift_id
        now = time.time()
        if self.last_purchase and self.last_purchase[0] == key and now - self.last_purchase[1] < 3:
            self.logger.warning(f"Repeated purchase of {key} blocked")
            error = TLRPC.TL_error()
            error.code = 400
            error.text = "LOCAL_REPEATED_PURCHASE"
            return None, error
        self.last_purchase = (key, now)

        price = self.form_prices.get(request.form_id, 0)
        if not self.spend(ton, price):
            error = TLRPC.TL_error()
            error.code = 400
            error.text = "LOCAL_BALANCE_TOO_LOW"
            return None, error

        if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftResale):
            self.forget_listing(invoice.slug)
            self.announce[invoice.slug] = (account, price, ton)
            self.capture_caption(invoice.slug, getattr(invoice, "message", None), not getattr(invoice, "show_name", True))
            self.record_purchase(price, ton, slug=invoice.slug)
            self.add_slug(invoice.slug)
            run_on_ui_thread(lambda: self.open_saved_messages(account, f"NFT «{invoice.slug}» куплен"), 1000)
        else:
            ids = self.regular_gift_ids()
            ids.insert(0, invoice.gift_id)
            self.set_setting("regular_gifts", ",".join(str(i) for i in ids))
            self.record_purchase(price, ton, gift_id=invoice.gift_id)
            if invoice.gift_id in self.catalog:
                self.post_saved_card((account, price, ton), self.catalog[invoice.gift_id], unique=False)
            else:
                self.announce[invoice.gift_id] = (account, price, ton)
                self.load_catalog()
            run_on_ui_thread(lambda: self.open_saved_messages(account, "Подарок куплен"), 1000)

        updates = TLRPC.TL_updates()
        updates.date = int(time.time())
        response = TLRPC.TL_payments_paymentResult()
        response.updates = updates
        return response, None

    # Local transaction history, shown on the Stars and GRAM balance screens.

    def get_transactions(self) -> list:
        try:
            return json.loads(self.get_setting("transactions_json", "") or "[]")
        except ValueError:
            return []

    def record_purchase(self, price, ton: bool, slug=None, gift_id=None):
        txs = self.get_transactions()
        txs.insert(0, {
            "id": f"local{int(time.time() * 1000)}",
            "price": int(price),
            "ton": bool(ton),
            "date": int(time.time()),
            "slug": slug,
            "gift_id": gift_id,
        })
        self.set_setting("transactions_json", json.dumps(txs[:100]))

    def build_transaction(self, rec, account):
        t = TL_stars.TL_starsTransaction()
        t.id = rec["id"]
        t.date = int(rec["date"])
        if rec.get("ton"):
            amount = TL_stars.TL_starsTonAmount()
            amount.amount = -int(rec["price"])
        else:
            amount = TL_stars.StarsAmount.ofStars(-int(rec["price"]))
        t.amount = amount
        # Pay as yourself, like a real gift purchase, not "Вывод через Fragment".
        me = TLRPC.TL_peerUser()
        me.user_id = get_user_config(account).getClientUserId()
        peer = TL_stars.TL_starsTransactionPeer()
        peer.peer = me
        t.peer = peer
        gift = None
        if rec.get("slug"):
            gift = self.gifts.get(rec["slug"])
        elif rec.get("gift_id"):
            gift = self.catalog.get(rec["gift_id"])
        if gift is not None:
            t.stargift = gift
            t.stargift_resale = True  # renders as "Покупка подарка" with the gift sticker
        else:
            t.title = "Покупка подарка"
        return t

    def transactions_for(self, ton: bool, inbound: bool, outbound: bool, account: int) -> list:
        if inbound:
            return []  # our local transactions are all outgoing (purchases)
        recs = [r for r in self.get_transactions() if bool(r.get("ton")) == ton]
        return [self.build_transaction(r, account) for r in recs]

    # Per-gift extras (caption, hidden-from-profile): local, server never sees them.

    def get_meta(self) -> dict:
        try:
            return json.loads(self.get_setting("gift_meta", "") or "{}")
        except ValueError:
            return {}

    def gift_meta(self, slug: str) -> dict:
        return self.get_meta().get(slug, {})

    def update_meta(self, slug: str, **changes):
        meta = self.get_meta()
        entry = meta.get(slug, {})
        entry.update(changes)
        meta[slug] = entry
        self.set_setting("gift_meta", json.dumps(meta))

    def capture_caption(self, slug: str, message, name_hidden: bool):
        text = getattr(message, "text", None) if message is not None else None
        if text:
            self.update_meta(slug, text=text, name_hidden=bool(name_hidden))

    def apply_meta(self, saved, slug: str):
        meta = self.gift_meta(slug)
        if meta.get("text"):
            tw = TLRPC.TL_textWithEntities()
            tw.text = meta["text"]
            tw.entities = ArrayList()
            saved.message = tw
            saved.flags |= FLAG_MESSAGE
        if meta.get("name_hidden"):
            saved.name_hidden = True
            saved.flags |= FLAG_NAME_HIDDEN
        if meta.get("hidden"):
            saved.unsaved = True
            saved.flags |= FLAG_UNSAVED

    def save_gift_locally(self, request):
        slug = self.input_to_slug(request.stargift)
        if slug is None:
            return None  # a real gift: let the server handle it
        self.update_meta(slug, hidden=bool(request.unsave))
        text = "Подарок скрыт из профиля" if request.unsave else "Подарок виден в профиле"
        run_on_ui_thread(lambda: BulletinHelper.show_success(text + " (локально). Переоткрой профиль"))
        return TLRPC.TL_boolTrue(), None

    def drop_details_form(self, request):
        """getPaymentForm for removing a local gift caption: the server has no such gift,
        so hand back a free form and let the flow continue to sendStarsForm."""
        invoice = request.invoice
        if isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftDropOriginalDetails):
            if self.input_to_slug(invoice.stargift) is None:
                return None
        elif isinstance(invoice, TLRPC.TL_inputInvoiceStarGiftUpgrade):
            if self.regular_gift_id_from_input(invoice.stargift) is None:
                return None
        else:
            return None
        form = TLRPC.TL_payments_paymentFormStarGift()
        form.form_id = int(time.time() * 1000)
        form.invoice = TLRPC.TL_invoice()
        form.invoice.prices = ArrayList()  # free, no stars needed
        return form, None

    def drop_caption_locally(self, invoice):
        slug = self.input_to_slug(invoice.stargift)
        if slug is None:
            return None
        self.update_meta(slug, text="", name_hidden=False, drop_details=True)
        gift = self.gifts.get(slug)
        if gift is not None:
            self.strip_original_details(gift)
        run_on_ui_thread(lambda: BulletinHelper.show_success("Подпись убрана (локально). Переоткрой профиль"))
        updates = TLRPC.TL_updates()
        updates.date = int(time.time())
        response = TLRPC.TL_payments_paymentResult()
        response.updates = updates
        return response, None

    def strip_original_details(self, gift):
        attrs = gift.attributes
        if attrs is None:
            return
        for i in reversed(range(attrs.size())):
            if isinstance(attrs.get(i), TL_stars.starGiftAttributeOriginalDetails):
                attrs.remove(jint(i))

    # Per-gift pinned state: what the user pins by hand, not forced by the global toggle.

    def get_pinned_map(self) -> dict:
        try:
            return json.loads(self.get_setting("pinned_slugs", "") or "{}")
        except ValueError:
            return {}

    def input_to_slug(self, entry):
        if isinstance(entry, TL_stars.TL_inputSavedStarGiftSlug):
            return entry.slug if entry.slug in self.slugs else None
        if isinstance(entry, TL_stars.TL_inputSavedStarGiftUser):
            return self.local_msg_ids.get(entry.msg_id)
        return None

    def on_toggle_pinned(self, account: int, request) -> HookResult:
        if not self.is_own_peer(account, getattr(request, "peer", None)):
            return HookResult()
        lst = request.stargift
        pinned, keep = set(), []
        for i in range(lst.size()):
            entry = lst.get(i)
            slug = self.input_to_slug(entry)
            if slug:
                pinned.add(slug)
            else:
                keep.append(entry)
        if len(keep) == lst.size():
            return HookResult()  # no local gifts in this request
        pmap = self.get_pinned_map()
        for slug in self.slugs:
            pmap[slug] = slug in pinned
        self.set_setting("pinned_slugs", json.dumps(pmap))
        new_list = ArrayList()
        for entry in keep:
            new_list.add(entry)
        if new_list.size() == 0:
            return HookResult(strategy=HookStrategy.CANCEL)
        request.stargift = new_list
        return HookResult(strategy=HookStrategy.MODIFY, request=request)

    # Local listings on the marketplace: prices are kept per slug in the "listings" setting.

    def listings(self) -> dict:
        try:
            return json.loads(self.get_setting("listings", "") or "{}")
        except ValueError:
            return {}

    def forget_listing(self, slug: str):
        listings = self.listings()
        if listings.pop(slug, None) is not None:
            self.set_setting("listings", json.dumps(listings))

    def apply_listing(self, gift):
        """A bought gift arrives with the seller's price: show only our own local listing."""
        listing = self.listings().get(gift.slug)
        if not listing:
            gift.resell_amount = None
            gift.flags &= ~FLAG_RESELL_AMOUNT
            gift.resale_ton_only = False
            return
        gift.resell_amount = ArrayList()
        stars = TL_stars.StarsAmount.ofStars(int(listing["stars"]))
        ton = TL_stars.TL_starsTonAmount()
        ton.amount = int(listing["ton"])
        gift.resell_amount.add(stars)
        gift.resell_amount.add(ton)
        gift.resale_ton_only = bool(listing["ton_only"])
        gift.flags |= FLAG_RESELL_AMOUNT

    def local_gift_for(self, stargift):
        """The local gift an InputSavedStarGift points to, or None."""
        if isinstance(stargift, TL_stars.TL_inputSavedStarGiftSlug):
            return next((g for g in self.gifts.values() if g.slug == stargift.slug), None)
        if isinstance(stargift, TL_stars.TL_inputSavedStarGiftUser):
            slug = self.local_msg_ids.get(stargift.msg_id)
            return self.gifts.get(slug) if slug else None
        return None

    def set_price_locally(self, request):
        gift = self.local_gift_for(request.stargift)
        if gift is None:
            return None  # a real gift: let the server handle it
        listings = self.listings()
        amount = request.resell_amount
        if amount is None or (amount.amount == 0 and amount.nanos == 0):
            listings.pop(gift.slug, None)
            BulletinHelper.show_success("Снято с продажи (локально)")
        else:
            is_ton = isinstance(amount, TL_stars.TL_starsTonAmount)
            # The app shows both prices; keep the other currency at the same value as Telegram does.
            stars = amount.amount if not is_ton else 0
            ton = amount.amount if is_ton else 0
            listings[gift.slug] = {"stars": stars, "ton": ton, "ton_only": is_ton}
            BulletinHelper.show_success("Выставлено на продажу (локально)")
        self.set_setting("listings", json.dumps(listings))
        updates = TLRPC.TL_updates()
        updates.date = int(time.time())
        return updates, None

    # Fragment data model: usernames as a JSON list of {name, price}, the +888
    # number and its price, each managed from the settings UI.

    def get_usernames(self) -> list:
        try:
            data = json.loads(self.get_setting("usernames_json", "") or "[]")
        except ValueError:
            data = []
        return [d for d in data if isinstance(d, dict) and d.get("name")]

    def save_usernames(self, items: list):
        self.set_setting("usernames_json", json.dumps(items))
        self.refresh_own_users()

    def username_names(self) -> List[str]:
        return [d["name"] for d in self.get_usernames()]

    def price_of(self, name: str) -> float:
        for d in self.get_usernames():
            if d["name"].lower() == name.lower():
                return float(d.get("price") or DEFAULT_PRICE)
        return float(DEFAULT_PRICE)

    def number_price(self) -> float:
        try:
            return float(self.get_setting("number_price", "") or DEFAULT_PRICE)
        except ValueError:
            return float(DEFAULT_PRICE)

    def migrate_fragment_settings(self):
        if self.get_setting("usernames_json", None) is not None:
            return  # already on the new model
        old = parse_usernames(self.get_setting("fragment_usernames", ""))
        if not old:
            return
        prices = parse_prices(self.get_setting("fragment_prices", ""))
        items = [{"name": n, "price": prices.get(n.lower(), DEFAULT_PRICE)} for n in old]
        self.set_setting("usernames_json", json.dumps(items))
        if "number" in prices:
            self.set_setting("number_price", str(prices["number"]))

    # Subtitles shown on the two entry rows.

    def usernames_subtext(self) -> str:
        items = self.get_usernames()
        if not items:
            return "Нет. Нажми, чтобы добавить"
        primary = (self.get_setting("primary_username", "") or "").lower()
        names = ["@" + d["name"] + (" ⭐" if d["name"].lower() == primary else "") for d in items]
        return ", ".join(names)

    def number_subtext(self) -> str:
        number = parse_phone(self.get_setting("anon_number", ""))
        return format_phone(number) if number else "Не задан. Нажми, чтобы задать"

    # Management screens, built from AlertDialogs so they refresh after every change.

    def price_label(self, gram: float) -> str:
        fiat = FIAT[self.get_setting("fiat_currency", 0)]
        symbol = {"USD": "$", "EUR": "€", "RUB": "₽"}[fiat]
        fiat_value = gram * self.ton_rate(fiat)
        return f"{int(gram)} GRAM (~{symbol}{fiat_value:,.0f})"

    def manage_usernames(self):
        try:
            self.fragment_usernames_sheet()
            return
        except Exception:
            self.logger.exception("Fragment username sheet failed, using dialogs")
        self.manage_usernames_dialog()

    def manage_number(self):
        try:
            self.fragment_number_sheet()
            return
        except Exception:
            self.logger.exception("Fragment number sheet failed, using dialogs")
        self.manage_number_dialog()

    # ----- Fragment-styled screens (custom views) — VARIANT A -----

    # ===== Fragment-styled screens — VARIANT A (marketplace cards) =====
    #
    # Drop-in replacements for the plugin's view-layer methods. Logic/data methods
    # (get_usernames, price_of, username_actions, ...) are reused, never redefined.

    # extra palette (signed 32-bit ints)
    FGA_TABLE = _argb(0xFF212A33)
    FGA_GREEN = _argb(0xFF5AEC8C)
    FGA_GREEN_BG = _argb(0x1A5AEC8C)      # ~10% green
    FGA_ACCENT_BG = _argb(0x1A4DB2FF)     # ~10% accent
    FGA_SUB2 = _argb(0xFF8C9AA9)

    def dp(self, value):
        return AndroidUtilities.dp(value)

    def fg_text(self, activity, text, size, color, bold=False):
        view = TextView(activity)
        view.setText(text)
        view.setTextColor(color)
        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, float(size))
        if bold:
            view.setTypeface(Typeface.DEFAULT_BOLD)
        return view

    def fg_card(self, activity, radius=12):
        bg = GradientDrawable()
        bg.setColor(FG_CARD)
        bg.setCornerRadius(float(self.dp(radius)))
        view = LinearLayout(activity)
        view.setOrientation(LinearLayout.VERTICAL)
        view.setBackground(bg)
        view.setPadding(self.dp(14), self.dp(13), self.dp(14), self.dp(13))
        return view

    def fg_root(self, activity, title, subtitle=None):
        scroll = ScrollView(activity)
        scroll.setBackgroundColor(FG_BG)
        column = LinearLayout(activity)
        column.setOrientation(LinearLayout.VERTICAL)
        column.setPadding(self.dp(16), self.dp(22), self.dp(16), self.dp(22))
        scroll.addView(column)
        gem = self.fg_text(activity, "❖", 40, FG_ACCENT, bold=True)
        gem.setGravity(Gravity.CENTER)
        column.addView(gem)
        head = self.fg_text(activity, title, 23, FG_TEXT, bold=True)
        head.setGravity(Gravity.CENTER)
        head.setPadding(0, self.dp(10), 0, 0)
        column.addView(head)
        sub = self.fg_text(activity, subtitle or "fragment.com", 13, self.FGA_SUB2)
        sub.setGravity(Gravity.CENTER)
        sub.setPadding(0, self.dp(3), 0, self.dp(18))
        column.addView(sub)
        return scroll, column

    def fg_show(self, activity, root):
        builder = BottomSheet.Builder(activity, False)
        builder.setApplyBottomPadding(False)
        builder.setApplyTopPadding(False)
        builder.setCustomView(root)
        sheet = builder.show()
        try:
            sheet.setBackgroundColor(FG_BG)
        except Exception:
            pass
        return sheet

    def fg_button(self, activity, text, on_click, color=FG_BTN):
        bg = GradientDrawable()
        bg.setColor(color)
        bg.setCornerRadius(float(self.dp(10)))
        button = self.fg_text(activity, text, 15, FG_TEXT, bold=True)
        button.setGravity(Gravity.CENTER)
        button.setBackground(bg)
        button.setPadding(0, self.dp(15), 0, self.dp(15))
        button.setOnClickListener(OnClickListener(lambda v: on_click()))
        return button

    # ----- Variant A helpers -----

    def fgA_section(self, activity, column, text):
        label = self.fg_text(activity, text, 13, self.FGA_SUB2, bold=True)
        label.setAllCaps(True)
        label.setPadding(self.dp(4), self.dp(18), self.dp(4), self.dp(9))
        column.addView(label)

    def fgA_avatar(self, activity, letter):
        bg = GradientDrawable()
        bg.setShape(GradientDrawable.OVAL)
        bg.setColor(self.FGA_ACCENT_BG)
        view = self.fg_text(activity, (letter or "?")[:1].upper(), 18, FG_ACCENT, bold=True)
        view.setGravity(Gravity.CENTER)
        view.setBackground(bg)
        size = self.dp(42)
        params = LinearLayout.LayoutParams(size, size)
        params.rightMargin = self.dp(13)
        view.setLayoutParams(params)
        return view

    def fgA_chip(self, activity, text, color, bg_color):
        bg = GradientDrawable()
        bg.setColor(bg_color)
        bg.setCornerRadius(float(self.dp(8)))
        chip = self.fg_text(activity, text, 11, color, bold=True)
        chip.setBackground(bg)
        chip.setPadding(self.dp(8), self.dp(3), self.dp(8), self.dp(3))
        return chip

    def fgA_price_cell(self, activity, gram):
        box = LinearLayout(activity)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setGravity(Gravity.END)
        top = self.fg_text(activity, "♦ " + str(int(gram)), 16, FG_ACCENT, bold=True)
        top.setGravity(Gravity.END)
        box.addView(top)
        label = self.price_label(gram)
        fiat = label.split("(~", 1)[1].rstrip(")") if "(~" in label else ""
        if fiat:
            sub = self.fg_text(activity, "≈ " + fiat, 12, self.FGA_SUB2)
            sub.setGravity(Gravity.END)
            sub.setPadding(0, self.dp(2), 0, 0)
            box.addView(sub)
        return box

    def fgA_card_row(self, activity, column, letter, title, chip, gram, on_click):
        card = self.fg_card(activity)
        card.setOrientation(LinearLayout.HORIZONTAL)
        card.setGravity(Gravity.CENTER_VERTICAL)
        card.addView(self.fgA_avatar(activity, letter))

        middle = LinearLayout(activity)
        middle.setOrientation(LinearLayout.VERTICAL)
        title_row = LinearLayout(activity)
        title_row.setOrientation(LinearLayout.HORIZONTAL)
        title_row.setGravity(Gravity.CENTER_VERTICAL)
        title_row.addView(self.fg_text(activity, title, 17, FG_TEXT, bold=True))
        if chip is not None:
            params = LinearLayout.LayoutParams(-2, -2)
            params.leftMargin = self.dp(8)
            chip.setLayoutParams(params)
            title_row.addView(chip)
        middle.addView(title_row)
        middle.addView(self.fgA_chip_hint(activity))
        middle_params = LinearLayout.LayoutParams(0, -2, 1.0)
        middle.setLayoutParams(middle_params)
        card.addView(middle)

        if gram is not None:
            card.addView(self.fgA_price_cell(activity, gram))

        if on_click is not None:
            card.setOnClickListener(OnClickListener(lambda v: on_click()))
        params = LinearLayout.LayoutParams(-1, -2)
        params.bottomMargin = self.dp(10)
        column.addView(card, params)

    def fgA_chip_hint(self, activity):
        hint = self.fg_text(activity, "нажми, чтобы изменить", 12, self.FGA_SUB2)
        hint.setPadding(0, self.dp(2), 0, 0)
        return hint

    # ----- Username sheet -----

    def fragment_usernames_sheet(self):
        activity = self.get_activity()
        if activity is None:
            return
        scroll, column = self.fg_root(activity, "Мои юзернеймы", "коллекционные юзернеймы")
        items = self.get_usernames()
        primary = (self.get_setting("primary_username", "") or "").lower()

        if not items:
            empty = self.fg_text(activity, "Пока пусто. Добавь свой первый юзернейм.", 15, self.FGA_SUB2)
            empty.setGravity(Gravity.CENTER)
            empty.setPadding(0, self.dp(8), 0, self.dp(16))
            column.addView(empty)
        else:
            self.fgA_section(activity, column, str(len(items)) + " в коллекции")
            for d in items:
                name = d["name"]
                gram = float(d.get("price") or DEFAULT_PRICE)
                is_primary = name.lower() == primary
                chip = self.fgA_chip(activity, "основной", FG_ACCENT, self.FGA_ACCENT_BG) if is_primary else None
                self.fgA_card_row(
                    activity, column, name, "@" + name, chip, gram,
                    lambda n=name: (self.active_sheet_dismiss(), self.username_actions(n)),
                )

        add = self.fg_button(activity, "+  Добавить юзернейм",
                             lambda: (self.active_sheet_dismiss(), self.add_username_dialog()))
        params = LinearLayout.LayoutParams(-1, -2)
        params.topMargin = self.dp(8)
        column.addView(add, params)

        note = self.fg_text(activity, "Видно только тебе. Цена и её курс — как на Fragment.",
                            12, self.FGA_SUB2)
        note.setGravity(Gravity.CENTER)
        note.setPadding(self.dp(4), self.dp(16), self.dp(4), 0)
        column.addView(note)

        self.active_sheet = self.fg_show(activity, scroll)

    # ----- Number sheet -----

    def fragment_number_sheet(self):
        activity = self.get_activity()
        if activity is None:
            return
        scroll, column = self.fg_root(activity, "Анонимный номер", "+888")
        number = parse_phone(self.get_setting("anon_number", ""))

        if number:
            self.fgA_section(activity, column, "твой номер")
            card = self.fg_card(activity)
            card.setOrientation(LinearLayout.HORIZONTAL)
            card.setGravity(Gravity.CENTER_VERTICAL)
            card.addView(self.fgA_avatar(activity, "8"))
            middle = LinearLayout(activity)
            middle.setOrientation(LinearLayout.VERTICAL)
            middle.addView(self.fg_text(activity, format_phone(number), 17, FG_TEXT, bold=True))
            status = self.fgA_chip(activity, "активен", self.FGA_GREEN, self.FGA_GREEN_BG)
            status_params = LinearLayout.LayoutParams(-2, -2)
            status_params.topMargin = self.dp(5)
            status.setLayoutParams(status_params)
            middle.addView(status)
            middle.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1.0))
            card.addView(middle)
            card.addView(self.fgA_price_cell(activity, self.number_price()))
            card_params = LinearLayout.LayoutParams(-1, -2)
            card_params.bottomMargin = self.dp(12)
            column.addView(card, card_params)

            for label, action in (
                ("Изменить номер", lambda: (self.active_sheet_dismiss(), self.set_number_dialog())),
                ("Изменить цену", lambda: (self.active_sheet_dismiss(),
                                           self.price_dialog(self.number_price(), self.set_number_price))),
            ):
                btn = self.fg_button(activity, label, action, color=FG_CARD)
                p = LinearLayout.LayoutParams(-1, -2)
                p.bottomMargin = self.dp(8)
                column.addView(btn, p)
            remove = self.fg_button(activity, "Убрать номер",
                                    lambda: (self.active_sheet_dismiss(), self.remove_number()), color=FG_DANGER)
            column.addView(remove, LinearLayout.LayoutParams(-1, -2))
        else:
            empty = self.fg_text(activity, "Номер +888 не задан.", 15, self.FGA_SUB2)
            empty.setGravity(Gravity.CENTER)
            empty.setPadding(0, self.dp(8), 0, self.dp(16))
            column.addView(empty)
            add = self.fg_button(activity, "Задать номер +888",
                                 lambda: (self.active_sheet_dismiss(), self.set_number_dialog()))
            column.addView(add, LinearLayout.LayoutParams(-1, -2))

        self.active_sheet = self.fg_show(activity, scroll)

    def remove_number(self):
        self.set_setting("anon_number", "")
        self.refresh_own_users()
        BulletinHelper.show_success("Номер убран. Переоткрой профиль")

    def active_sheet_dismiss(self):
        sheet = getattr(self, "active_sheet", None)
        if sheet is not None:
            try:
                sheet.dismiss()
            except Exception:
                pass
            self.active_sheet = None

    # ----- plain dialog fallback for the two screens -----

    def manage_usernames_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        items = self.get_usernames()
        primary = (self.get_setting("primary_username", "") or "").lower()
        rows = []
        for d in items:
            star = " ⭐ основной" if d["name"].lower() == primary else ""
            rows.append(f"@{d['name']}  ·  {self.price_label(float(d.get('price') or DEFAULT_PRICE))}{star}")
        rows.append("➕ Добавить юзернейм")

        builder = AlertDialogBuilder(activity)
        builder.set_title("Мои юзернеймы")

        def on_click(bld, which):
            bld.dismiss()
            if which == len(items):
                self.add_username_dialog()
            else:
                self.username_actions(items[which]["name"])

        builder.set_items(rows, on_click)
        builder.set_negative_button("Закрыть", lambda bld, _: bld.dismiss())
        builder.show()

    def username_actions(self, name: str):
        activity = self.get_activity()
        if activity is None:
            return
        is_primary = (self.get_setting("primary_username", "") or "").lower() == name.lower()
        actions = ["Изменить цену", "Убрать основной" if is_primary else "Сделать основным", "Удалить"]

        builder = AlertDialogBuilder(activity)
        builder.set_title(f"@{name}")

        def on_click(bld, which):
            bld.dismiss()
            if which == 0:
                self.price_dialog(self.price_of(name), lambda value: self.set_username_price(name, value))
            elif which == 1:
                self.set_setting("primary_username", "" if is_primary else name)
                self.refresh_own_users()
                self.manage_usernames()
            else:
                self.save_usernames([d for d in self.get_usernames() if d["name"].lower() != name.lower()])
                if is_primary:
                    self.set_setting("primary_username", "")
                self.manage_usernames()

        builder.set_items(actions, on_click)
        builder.set_negative_button("Назад", lambda bld, _: (bld.dismiss(), self.manage_usernames()))
        builder.show()

    def set_username_price(self, name: str, price: float):
        items = self.get_usernames()
        for d in items:
            if d["name"].lower() == name.lower():
                d["price"] = price
        self.save_usernames(items)
        self.manage_usernames()

    def add_username_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        layout = LinearLayout(activity)
        layout.setOrientation(LinearLayout.VERTICAL)
        pad = AndroidUtilities.dp(22)
        layout.setPadding(pad, 0, pad, 0)
        name_field = EditText(activity)
        name_field.setHint("Юзернейм, например durov")
        name_field.setInputType(InputType.TYPE_CLASS_TEXT)
        price_field = EditText(activity)
        price_field.setHint("Цена в GRAM, например 7000")
        price_field.setInputType(InputType.TYPE_CLASS_NUMBER)
        layout.addView(name_field)
        layout.addView(price_field)

        builder = AlertDialogBuilder(activity)
        builder.set_title("Новый юзернейм")
        builder.set_view(layout)

        def on_ok(bld, _):
            names = parse_usernames(str(name_field.getText()))
            bld.dismiss()
            if not names:
                BulletinHelper.show_error("Юзернейм: 4-32 латинских буквы, цифры или _")
                self.manage_usernames()
                return
            name = names[0]
            try:
                price = float(str(price_field.getText()).replace(",", ".")) if str(price_field.getText()).strip() else DEFAULT_PRICE
            except ValueError:
                price = DEFAULT_PRICE
            items = [d for d in self.get_usernames() if d["name"].lower() != name.lower()]
            items.append({"name": name, "price": price})
            self.save_usernames(items)
            self.manage_usernames()

        builder.set_positive_button("Добавить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: (bld.dismiss(), self.manage_usernames()))
        builder.show()

    def price_dialog(self, current: float, on_value):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER)
        field.setHint("Цена в GRAM")
        field.setText(str(int(current)))

        builder = AlertDialogBuilder(activity)
        builder.set_title("Цена покупки (GRAM)")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            try:
                on_value(float(str(field.getText()).replace(",", ".")))
            except ValueError:
                BulletinHelper.show_error("Нужно число")

        builder.set_positive_button("Сохранить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def manage_number_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        number = parse_phone(self.get_setting("anon_number", ""))
        if number:
            rows = [f"Номер: {format_phone(number)}", f"Цена: {self.price_label(self.number_price())}",
                    "Изменить номер", "Изменить цену", "Убрать номер"]
            offset = 2
        else:
            rows = ["Задать номер +888"]
            offset = 0

        builder = AlertDialogBuilder(activity)
        builder.set_title("Анонимный номер +888")

        def on_click(bld, which):
            bld.dismiss()
            if not number:
                self.set_number_dialog()
                return
            if which == offset:       # change number
                self.set_number_dialog()
            elif which == offset + 1:  # change price
                self.price_dialog(self.number_price(), self.set_number_price)
            elif which == offset + 2:  # remove
                self.set_setting("anon_number", "")
                self.refresh_own_users()
                BulletinHelper.show_success("Номер убран. Переоткрой профиль")

        builder.set_items(rows, on_click)
        builder.set_negative_button("Закрыть", lambda bld, _: bld.dismiss())
        builder.show()

    def set_number_price(self, price: float):
        self.set_setting("number_price", str(price))
        self.manage_number()

    def set_number_dialog(self):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_PHONE)
        field.setHint("+888 0123 4567")
        field.setText("+" + parse_phone(self.get_setting("anon_number", "")))

        builder = AlertDialogBuilder(activity)
        builder.set_title("Анонимный номер +888")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            phone = parse_phone(str(field.getText()))
            if not phone:
                BulletinHelper.show_error("Это не номер +888")
                return
            self.set_setting("anon_number", phone)
            self.refresh_own_users()
            BulletinHelper.show_success("Номер задан. Переоткрой профиль")
            self.manage_number()

        builder.set_positive_button("Сохранить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    # Fragment: purchase info for the local usernames and +888 number.

    def ton_rate(self, fiat: str) -> float:
        """GRAM (TON) price in fiat. Refreshes in the background, never blocks."""
        try:
            cached = json.loads(self.get_setting("ton_rates", "") or "{}")
        except ValueError:
            cached = {}
        if time.time() - cached.get("time", 0) > RATES_TTL and not self.rates_loading:
            self.rates_loading = True
            threading.Thread(target=self.load_rates, daemon=True).start()
        return float(cached.get(fiat) or FALLBACK_RATES[fiat])

    def load_rates(self):
        try:
            data = json.loads(http_get(RATES_URL))["the-open-network"]
            rates = {fiat: float(data[fiat.lower()]) for fiat in FIAT}
            rates["time"] = time.time()
            self.set_setting("ton_rates", json.dumps(rates))
        except Exception:
            self.logger.exception("Could not load GRAM rates, using the last known ones")
        finally:
            self.rates_loading = False

    def collectible_info(self, request):
        collectible = request.collectible
        if isinstance(collectible, TL_fragment.TL_inputCollectibleUsername):
            name = next((n for n in self.username_names()
                         if n.lower() == (collectible.username or "").lower()), None)
            if name is None:
                return None
            key, url, price = name.lower(), f"https://fragment.com/username/{name}", self.price_of(name)
        elif isinstance(collectible, TL_fragment.TL_inputCollectiblePhone):
            phone = parse_phone(self.get_setting("anon_number", ""))
            if not phone or re.sub(r"\D", "", collectible.phone or "") != phone:
                return None
            key, url, price = "number", f"https://fragment.com/number/{phone}", self.number_price()
        else:
            return None

        fiat = FIAT[self.get_setting("fiat_currency", 0)]
        date_key = f"bought_at_{key}"
        bought_at = self.get_setting(date_key, 0)
        if not bought_at:
            bought_at = int(time.time())
            self.set_setting(date_key, bought_at)

        info = TL_fragment.TL_collectibleInfo()
        info.purchase_date = int(bought_at)
        info.crypto_currency = "TON"
        info.crypto_amount = int(price * NANO)
        info.currency = fiat
        info.amount = int(round(price * self.ton_rate(fiat) * 100))  # cents / kopecks
        info.url = url
        return info, None

    def open_saved_messages(self, account: int, text: str):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            args = Bundle()
            args.putLong("user_id", get_user_config(account).getClientUserId())
            chat = ChatActivity(args)
            fragment.presentFragment(chat)
            run_on_ui_thread(lambda: BulletinHelper.show_success(text, chat), 400)
        except Exception:
            self.logger.exception("Could not open Saved Messages")
            BulletinHelper.show_success(text)

    # Cards in Saved Messages for local purchases. They are only in this app's database.

    def post_saved_card(self, purchase, gift, unique: bool):
        """purchase is (account, price, ton): price in stars, or nanoTON when ton."""
        account, price, ton = purchase
        try:
            user_id = get_user_config(account).getClientUserId()
            me = TLRPC.TL_peerUser()
            me.user_id = user_id

            if unique:
                action = TLRPC.TL_messageActionStarGiftUnique()
                action.saved = True
                action.flags |= 4
                # With a resale amount the app writes "You bought this gift for ...".
                if ton:
                    action.resale_amount = TL_stars.TL_starsTonAmount()
                    action.resale_amount.amount = int(price)
                else:
                    action.resale_amount = TL_stars.StarsAmount.ofStars(int(price))
                action.flags |= 256
            else:
                action = TLRPC.TL_messageActionStarGift()
                action.saved = True
                action.flags |= 4
            action.gift = gift

            message = TLRPC.TL_messageService()
            message.id = get_user_config(account).getNewMessageId()
            message.from_id = me
            message.peer_id = me
            message.dialog_id = user_id
            message.date = int(time.time())
            message.out = True
            message.flags |= 2 | 256
            message.action = action

            messages = ArrayList()
            messages.add(message)
            try:
                MessagesStorage.getInstance(account).putMessages(messages, False, True, False, 0, 0, 0)
            except Exception:
                self.logger.exception("Could not save the purchase card, it will vanish after restart")
            objects = ArrayList()
            objects.add(MessageObject(account, message, True, True))
            run_on_ui_thread(lambda: get_messages_controller(account).updateInterfaceWithMessages(user_id, objects, 0))
        except Exception:
            self.logger.exception("Could not post the purchase card to Saved Messages")

    # Picker: collection -> NFT on resale, by number or a random one.

    def get_activity(self):
        fragment = get_last_fragment()
        return fragment.getParentActivity() if fragment else None

    def show_loading(self):
        activity = self.get_activity()
        if activity is None:
            return None
        dialog = AlertDialogBuilder(activity, AlertDialogBuilder.ALERT_TYPE_SPINNER)
        dialog.show()
        return dialog

    def show_items(self, title: str, items: List[str], on_pick):
        activity = self.get_activity()
        if activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(title)

        def on_click(bld, which):
            bld.dismiss()
            on_pick(which)

        builder.set_items(items, on_click)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    # ----- NFT constructor: Telegram's own market and preview sheet, driven by hooks -----

    def open_nft_market(self):
        activity = self.get_activity()
        if activity is None:
            return
        try:
            from org.telegram.ui.Gifts import GiftSheet
            account = UserConfig.selectedAccount
            uid = get_user_config(account).getClientUserId()
            self.restore_resale()
            self.resale_account = account
            self.market_opening = True  # fillItems runs inside the constructor already
            write_log("opening market")
            try:
                sheet = GiftSheet(activity, account, uid, None)
            finally:
                self.market_opening = False
            sheet.setOnDismissListener(R(self.on_market_closed))
            self.market_sheet = sheet
            try:
                self.add_market_hold(sheet)
            except Exception:
                write_log(f"hold failed:\n{traceback.format_exc()}")
            sheet.show()
            write_log("market shown")
        except Exception:
            self.logger.exception("Could not open the gift market")
            BulletinHelper.show_error("Не удалось открыть маркет")

    HOLD_SECONDS = 5.0

    def add_market_hold(self, sheet):
        """Holding a gift in the constructor market for 5+ seconds adds it, non-upgraded,
        to the profile and closes the market. Telegram's long press fires after ~0.5 s,
        so the rest of the wait is timed here and a release before that cancels it."""
        listview = java_field(sheet, "recyclerListView")
        adapter = java_field(sheet, "adapter")
        hold = {"token": 0}

        def on_start(view, position):
            item = adapter.getItem(position - 1) if adapter is not None else None
            gift = getattr(item, "object", None) if item is not None else None
            if gift is None or not str(gift.getClass().getName()).endswith("$TL_starGift"):
                return False
            hold["token"] += 1
            token = hold["token"]

            def fire():
                if hold["token"] != token or not self.market_active():
                    return
                hold["token"] += 1
                try:
                    view.performHapticFeedback(0)  # HapticFeedbackConstants.LONG_PRESS
                except Exception:
                    pass
                self.add_regular_from_market(gift)

            run_on_ui_thread(fire, int((self.HOLD_SECONDS - 0.5) * 1000))
            return True

        def on_release():
            hold["token"] += 1

        self.market_hold_listener = long_press_listener(on_start, on_release)  # keep the proxy alive
        listview.setOnItemLongClickListener(self.market_hold_listener)
        write_log("market hold installed")

    def add_regular_from_market(self, gift):
        write_log(f"hold: add regular {gift.id} {gift.title}")
        self.catalog[gift.id] = gift
        ids = self.regular_gift_ids()
        ids.insert(0, gift.id)
        self.set_setting("regular_gifts", ",".join(str(i) for i in ids))
        sheet = getattr(self, "market_sheet", None)
        if sheet is not None:
            sheet.dismiss()
        BulletinHelper.show_success(f"«{gift.title}» добавлен в профиль. Переоткрой профиль")

    def is_market_sheet(self, sheet) -> bool:
        if getattr(self, "market_opening", False):
            return True
        current = getattr(self, "market_sheet", None)
        try:
            return current is not None and current.equals(sheet)
        except Exception:
            return False

    def hide_resale_now(self):
        """Zero resale counts in the lists GiftSheet reads, remembering originals."""
        if not hasattr(self, "resale_backup"):
            self.resale_backup = []
        controller = StarsController.getInstance(getattr(self, "resale_account", UserConfig.selectedAccount))
        hidden = 0
        for name in ("gifts", "sortedGifts", "birthdaySortedGifts"):
            gifts = getattr(controller, name, None)
            if gifts is None:
                continue
            for i in range(gifts.size()):
                gift = gifts.get(i)
                value = int(getattr(gift, "availability_resale", 0) or 0)
                if value > 0:
                    self.resale_backup.append((gift, value))
                    gift.availability_resale = 0
                    hidden += 1
        if hidden:
            write_log(f"hid resale on {hidden} gifts")

    def restore_resale(self):
        for gift, value in getattr(self, "resale_backup", []) or []:
            try:
                gift.availability_resale = value
            except Exception:
                pass
        self.resale_backup = []

    def on_market_closed(self):
        write_log("market closed")
        self.restore_resale()

    def market_active(self) -> bool:
        sheet = getattr(self, "market_sheet", None)
        try:
            return sheet is not None and sheet.isShowing()
        except Exception:
            return False

    def catalog_title(self, gift_id):
        gift = self.catalog.get(gift_id)
        return gift.title if gift is not None else "NFT"

    def open_constructor_for(self, gift_id, title):
        write_log(f"open constructor for {gift_id} {title}")
        req = TL_stars.getStarGiftUpgradePreview()
        req.gift_id = gift_id

        def on_result(response):
            attrs = getattr(response, "sample_attributes", None)
            if attrs is None or attrs.size() == 0:
                BulletinHelper.show_error("Нет образцов для этой коллекции")
                return
            self.show_native_constructor(gift_id, title or "NFT", attrs)

        self.request_on_ui(req, on_result)

    def show_native_constructor(self, gift_id, title, attrs):
        try:
            self._show_native_constructor(gift_id, title, attrs)
        except Exception:
            write_log(f"constructor failed:\n{traceback.format_exc()}")
            BulletinHelper.show_error("Конструктор не открылся. Лог: настройки → Лог winft")

    def _show_native_constructor(self, gift_id, title, attrs):
        from org.telegram.ui.Stars import StarGiftPreviewSheet
        activity = self.get_activity()
        if activity is None:
            return
        write_log(f"constructor: {title} id={gift_id} samples={attrs.size()}")
        sheet = StarGiftPreviewSheet(activity, None, UserConfig.selectedAccount, title, attrs, False)
        write_log("constructor: sheet created")
        base = self.catalog.get(gift_id)
        total = int(getattr(base, "availability_total", 0) or 0) or 100000
        self.ctor = {"sheet": sheet, "gift_id": gift_id, "title": title, "total": total,
                     "num": random.randint(1, total), "value": None, "built": False}
        try:
            self.add_constructor_buttons(sheet)
            write_log("constructor: buttons added")
        except Exception:
            write_log(f"buttons failed:\n{traceback.format_exc()}")
        try:
            self.add_build_check(sheet)
            write_log("constructor: check added")
        except Exception:
            write_log(f"check failed:\n{traceback.format_exc()}")
        self.update_ctor_header()
        write_log("constructor: showing")
        sheet.show()
        write_log("constructor: shown")

    def add_constructor_buttons(self, sheet):
        """Two round buttons beside the native glass tab bar. The glass comes from the sheet's
        own fallback source: its live-blur source only tracks the tab bar and crashes others."""
        from android.widget import FrameLayout
        from org.telegram.ui.ActionBar import Theme
        from org.telegram.ui.Components.blur3 import BlurredBackgroundDrawableViewFactory
        from org.telegram.ui.Components.blur3.drawable.color import BlurredBackgroundColorProviderThemed
        container = get_private_field(sheet, "containerView")
        tabs = get_private_field(sheet, "tabsSelectorView")
        fallback = get_private_field(sheet, "glassSourceFallback")
        factory = BlurredBackgroundDrawableViewFactory(fallback) if fallback is not None else None
        activity = self.get_activity()
        side = (AndroidUtilities.displaySize.x - self.dp(268)) // 2
        size = max(self.dp(36), min(self.dp(56), side - self.dp(14)))
        views = []
        for text, action in (("#", self.ask_ctor_number), ("?", self.ask_ctor_value)):
            view = TextView(activity)
            view.setText(text)
            view.setGravity(Gravity.CENTER)
            view.setTypeface(Typeface.DEFAULT_BOLD)
            view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22.0)
            view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            if factory is not None:
                drawable = factory.create(view)
                drawable.setPadding(self.dp(4))
                drawable.setRadius(size // 2 - self.dp(4))
                drawable.setColorProvider(BlurredBackgroundColorProviderThemed(None, Theme.key_windowBackgroundWhite))
                view.setBackground(drawable)
            container.addView(view, FrameLayout.LayoutParams(size, size, Gravity.TOP | Gravity.LEFT))
            view.setOnClickListener(OnClickListener(lambda v, a=action: a()))
            views.append(view)

        def place():
            gap = self.dp(10)
            y = tabs.getY() + (tabs.getHeight() - size) / 2.0
            left, right = views
            left.setX(float(max(self.dp(4), tabs.getX() - gap - size)))
            right.setX(float(min(container.getWidth() - size - self.dp(4), tabs.getX() + tabs.getWidth() + gap)))
            left.setY(float(y))
            right.setY(float(y))

        self.ctor_layout_listener = layout_listener(place)  # keep the proxy alive
        tabs.addOnLayoutChangeListener(self.ctor_layout_listener)

    def add_build_check(self, sheet):
        """Turns the native play/pause circle into a white check that builds the NFT. The
        sheet resets that image on every mode change, so the play icon is faded out and the
        check is drawn as the view's foreground; the native tinted circle stays as it is."""
        from android.graphics import PorterDuff, PorterDuffColorFilter
        play = get_private_field(sheet, "headerPlay")
        activity = self.get_activity()
        res = activity.getResources()
        icon = None
        for name in ("ic_ab_done", "checkbig", "msg_check"):
            rid = res.getIdentifier(name, "drawable", activity.getPackageName())
            if rid:
                icon = activity.getDrawable(rid).mutate()
                break
        if icon is None:
            return
        icon.setColorFilter(PorterDuffColorFilter(_argb(0xFFFFFFFF), PorterDuff.Mode.SRC_IN))
        play.setImageAlpha(0)
        play.setForeground(icon)
        play.setForegroundGravity(Gravity.CENTER)
        play.setOnClickListener(OnClickListener(lambda v: self.build_and_close()))

    def build_and_close(self):
        c = self.ctor
        if c is None or c["built"]:
            return
        try:
            model, back, pat = self.ctor_selection(c["sheet"])
        except Exception:
            write_log(f"selection failed:\n{traceback.format_exc()}")
            BulletinHelper.show_error("Не удалось прочитать выбор")
            return
        if model is None or back is None:
            BulletinHelper.show_error("Выбери модель и фон")
            return
        self.build_from_ctor(model, back, pat)
        if c["built"]:
            c["sheet"].dismiss()

    def ctor_value_label(self):
        value = self.ctor.get("value") if self.ctor else None
        if not value:
            return None
        amount, code = value
        symbol = next((sym for c, sym, _ in CURRENCIES if c == code), code)
        return f"Ценность ~{amount:g} {symbol}"

    def update_ctor_header(self):
        c = self.ctor
        if c is None:
            return
        try:
            get_private_field(c["sheet"], "giftNameTextView").setText(f"{c['title']} #{c['num']}")
            label = self.ctor_value_label()
            if label:
                get_private_field(c["sheet"], "giftStatusTextView").setText(label)
        except Exception:
            self.logger.exception("Could not update the constructor header")

    def ask_ctor_number(self):
        c = self.ctor
        activity = self.get_activity()
        if c is None or activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER)
        field.setText(str(c["num"]))
        builder = AlertDialogBuilder(activity)
        builder.set_title("Номер подарка")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            text = str(field.getText()).strip()
            if text.isdigit() and int(text) > 0:
                c["num"] = int(text)
                self.update_ctor_header()

        builder.set_positive_button("Готово", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def ask_ctor_value(self):
        activity = self.get_activity()
        if self.ctor is None or activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title("Ценность в")

        def on_pick(bld, which):
            bld.dismiss()
            self.ask_ctor_amount(CURRENCIES[which][0])

        builder.set_items([f"{sym}  {name}" for _, sym, name in CURRENCIES], on_pick)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def ask_ctor_amount(self, code):
        c = self.ctor
        activity = self.get_activity()
        if c is None or activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_FLAG_DECIMAL)
        field.setHint("Например 32")
        builder = AlertDialogBuilder(activity)
        builder.set_title("Ценность")
        builder.set_view(field)

        def on_ok(bld, _):
            bld.dismiss()
            amount = parse_amount(str(field.getText()), 0)
            c["value"] = (amount, code) if amount > 0 else None
            self.update_ctor_header()

        builder.set_positive_button("Готово", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def ctor_selection(self, sheet):
        mode = get_private_field(sheet, "mode")
        if mode is not None and mode.name() == "SELECTED":
            selected = get_private_field(sheet, "selectedAttributes")
            if selected is not None:
                return selected.model, selected.backdrop, selected.pattern
        top = get_private_field(sheet, "topView")
        return (top.getUpgradeImageViewAttribute(), top.getUpgradeBackdropAttribute(),
                top.getUpgradePatternAttribute())

    def to_usd(self, amount, code):
        if code == "USD":
            return amount
        return amount * self.ton_rate("USD") / max(self.ton_rate(code), 1e-9)

    def build_from_ctor(self, model, back, pat):
        c = self.ctor
        if c is None:
            return
        gift = self.assemble_unique(c["gift_id"], c["title"], model, back, pat)
        gift.num = c["num"]
        gift.availability_issued = max(gift.num, min(c["total"], gift.num + 1000))
        gift.availability_total = max(c["total"], gift.availability_issued)
        if c["value"]:
            amount, code = c["value"]
            gift.value_amount = int(round(amount * 100))
            gift.value_currency = code
            gift.value_usd_amount = int(round(self.to_usd(amount, code) * 100))
            gift.flags |= FLAG_VALUE
        if not self.store_custom(gift):
            BulletinHelper.show_error("Не удалось собрать NFT")
            return
        c["built"] = True
        BulletinHelper.show_success(f"NFT «{gift.title} #{gift.num}» собран. Переоткрой профиль")

    def request_on_ui(self, req, on_result):
        """Sends a request with a loading spinner and calls on_result(response) on the UI thread."""
        loading = self.show_loading()
        state = {"done": False}

        def close_loading():
            if loading:
                try:
                    loading.dismiss()
                except Exception:
                    pass

        def on_response(response, error):
            def finish():
                if state["done"]:
                    return
                state["done"] = True
                close_loading()
                if error or response is None:
                    BulletinHelper.show_error(f"Ошибка: {error.text if error else 'пустой ответ'}")
                    return
                try:
                    on_result(response)
                except Exception as e:
                    self.logger.exception("Picker failed")
                    BulletinHelper.show_error(f"Ошибка плагина: {type(e).__name__}: {e}")
            run_on_ui_thread(finish)

        def on_timeout():
            if not state["done"]:
                state["done"] = True
                close_loading()
                BulletinHelper.show_error("Сервер не ответил. Попробуй ещё раз")

        try:
            send_request(req, on_response)
        except Exception as e:
            self.logger.exception("Could not send the picker request")
            state["done"] = True
            close_loading()
            BulletinHelper.show_error(f"Ошибка плагина: {type(e).__name__}: {e}")
            return
        run_on_ui_thread(on_timeout, 15000)

    def pick_collection(self):
        req = TL_stars.getStarGifts()
        req.hash = 0

        def on_result(response):
            gifts = jlist(getattr(response, "gifts", None))
            self.logger.info(f"Gift catalog: {response.getClass().getSimpleName()}, {len(gifts)} gifts")
            resale = lambda gift: int(getattr(gift, "availability_resale", 0) or 0)
            collections = [
                gift for gift in gifts
                if resale(gift) > 0 or int(getattr(gift, "upgrade_stars", 0) or 0) > 0
            ]
            collections.sort(key=lambda gift: -resale(gift))
            if not collections:
                BulletinHelper.show_error(f"Коллекции не найдены (в каталоге {len(gifts)} подарков)")
                return
            items = [f"{gift.title or 'Без названия'} ({resale(gift)} в продаже)" for gift in collections]
            self.show_items("Коллекция", items, lambda i: self.pick_from_collection(collections[i]))

        self.request_on_ui(req, on_result)

    def pick_from_collection(self, collection):
        req = TL_stars.getResaleStarGifts()
        req.gift_id = collection.id
        req.sort_by_price = True
        req.offset = ""
        req.limit = 50

        def on_result(response):
            uniques = [gift for gift in jlist(response.gifts) if gift.slug]
            base = uniques[0].slug.rsplit("-", 1)[0] if uniques else slug_base(collection.title)
            items = ["🔢 Ввести номер"]
            if uniques:
                items.append("🎲 Случайный")
            items += [describe_unique(gift) for gift in uniques]

            def on_pick(i):
                if i == 0:
                    self.ask_number(collection.title, base)
                elif i == 1:
                    self.add_slug(random.choice(uniques).slug)
                else:
                    self.add_slug(uniques[i - 2].slug)

            self.show_items(collection.title, items, on_pick)

        self.request_on_ui(req, on_result)

    def ask_number(self, title: str, base: str):
        activity = self.get_activity()
        if activity is None:
            return
        field = EditText(activity)
        field.setInputType(InputType.TYPE_CLASS_NUMBER)
        field.setHint("Например 1")
        builder = AlertDialogBuilder(activity)
        builder.set_title(f"{title}: номер")
        builder.set_view(field)

        def on_ok(bld, _):
            number = str(field.getText()).strip()
            bld.dismiss()
            if number.isdigit():
                self.add_slug(f"{base}-{int(number)}")

        builder.set_positive_button("Добавить", on_ok)
        builder.set_negative_button("Отмена", lambda bld, _: bld.dismiss())
        builder.show()

    def assemble_unique(self, gift_id, title, model, back, pat):
        gift = TL_stars.TL_starGiftUnique()
        gift.id = random.getrandbits(62)
        gift.gift_id = gift_id
        gift.title = title or "Custom"
        gift.num = random.randint(1, 99999)
        store = self.get_custom_store()
        gift.slug = f"winft-custom-{len(store)}-{gift.num}"
        gift.availability_issued = gift.num
        gift.availability_total = 100000
        attrs = ArrayList()
        attrs.add(model)
        if pat is not None:
            attrs.add(pat)
        attrs.add(back)
        gift.attributes = attrs
        return gift

    def store_custom(self, gift) -> bool:
        store = self.get_custom_store()
        try:
            store.append(gift_to_hex(gift))
        except Exception:
            self.logger.exception("Could not serialize the built NFT")
            return False
        self.set_setting("custom_gifts", json.dumps(store))
        self.custom[gift.slug] = gift
        return True

    # ----- Local upgrade of a non-upgraded gift -----

    def regular_gift_id_from_input(self, stargift):
        if isinstance(stargift, TL_stars.TL_inputSavedStarGiftUser):
            return self.local_regular_msg.get(stargift.msg_id)
        return None

    def do_local_upgrade(self, gift_id):
        collection = self.catalog.get(gift_id)
        title = collection.title if collection is not None else "Gift"
        req = TL_stars.getStarGiftUpgradePreview()
        req.gift_id = gift_id

        def on_response(response, error):
            attrs = jlist(getattr(response, "sample_attributes", None))
            models = [a for a in attrs if isinstance(a, TL_stars.starGiftAttributeModel)]
            backs = [a for a in attrs if isinstance(a, TL_stars.starGiftAttributeBackdrop)]
            pats = [a for a in attrs if isinstance(a, TL_stars.starGiftAttributePattern)]
            if not models or not backs:
                run_on_ui_thread(lambda: BulletinHelper.show_error("Нет образцов для улучшения"))
                return
            gift = self.assemble_unique(gift_id, title, random.choice(models),
                                        random.choice(backs), random.choice(pats) if pats else None)
            if self.store_custom(gift):
                ids = [i for i in self.regular_gift_ids() if i != gift_id]
                self.set_setting("regular_gifts", ",".join(str(i) for i in ids))
                run_on_ui_thread(lambda: BulletinHelper.show_success(
                    f"Подарок улучшен в «{gift.title} #{gift.num}». Переоткрой профиль"))

        send_request(req, on_response)

    def upgrade_gift_locally(self, request):
        gift_id = self.regular_gift_id_from_input(request.stargift)
        if gift_id is None:
            return None
        self.do_local_upgrade(gift_id)
        updates = TLRPC.TL_updates()
        updates.date = int(time.time())
        return updates, None

    def remove_custom_gift(self, slug: str):
        store = self.get_custom_store()
        keep = [hx for hx in store if gift_from_hex_slug(hx) != slug]
        self.set_setting("custom_gifts", json.dumps(keep))
        self.custom.pop(slug, None)

    def add_slug(self, slug: str):
        slugs = parse_slugs(self.get_setting("slug", ""))
        if slug not in slugs:
            slugs.append(slug)
        self.save_slugs(slugs)

    def pick_to_remove(self):
        link_slugs = parse_slugs(self.get_setting("slug", ""))
        custom_slugs = list(self.custom.keys())
        if not link_slugs and not custom_slugs:
            BulletinHelper.show_info("Список NFT пуст")
            return
        labels = list(link_slugs)
        for slug in custom_slugs:
            gift = self.custom.get(slug)
            labels.append(f"🔨 {gift.title} #{gift.num}" if gift else slug)

        def on_pick(i):
            if i < len(link_slugs):
                self.save_slugs(link_slugs[:i] + link_slugs[i + 1:])
                BulletinHelper.show_success(f"«{link_slugs[i]}» убран. Переоткрой профиль")
            else:
                slug = custom_slugs[i - len(link_slugs)]
                self.remove_custom_gift(slug)
                BulletinHelper.show_success("Собранный NFT убран. Переоткрой профиль")

        self.show_items("Убрать NFT", labels, on_pick)

    def save_slugs(self, slugs: List[str]):
        text = ", ".join(slugs)
        self.set_setting("slug", text, reload_settings=True)
        self.load_gifts(text)

    def load_gifts(self, text: str):
        # Responses to an older list of links are dropped by comparing generations.
        self.generation += 1
        generation = self.generation
        self.slugs = parse_slugs(text)
        self.gifts = {}
        for slug in self.slugs:
            self.load_gift(slug, generation)

    def load_gift(self, slug: str, generation: int):
        req = TL_stars.getUniqueStarGift()
        req.slug = slug

        def on_response(response, error):
            if generation != self.generation:
                return
            if error or response is None or response.gift is None:
                text = error.text if error else "пустой ответ"
                BulletinHelper.show_error(f"NFT «{slug}» не найден: {text}")
                return
            gift = response.gift
            self.apply_listing(gift)
            if self.gift_meta(slug).get("drop_details"):
                self.strip_original_details(gift)
            self.gifts[slug] = gift
            if slug in self.announce:
                self.post_saved_card(self.announce.pop(slug), gift, unique=True)
            BulletinHelper.show_success(
                f"NFT «{gift.title} #{gift.num}» загружен ({len(self.gifts)}/{len(self.slugs)})"
            )

        send_request(req, on_response)

    def all_slugs(self) -> List[str]:
        return self.slugs + list(self.custom.keys())

    def gift_lookup(self, slug: str):
        return self.gifts.get(slug) or self.custom.get(slug)

    def loaded_gifts(self) -> List[Any]:
        """Link-based gifts (in entry order) plus locally built ones."""
        if not self.get_setting("enabled", True):
            return []
        return [self.gift_lookup(slug) for slug in self.all_slugs() if self.gift_lookup(slug)]

    def get_custom_store(self) -> list:
        try:
            return json.loads(self.get_setting("custom_gifts", "") or "[]")
        except ValueError:
            return []

    def load_custom_gifts(self):
        self.custom = {}
        for hx in self.get_custom_store():
            try:
                gift = gift_from_hex(hx)
                if gift is not None and gift.slug:
                    self.custom[gift.slug] = gift
            except Exception:
                self.logger.exception("Could not restore a built NFT")

    def is_own_peer(self, account: int, peer) -> bool:
        if isinstance(peer, TLRPC.TL_inputPeerSelf):
            return True
        if isinstance(peer, TLRPC.TL_inputPeerUser):
            return peer.user_id == get_user_config(account).getClientUserId()
        return False

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        if isinstance(request, TL_account.updateEmojiStatus):
            return self.on_update_emoji_status(account, request)
        if "toggleStarGiftsPinnedToTop" in request_name:
            return self.on_toggle_pinned(account, request)
        if "getSavedStarGifts" in request_name:
            own_first_page = (
                self.is_own_peer(account, request.peer)
                and not request.offset
                and (request.flags & 64) == 0  # not a collection
            )
            self.pending[account].append(request if own_first_page else None)
        elif "getStarsStatus" in request_name or "getStarsTransactions" in request_name:
            self.tx_pending[account].append({
                "ton": bool(getattr(request, "ton", False)),
                "inbound": bool(getattr(request, "inbound", False)),
                "outbound": bool(getattr(request, "outbound", False)),
                "self": self.is_own_peer(account, getattr(request, "peer", None)),
                "first": not getattr(request, "offset", ""),
            })
        return HookResult()

    def on_update_emoji_status(self, account: int, request) -> HookResult:
        # The app has already put the new status on our user object before sending
        # the request, so keep it locally and do not send anything to the server.
        is_local_gift = (
            isinstance(request.emoji_status, TLRPC.TL_inputEmojiStatusCollectible)
            and request.emoji_status.collectible_id in self.local_gift_ids()
        )
        if not self.get_setting("local_premium", True) and not is_local_gift:
            return HookResult()
        user = get_user_config(account).getCurrentUser()
        if user is None:
            return HookResult()
        self.save_status(user.id, user.emoji_status)
        return HookResult(strategy=HookStrategy.CANCEL)

    def post_request_hook(self, request_name: str, account: int, response: Any, error: Any) -> HookResult:
        if isinstance(response, TLRPC.TL_payments_paymentFormStarGift):
            self.form_prices[response.form_id] = sum(p.amount for p in jlist(response.invoice.prices))
            return HookResult()
        if "getSavedStarGifts" in request_name:
            queue = self.pending[account]
            request = queue.popleft() if queue else None
            if request is None or error or response is None:
                return HookResult()
            saved = []
            if not request.exclude_unique:
                saved += [self.make_saved_gift(account, gift) for gift in self.loaded_gifts()]
            if not request.exclude_unlimited:
                saved += [
                    self.make_saved_regular_gift(account, gift, i)
                    for i, gift in enumerate(self.loaded_regular_gifts())
                ]
            if saved:
                for i, gift in enumerate(saved):
                    response.gifts.add(i, gift)
                response.count += len(saved)
                return HookResult(strategy=HookStrategy.MODIFY, response=response)
        elif "getStarsStatus" in request_name or "getStarsTransactions" in request_name:
            meta = self.tx_pending[account].popleft() if self.tx_pending[account] else None
            # Inject only into the paged transaction list, never the balance status,
            # so a purchase never shows up under "Зачисления".
            if meta and meta["self"] and meta["first"] and "getStarsTransactions" in request_name \
                    and not error and response is not None and self.get_setting("local_balance", True):
                txs = self.transactions_for(meta["ton"], meta["inbound"], meta["outbound"], account)
                if txs:
                    for t in reversed(txs):
                        response.history.add(0, t)
                    response.flags |= 8
                    return HookResult(strategy=HookStrategy.MODIFY, response=response)
        elif request_name == "TL_users_getFullUser":
            added = len(self.loaded_gifts()) + len(self.loaded_regular_gifts())
            if not error and response is not None and added:
                full = response.full_user
                if full is not None and full.id == get_user_config(account).getClientUserId():
                    full.stargifts_count += added
                    full.flags2 |= FLAG_STARGIFTS_COUNT
                    return HookResult(strategy=HookStrategy.MODIFY, response=response)
        return HookResult()

    def get_own_ids(self):
        if not self.own_ids:
            for account in range(UserConfig.MAX_ACCOUNT_COUNT):
                user_id = get_user_config(account).getClientUserId()
                if user_id:
                    self.own_ids.add(user_id)
        return self.own_ids

    def get_status(self, user_id: int):
        if user_id not in self.statuses:
            text = self.get_setting(f"status_{user_id}", "")
            try:
                self.statuses[user_id] = status_from_hex(text) if text else None
            except Exception:
                self.logger.exception("Could not restore the worn status")
                self.statuses[user_id] = None
        return self.statuses[user_id]

    def save_status(self, user_id: int, status):
        empty = status is None or isinstance(status, TLRPC.TL_emojiStatusEmpty)
        self.statuses[user_id] = None if empty else status
        self.set_setting(f"status_{user_id}", "" if empty else status_to_hex(status))

    def patch_user(self, user):
        if user is None or user.id not in self.get_own_ids():
            return
        if self.get_setting("local_premium", True):
            user.premium = True
        status = self.get_status(user.id)
        if status is not None:
            user.emoji_status = status
        self.patch_usernames(user)
        self.patch_phone(user)

    def patch_usernames(self, user):
        names = self.username_names()
        if user.usernames is None:
            user.usernames = ArrayList()
        # Drop what we added last time, so removed names go away without a restart.
        for i in reversed(range(user.usernames.size())):
            entry = user.usernames.get(i)
            if not entry.editable and entry.username in self.added_usernames:
                user.usernames.remove(jint(i))  # by index, not by value
        self.added_usernames = set(names)
        if names and user.usernames.size() == 0 and user.username:
            own = TLRPC.TL_username()
            own.editable = True
            own.active = True
            own.username = user.username
            user.usernames.add(own)
        present = {user.usernames.get(i).username.lower() for i in range(user.usernames.size())}
        for name in names:
            if name.lower() in present:
                continue
            entry = TLRPC.TL_username()
            entry.active = True
            entry.username = name
            user.usernames.add(entry)
        if names:
            user.flags2 |= FLAG_USERNAMES

        # Choose which username shows under the name (user.username). The rest fall under "also".
        primary = parse_usernames(self.get_setting("primary_username", ""))
        if primary:
            choice = primary[0]
            if self.real_username.get(user.id) is None:
                self.real_username[user.id] = user.username or ""
            user.username = choice
            # The chosen one should not also repeat in the "also" list.
            for i in reversed(range(user.usernames.size())):
                if user.usernames.get(i).username.lower() == choice.lower():
                    user.usernames.remove(jint(i))
        elif user.id in self.real_username:
            user.username = self.real_username[user.id]

    def patch_phone(self, user):
        fake = parse_phone(self.get_setting("anon_number", ""))
        key = f"real_phone_{user.id}"
        if user.phone and not user.phone.startswith("888") and self.real_phones.get(user.id) != user.phone:
            self.real_phones[user.id] = user.phone
            self.set_setting(key, user.phone)
        real = self.real_phones.get(user.id) or self.get_setting(key, "")
        if fake:
            user.phone = fake
        elif user.phone and user.phone.startswith("888") and real:
            user.phone = real

    def refresh_own_users(self):
        self.own_ids = set()
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            config = get_user_config(account)
            if not config.isClientActivated():
                continue
            user = config.getCurrentUser()
            if user is not None:
                self.patch_user(user)
            cached = get_messages_controller(account).getUser(config.getClientUserId())
            if cached is not None and cached is not user:
                self.patch_user(cached)

    def clear_statuses(self):
        for user_id in list(self.get_own_ids()):
            self.save_status(user_id, None)
        for account in range(UserConfig.MAX_ACCOUNT_COUNT):
            user = get_user_config(account).getCurrentUser()
            if user is not None:
                user.emoji_status = TLRPC.TL_emojiStatusEmpty()
        BulletinHelper.show_success("Статус снят. Переоткрой профиль")

    def local_gift_ids(self):
        return {gift.id for gift in self.gifts.values()} | {gift.id for gift in self.custom.values()}

    def make_saved_gift(self, account: int, gift):
        user_config = get_user_config(account)
        me = TLRPC.TL_peerUser()
        me.user_id = user_config.getClientUserId()

        gift.owner_id = me
        gift.flags = (gift.flags | FLAG_OWNER_ID) & ~(FLAG_OWNER_NAME | FLAG_OWNER_ADDRESS)
        gift.owner_name = None
        gift.owner_address = None

        saved = TL_stars.TL_savedStarGift()
        saved.gift = gift
        saved.date = int(time.time())
        saved.pinned_to_top = self.get_pinned_map().get(gift.slug, self.get_setting("pinned", True))
        # A unique saved_id: without it the app cannot tell our gifts apart and drops
        # their pinned state when the profile is reopened.
        all_slugs = self.all_slugs()
        index = all_slugs.index(gift.slug) if gift.slug in all_slugs else 0
        saved.saved_id = LOCAL_SAVED_ID_BASE + index
        saved.flags |= FLAG_SAVED_ID
        # The gift screen sends this id back when listing the gift for sale.
        saved.msg_id = LOCAL_MSG_ID_BASE + index if gift.slug in self.slugs else 0
        if saved.msg_id:
            saved.flags |= FLAG_MSG_ID
            self.local_msg_ids[saved.msg_id] = gift.slug
        self.apply_meta(saved, gift.slug)
        return saved

    def make_saved_regular_gift(self, account: int, gift, index: int):
        me = TLRPC.TL_peerUser()
        me.user_id = get_user_config(account).getClientUserId()
        saved = TL_stars.TL_savedStarGift()
        saved.gift = gift
        saved.from_id = me
        saved.date = int(time.time())
        saved.saved_id = LOCAL_SAVED_ID_BASE + 100000 + index  # distinct from NFT ids
        saved.flags |= FLAG_SAVED_ID
        # Show the "Улучшить" button and let the upgrade be answered locally.
        saved.can_upgrade = True
        saved.flags |= FLAG_CAN_UPGRADE
        saved.msg_id = REGULAR_MSG_BASE + index
        saved.flags |= FLAG_MSG_ID
        self.local_regular_msg[saved.msg_id] = gift.id
        return saved
