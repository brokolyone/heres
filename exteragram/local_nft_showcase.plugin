def jlist(java_list) -> list:
    """Java ArrayList -> Python list. In this app Java lists cannot be iterated with `for`."""
    if java_list is None:
        return []
    return [java_list.get(i) for i in range(java_list.size())]


def slug_base(title: str) -> str:
    """'Durov's Cap' -> 'DurovsCap', the part of the slug before the number."""
    return re.sub(r"[^0-9A-Za-z]", "", title or "")


def describe_unique(gift) -> str:
    names = {}
    for attr in jlist(gift.attributes):
        if isinstance(attr, TL_stars.starGiftAttributeModel):
            names["model"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributeBackdrop):
            names["backdrop"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributePattern):
            names["pattern"] = attr.name
    parts = [
        names[k]
        for k in ("model", "backdrop", "pattern")
        if k in names
    ]
    return f"#{gift.num} · " + " · ".join(parts)


def parse_amount(text, default: float) -> float:
    try:
        return max(
            0.0, float(str(text).replace(",", ".").replace(" ", ""))
        )
    except ValueError:
        return default


def find_method(clazz, name: str, param_count: int):
    for method in clazz.getDeclaredMethods():
        if (
            method.getName() == name
            and method.getParameterCount() == param_count
        ):
            method.setAccessible(True)
            return method
    return None


class BalanceHook(MethodHook):
    """StarsController.getBalance(boolean, Runnable, boolean): every balance read goes through it."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.get_setting("local_balance", True):
            amount = self.plugin.balance_amount(param.thisObject.ton)
            # Some screens read the field directly. If it keeps the real balance they open
            # "Stars needed", and that sheet buys again on every balance change: a purchase loop.
            param.thisObject.balance = amount
            param.setResult(amount)


