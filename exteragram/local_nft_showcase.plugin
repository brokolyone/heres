class _QuietBulletins:
    """The plugin shows no pop-up messages of its own: every BulletinHelper call is a no-op.
    Telegram's own bulletins are untouched."""

    def __getattr__(self, name):
        return lambda *args, **kwargs: None


BulletinHelper = _QuietBulletins()

