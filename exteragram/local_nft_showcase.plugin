def parse_slug(text: str) -> str:
    """Accepts 'PlushPepe-1', 't.me/nft/PlushPepe-1' or 'https://t.me/nft/PlushPepe-1'."""
    text = (text or "").strip()
    if "/nft/" in text:
        text = text.split("/nft/", 1)[1]
    return text.split("?", 1)[0].strip("/ ")


def status_to_hex(status) -> str:
    data = SerializedData(status.getObjectSize())
    status.serializeToStream(data)
    return Utilities.bytesToHex(data.toByteArray())


def status_from_hex(text: str):
    data = SerializedData(Utilities.hexToBytes(text))
    return TLRPC.EmojiStatus.TLdeserialize(data, data.readInt32(False), False)


def gift_to_hex(gift) -> str:
    data = SerializedData(gift.getObjectSize())
    gift.serializeToStream(data)
    return Utilities.bytesToHex(data.toByteArray())


def gift_from_hex(text: str):
    data = SerializedData(Utilities.hexToBytes(text))
    return TL_stars.StarGift.TLdeserialize(data, data.readInt32(False), False)


def gift_from_hex_slug(text: str):
    try:
        g = gift_from_hex(text)
        return g.slug if g is not None else None
    except Exception:
        return None


def attr_name(attr) -> str:
    return getattr(attr, "name", None) or "—"


def backdrop_argb(backdrop) -> int:
    color = int(getattr(backdrop, "center_color", 0) or 0)
    return (0xFF000000 | (color & 0xFFFFFF)) - 0x100000000


def backdrop_edge_argb(backdrop) -> int:
    color = int(getattr(backdrop, "edge_color", 0) or getattr(backdrop, "center_color", 0) or 0)
    return (0xFF000000 | (color & 0xFFFFFF)) - 0x100000000


def attr_permille(attr) -> str:
    try:
        p = int(attr.getRarityPermille())
    except Exception:
        return ""
    return f"{p / 10:.1f}%" if p else ""


class PatchUserHook(MethodHook):
    """Puts local Premium and the locally worn status on our own user objects."""

    def __init__(self, plugin, arg_index):
        self.plugin = plugin
        self.arg_index = arg_index

    def before_hooked_method(self, param):
        self.plugin.patch_user(param.args[self.arg_index])


class ErrorGateHook(MethodHook):
    """BulletinFactory.showForError / makeForError: while one runs, the error bulletin it
    builds is marked, and BulletinShowHook keeps it off the screen."""

    def __init__(self, plugin, remember_result):
        self.plugin = plugin
        self.remember_result = remember_result

    def before_hooked_method(self, param):
        self.plugin.error_depth += 1

    def after_hooked_method(self, param):
        self.plugin.error_depth = max(0, self.plugin.error_depth - 1)
        if self.remember_result and param.getResult() is not None:
            self.plugin.muted_bulletins = (self.plugin.muted_bulletins + [param.getResult()])[-20:]


class BulletinShowHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.get_setting("hide_errors", True):
            return
        bulletin = param.thisObject
        muted = self.plugin.error_depth > 0
        for i, b in enumerate(self.plugin.muted_bulletins):
            if b.equals(bulletin):
                del self.plugin.muted_bulletins[i]
                muted = True
                break
        if muted:
            param.setResult(bulletin)


class ProcessErrorHook(MethodHook):
    """AlertsCreator.processError: the error alerts and toasts for failed requests."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.get_setting("hide_errors", True):
            param.setResult(None)


class PremiumHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.get_setting("local_premium", True):
            param.setResult(True)


def jlist(java_list) -> list:
    """Java ArrayList -> Python list. In this app Java lists cannot be iterated with `for`."""
    if java_list is None:
        return []
    return [java_list.get(i) for i in range(java_list.size())]


def slug_base(title: str) -> str:
    """'Durov's Cap' -> 'DurovsCap', the part of the slug before the number."""
    return re.sub(r"[^0-9A-Za-z]", "", title or "")


def describe_unique(gift) -> str:
    names = {}
    for attr in jlist(gift.attributes):
        if isinstance(attr, TL_stars.starGiftAttributeModel):
            names["model"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributeBackdrop):
            names["backdrop"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributePattern):
            names["pattern"] = attr.name
    parts = [names[k] for k in ("model", "backdrop", "pattern") if k in names]
    return f"#{gift.num} · " + " · ".join(parts)


def parse_amount(text, default: float) -> float:
    try:
        return max(0.0, float(str(text).replace(",", ".").replace(" ", "")))
    except ValueError:
        return default


def find_method(clazz, name: str, param_count: int):
    for method in clazz.getDeclaredMethods():
        if method.getName() == name and method.getParameterCount() == param_count:
            method.setAccessible(True)
            return method
    return None


class BalanceHook(MethodHook):
    """StarsController.getBalance(boolean, Runnable, boolean): every balance read goes through it."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.get_setting("local_balance", True):
            amount = self.plugin.balance_amount(param.thisObject.ton)
            # Some screens read the field directly. If it keeps the real balance they open
            # "Stars needed", and that sheet buys again on every balance change: a purchase loop.
            param.thisObject.balance = amount
            param.setResult(amount)


class StarsNeededHook(MethodHook):
    """StarsIntroActivity.StarsNeededSheet.show(): with the local balance this sheet only does harm.
    Shown with enough balance it buys again at once, and it rebuys on every balance change."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.get_setting("local_balance", True):
            param.setResult(None)


def log_path() -> str:
    from org.telegram.messenger import ApplicationLoader
    return str(ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()) + "/winft_log.txt"


def write_log(text: str):
    """Synchronous append, so the line survives even if the app dies right after."""
    try:
        path = log_path()
        with open(path, "a", encoding="utf-8") as f:
            f.write(time.strftime("%H:%M:%S ") + text + "\n")
        import os
        if os.path.getsize(path) > 96 * 1024:
            with open(path, "r", encoding="utf-8") as f:
                tail = f.read()[-48 * 1024:]
            with open(path, "w", encoding="utf-8") as f:
                f.write(tail)
    except Exception:
        pass


def layout_listener(fn):
    """View.OnLayoutChangeListener backed by a Python callable."""
    from java import dynamic_proxy
    from android.view import View

    class _Listener(dynamic_proxy(View.OnLayoutChangeListener)):
        def onLayoutChange(self, v, left, top, right, bottom, ol, ot, orr, ob):
            fn()

    return _Listener()


def java_field(obj, name):
    """Reads a field declared anywhere up obj's class chain (public or not)."""
    cls = obj.getClass()
    while cls is not None:
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            return field.get(obj)
        except Exception:
            cls = cls.getSuperclass()
    return None


def long_press_listener(on_start, on_release):
    """RecyclerListView.OnItemLongClickListenerExtended backed by Python callables."""
    from java import dynamic_proxy
    from org.telegram.ui.Components import RecyclerListView

    class _Listener(dynamic_proxy(RecyclerListView.OnItemLongClickListenerExtended)):
        def onItemClick(self, view, position, x, y):
            return bool(on_start(view, position))

        def onMove(self, dx, dy):
            pass

        def onLongClickRelease(self):
            on_release()

    return _Listener()


class MarketRedirectHook(MethodHook):
    """While the NFT constructor market is open, a tap on a gift in Telegram's market
    opens Telegram's own preview sheet (the constructor) instead of buying or resale."""

    def __init__(self, plugin, extract, name):
        self.plugin = plugin
        self.extract = extract
        self.name = name

    def before_hooked_method(self, param):
        if not self.plugin.market_active():
            return
        try:
            target = self.extract(param)
        except Exception:
            write_log(f"redirect {self.name} failed:\n{traceback.format_exc()}")
            return
        write_log(f"redirect via {self.name}: {target}")
        if target is None:
            return
        param.setResult(None)
        gift_id, title = target
        run_on_ui_thread(lambda: self.plugin.open_constructor_for(gift_id, title))


class MarketFillHook(MethodHook):
    """GiftSheet.fillItems: before the market grid is (re)built, hide resale listings
    in the very lists it reads, so only non-upgraded versions are shown."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.is_market_sheet(param.thisObject):
            self.plugin.hide_resale_now()


class FakeUpdatesHook(MethodHook):
    """MessagesController.processUpdates: the updates made for a local upgrade only feed the
    gift screen's upgrade animation and must never reach the chats."""

    def __init__(self, plugin):
        self.plugin = plugin

    @hook_filters(HookFilter.ArgumentIsInstanceOf(0, TLRPC.TL_updatesCombined().getClass()))
    def before_hooked_method(self, param):
        updates = param.args[0]
        for i, fake in enumerate(self.plugin.fake_updates):
            if fake.equals(updates):
                del self.plugin.fake_updates[i]
                param.setResult(None)
                return


class SendRequestHook(MethodHook):
    """ConnectionsManager.sendRequest(...): every gift purchase ends with payments.sendStarsForm,
    whichever screen started it, so local purchases are answered here without the server."""

    def __init__(self, plugin):
        self.plugin = plugin

    # sendRequest runs for every network request, so only these requests reach Python.
    @hook_filters(HookFilter.Or(
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.TL_payments_sendStarsForm().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.updateStarGiftPrice().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_fragment.TL_getCollectibleInfo().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.saveStarGift().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TLRPC.TL_payments_getPaymentForm().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.upgradeStarGift().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.createStarGiftCollection().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.updateStarGiftCollection().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.deleteStarGiftCollection().getClass()),
    ))
    def before_hooked_method(self, param):
        args = list(param.args)
        if not args:
            return
        delegate = next((a for a in args[1:] if a is not None and hasattr(a, "run")), None)
        account = get_private_field(param.thisObject, "currentAccount") or 0
        if isinstance(args[0], TL_stars.TL_payments_sendStarsForm):
            result = self.plugin.pay_locally(account, args[0])
        elif isinstance(args[0], TL_stars.updateStarGiftPrice):
            result = self.plugin.set_price_locally(args[0])
        elif isinstance(args[0], TL_fragment.TL_getCollectibleInfo):
            result = self.plugin.collectible_info(args[0])
        elif isinstance(args[0], TL_stars.saveStarGift):
            result = self.plugin.save_gift_locally(args[0])
        elif isinstance(args[0], TLRPC.TL_payments_getPaymentForm):
            result = self.plugin.drop_details_form(args[0])
        elif isinstance(args[0], TL_stars.upgradeStarGift):
            result = self.plugin.upgrade_gift_locally(account, args[0])
        elif isinstance(args[0], (TL_stars.createStarGiftCollection, TL_stars.updateStarGiftCollection,
                                  TL_stars.deleteStarGiftCollection)):
            result = self.plugin.collection_request(account, args[0])
        else:
            return
        self.plugin.trace_request(args[0], result)
        if result is None:
            return  # not ours: let the real request go
        param.setResult(0)
        if delegate is None:
            return
        response, error = result
        try:
            delegate.run(response, error)
        except Exception:
            delegate.run(response, error, 0)  # RequestDelegateTimestamp


def parse_usernames(text: str) -> List[str]:
    """'@durov, t.me/telegram fragment' -> ['durov', 'telegram', 'fragment']"""
    names = []
    for part in re.split(r"[\s,;]+", text or ""):
        name = part.strip().split("t.me/")[-1].lstrip("@").strip("/")
        if re.fullmatch(r"[A-Za-z0-9_]{4,32}", name) and name.lower() not in [n.lower() for n in names]:
            names.append(name)
    return names


def parse_phone(text: str) -> str:
    """'+888 0123 4567' -> '88801234567', empty when it is not a +888 number."""
    digits = re.sub(r"\D", "", text or "")
    return digits if digits.startswith("888") and len(digits) >= 7 else ""


def format_phone(digits: str) -> str:
    """'88801234567' -> '+888 0123 4567'."""
    if not digits:
        return ""
    rest = digits[3:]
    groups = [digits[:3]] + [rest[i:i + 4] for i in range(0, len(rest), 4)]
    return "+" + " ".join(groups)


def parse_prices(text: str) -> dict:
    """'durov=7000, telegram=15k, number=3000' -> {'durov': 7000.0, 'telegram': 15000.0, 'number': 3000.0}"""
    prices = {}
    for part in re.split(r"[,;\n]+", text or ""):
        if "=" not in part:
            continue
        name, value = part.split("=", 1)
        name = name.strip().lstrip("@").lower()
        value = value.strip().lower().replace(" ", "").replace(",", ".")
        scale = 1
        if value.endswith(("k", "к")):
            value, scale = value[:-1], 1000
        try:
            prices[name] = float(value) * scale
        except ValueError:
            continue
    return prices


def http_get(url: str) -> str:
    """Through Java: the app's Python may lack CA certificates for urllib."""
    connection = URL(url).openConnection()
    connection.setConnectTimeout(10000)
    connection.setReadTimeout(10000)
    reader = BufferedReader(InputStreamReader(connection.getInputStream()))
    lines = []
    while True:
        line = reader.readLine()
        if line is None:
            break
        lines.append(line)
    reader.close()
    return "\n".join(lines)


def parse_slugs(text: str) -> List[str]:
    """Several links separated by commas, spaces or new lines, without duplicates."""
    slugs = []
    for part in re.split(r"[\s,;]+", text or ""):
        slug = parse_slug(part)
        if slug and slug not in slugs:
            slugs.append(slug)
    return slugs


class LocalNftShowcasePlugin(BasePlugin):
    def install_crash_handler(self):
        """Write Java crashes to the winft log before Telegram goes down."""
        from java import dynamic_proxy
        from java.lang import Thread
        from android.util import Log
        previous = Thread.getDefaultUncaughtExceptionHandler()

        class Handler(dynamic_proxy(Thread.UncaughtExceptionHandler)):
            def uncaughtException(self, thread, error):
                try:
                    write_log(f"CRASH in {thread.getName()}:\n{Log.getStackTraceString(error)}")
                except Exception:
                    pass
                if previous is not None:
                    previous.uncaughtException(thread, error)

        self.crash_previous = previous
        self.crash_handler = Handler()
        Thread.setDefaultUncaughtExceptionHandler(self.crash_handler)

    def on_plugin_unload(self):
        try:
            from java.lang import Thread
            if getattr(self, "crash_handler", None) is not None:
                Thread.setDefaultUncaughtExceptionHandler(self.crash_previous)
        except Exception:
            pass
        self.restore_resale()

    def show_log(self):
        activity = self.get_activity()
        if activity is None:
            return
        try:
            with open(log_path(), "r", encoding="utf-8") as f:
                text = f.read()
        except Exception:
            text = ""
        text = text[-6000:] or "Лог пуст"
        builder = AlertDialogBuilder(activity)
        builder.set_title("Лог winft")
        builder.set_message(text)
        builder.set_positive_button("Скопировать", lambda bld, _: (copy_to_clipboard(text), bld.dismiss()))
        builder.set_neutral_button("Очистить", lambda bld, _: (self.clear_log(), bld.dismiss()))
        builder.set_negative_button("Закрыть", lambda bld, _: bld.dismiss())
        builder.show()

    def clear_log(self):
        try:
            open(log_path(), "w").close()
        except Exception:
            pass

    def on_plugin_load(self):
        try:
            self.install_crash_handler()
        except Exception:
            write_log(f"crash handler failed:\n{traceback.format_exc()}")
        write_log(f"plugin loaded {__version__}")
        self.slugs = []
        self.gifts = {}
        self.custom = {}  # synthetic slug -> locally built TL_starGiftUnique
        self.ctor = None  # constructor state
        self.generation = 0
        # Requests for gift lists are answered in order, so remember for each
        # account whether the pending ones were for our own profile.
        self.pending = defaultdict(deque)
        self.add_hook("getSavedStarGifts", match_substring=True)
        self.add_hook("TL_users_getFullUser")
        self.add_hook("updateEmojiStatus", match_substring=True)
        self.add_hook("getPaymentForm", match_substring=True)
        self.add_hook("getStarsStatus", match_substring=True)
        self.add_hook("getStarsTransactions", match_substring=True)
        self.add_hook("toggleStarGiftsPinnedToTop", match_substring=True)
        self.add_hook("getStarGiftCollections", match_substring=True)
        self.add_hook("updateStarGiftCollection", match_substring=True)
        self.add_hook("createStarGiftCollection", match_substring=True)
        self.tx_pending = defaultdict(deque)
        self.form_prices = {}  # payment form id -> price (stars, or nanoTON)
        self.balance_cache = {}
        self.rates_loading = False
        self.last_purchase = None  # (slug or gift id, time)
        self.local_msg_ids = {}  # fake SavedStarGift.msg_id -> slug
        self.local_regular_msg = {}  # fake msg_id -> catalog gift id (for local upgrade)
        self.local_saved_ids = {}  # fake SavedStarGift.saved_id -> local key (slug or "r:<gift id>")
        self.previews = {}  # gift id -> (models, backdrops, patterns) for an instant local upgrade
        self.fake_updates = []  # updates objects kept away from MessagesController
        self.error_depth = 0  # > 0 while Telegram builds an error bulletin
        self.muted_bulletins = []  # error bulletins built but not shown yet
        self.pending_create = deque()  # local keys for collections being created
        self.collection_pending = defaultdict(deque)  # own-profile flags for collection requests
        self.announce = {}  # slug or gift id -> account: post a card in Saved Messages once loaded
        self.own_ids = set()
        self.added_usernames = set()
        self.real_username = {}  # user id -> real main username, to restore it later
        self.real_phones = {}  # user id -> real phone, to restore when the +888 number is cleared
        self.statuses = {}
        self.catalog = {}  # gift id -> regular gift from the gift catalog
        self.install_java_hooks()
        self.load_gifts(self.get_setting("slug", ""))
        self.load_custom_gifts()
        self.migrate_fragment_settings()
        self.load_catalog()

    def install_java_hooks(self):
        # Take java.lang.Class from live objects: find_class may return a Python proxy.
        user_config = get_user_config().getClass()
        controller = get_messages_controller().getClass()
        self.hook_method(user_config.getDeclaredMethod("isPremium"), PremiumHook(self))
        self.hook_all_methods(user_config, "setCurrentUser", PatchUserHook(self, 0))
        self.hook_all_methods(controller, "putUser", PatchUserHook(self, 0))
        stars = StarsController.getInstance(0).getClass()
        method = find_method(stars, "getBalance", 3)
        if method is None:
            self.logger.error("StarsController.getBalance not found, local balance is off")
        else:
            self.hook_method(method, BalanceHook(self))
        try:
            loader = stars.getClassLoader()
            sheet = loader.loadClass("org.telegram.ui.Stars.StarsIntroActivity$StarsNeededSheet")
            self.hook_method(find_method(sheet, "show", 0), StarsNeededHook(self))
        except Exception:
            self.logger.exception("StarsNeededSheet not found, purchases may repeat")
        try:
            self.install_error_hooks(stars.getClassLoader())
        except Exception:
            self.logger.exception("Error hiding hooks failed")
        try:
            self.install_market_hooks(stars.getClassLoader())
        except Exception:
            self.logger.exception("NFT constructor market hooks failed")
        method = find_method(controller, "processUpdates", 2)
        if method is not None:
            self.hook_method(method, FakeUpdatesHook(self))
        else:
            self.logger.error("processUpdates not found, the upgrade animation is off")
        connections = get_private_field(get_messages_controller(), "connectionsManager")
        connections_class = (connections or ConnectionsManager.getInstance(0)).getClass()
        if not self.hook_all_methods(connections_class, "sendRequest", SendRequestHook(self)):
            self.logger.error("ConnectionsManager.sendRequest not found, local purchases are off")

    def install_error_hooks(self, loader):
        factory = loader.loadClass("org.telegram.ui.Components.BulletinFactory")
        self.hook_all_methods(factory, "showForError", ErrorGateHook(self, False))
        self.hook_all_methods(factory, "makeForError", ErrorGateHook(self, True))
        self.hook_all_methods(loader.loadClass("org.telegram.ui.Components.Bulletin"), "show",
                              BulletinShowHook(self))
        self.hook_all_methods(loader.loadClass("org.telegram.ui.Components.AlertsCreator"), "processError",
                              ProcessErrorHook(self))

    def install_market_hooks(self, loader):
        def cls(name):
            try:
                return loader.loadClass(name)
            except Exception:
                self.logger.error(f"{name} not found")
                return None

        def by_gift(gift):
            return (gift.id, gift.title) if gift is not None and getattr(gift, "title", None) else None

        send = cls("org.telegram.ui.Gifts.SendGiftSheet")
        if send is not None:
            method = find_method(send, "show", 0)
            if method is not None:
                self.hook_method(method, MarketRedirectHook(
                    self, lambda p: by_gift(get_private_field(p.thisObject, "starGift")), "SendGiftSheet.show"))

        resale = cls("org.telegram.ui.Gifts.ResaleGiftsFragment")
        fragment = cls("org.telegram.ui.ActionBar.BaseFragment")
        if resale is not None and fragment is not None:
            method = find_method(fragment, "showAsSheet", 2)
            if method is not None:
                self.hook_method(method, MarketRedirectHook(
                    self, lambda p: (get_private_field(p.args[0], "gift_id"),
                                     get_private_field(p.args[0], "gift_name"))
                    if p.args[0] is not None and resale.isInstance(p.args[0]) else None, "showAsSheet"))

        intro = cls("org.telegram.ui.Stars.StarsIntroActivity")
        if intro is not None:
            method = find_method(intro, "showSoldOutGiftSheet", 4)
            if method is not None:
                self.hook_method(method, MarketRedirectHook(self, lambda p: by_gift(p.args[2]), "soldOut"))

        auction = cls("org.telegram.ui.Gifts.AuctionJoinSheet")
        if auction is not None:
            method = find_method(auction, "show", 6)
            if method is not None:
                self.hook_method(method, MarketRedirectHook(
                    self, lambda p: (int(p.args[4]), self.catalog_title(int(p.args[4]))), "auction"))

        gift_sheet = cls("org.telegram.ui.Gifts.GiftSheet")
        if gift_sheet is not None:
            method = find_method(gift_sheet, "fillItems", 2)
            if method is not None:
                self.hook_method(method, MarketFillHook(self))
        write_log("market hooks installed")

