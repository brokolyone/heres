def parse_slug(text: str) -> str:
    """Accepts 'PlushPepe-1', 't.me/nft/PlushPepe-1' or 'https://t.me/nft/PlushPepe-1'."""
    text = (text or "").strip()
    if "/nft/" in text:
        text = text.split("/nft/", 1)[1]
    return text.split("?", 1)[0].strip("/ ")


def status_to_hex(status) -> str:
    data = SerializedData(status.getObjectSize())
    status.serializeToStream(data)
    return Utilities.bytesToHex(data.toByteArray())


def status_from_hex(text: str):
    data = SerializedData(Utilities.hexToBytes(text))
    return TLRPC.EmojiStatus.TLdeserialize(data, data.readInt32(False), False)


class PatchUserHook(MethodHook):
    """Puts local Premium and the locally worn status on our own user objects."""

    def __init__(self, plugin, arg_index):
        self.plugin = plugin
        self.arg_index = arg_index

    def before_hooked_method(self, param):
        self.plugin.patch_user(param.args[self.arg_index])


class PremiumHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.get_setting("local_premium", True):
            param.setResult(True)


def jlist(java_list) -> list:
    """Java ArrayList -> Python list. In this app Java lists cannot be iterated with `for`."""
    if java_list is None:
        return []
    return [java_list.get(i) for i in range(java_list.size())]


def slug_base(title: str) -> str:
    """'Durov's Cap' -> 'DurovsCap', the part of the slug before the number."""
    return re.sub(r"[^0-9A-Za-z]", "", title or "")


def describe_unique(gift) -> str:
    names = {}
    for attr in jlist(gift.attributes):
        if isinstance(attr, TL_stars.starGiftAttributeModel):
            names["model"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributeBackdrop):
            names["backdrop"] = attr.name
        elif isinstance(attr, TL_stars.starGiftAttributePattern):
            names["pattern"] = attr.name
    parts = [names[k] for k in ("model", "backdrop", "pattern") if k in names]
    return f"#{gift.num} · " + " · ".join(parts)


def parse_amount(text, default: float) -> float:
    try:
        return max(0.0, float(str(text).replace(",", ".").replace(" ", "")))
    except ValueError:
        return default


def find_method(clazz, name: str, param_count: int):
    for method in clazz.getDeclaredMethods():
        if method.getName() == name and method.getParameterCount() == param_count:
            method.setAccessible(True)
            return method
    return None


class BalanceHook(MethodHook):
    """StarsController.getBalance(boolean, Runnable, boolean): every balance read goes through it."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.get_setting("local_balance", True):
            amount = self.plugin.balance_amount(param.thisObject.ton)
            # Some screens read the field directly. If it keeps the real balance they open
            # "Stars needed", and that sheet buys again on every balance change: a purchase loop.
            param.thisObject.balance = amount
            param.setResult(amount)


class StarsNeededHook(MethodHook):
    """StarsIntroActivity.StarsNeededSheet.show(): with the local balance this sheet only does harm.
    Shown with enough balance it buys again at once, and it rebuys on every balance change."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.get_setting("local_balance", True):
            param.setResult(None)


class SendRequestHook(MethodHook):
    """ConnectionsManager.sendRequest(...): every gift purchase ends with payments.sendStarsForm,
    whichever screen started it, so local purchases are answered here without the server."""

    def __init__(self, plugin):
        self.plugin = plugin

    # sendRequest runs for every network request, so only these requests reach Python.
    @hook_filters(HookFilter.Or(
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.TL_payments_sendStarsForm().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.updateStarGiftPrice().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_fragment.TL_getCollectibleInfo().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TL_stars.saveStarGift().getClass()),
        HookFilter.ArgumentIsInstanceOf(0, TLRPC.TL_payments_getPaymentForm().getClass()),
    ))
    def before_hooked_method(self, param):
        args = list(param.args)
        if not args:
            return
        delegate = next((a for a in args[1:] if a is not None and hasattr(a, "run")), None)
        account = get_private_field(param.thisObject, "currentAccount") or 0
        if isinstance(args[0], TL_stars.TL_payments_sendStarsForm):
            result = self.plugin.pay_locally(account, args[0])
        elif isinstance(args[0], TL_stars.updateStarGiftPrice):
            result = self.plugin.set_price_locally(args[0])
        elif isinstance(args[0], TL_fragment.TL_getCollectibleInfo):
            result = self.plugin.collectible_info(args[0])
        elif isinstance(args[0], TL_stars.saveStarGift):
            result = self.plugin.save_gift_locally(args[0])
        elif isinstance(args[0], TLRPC.TL_payments_getPaymentForm):
            result = self.plugin.drop_details_form(args[0])
        else:
            return
        if result is None:
            return  # not ours: let the real request go
        param.setResult(0)
        if delegate is None:
            return
        response, error = result
        try:
            delegate.run(response, error)
        except Exception:
            delegate.run(response, error, 0)  # RequestDelegateTimestamp


def parse_usernames(text: str) -> List[str]:
    """'@durov, t.me/telegram fragment' -> ['durov', 'telegram', 'fragment']"""
    names = []
    for part in re.split(r"[\s,;]+", text or ""):
        name = part.strip().split("t.me/")[-1].lstrip("@").strip("/")
        if re.fullmatch(r"[A-Za-z0-9_]{4,32}", name) and name.lower() not in [n.lower() for n in names]:
            names.append(name)
    return names


def parse_phone(text: str) -> str:
    """'+888 0123 4567' -> '88801234567', empty when it is not a +888 number."""
    digits = re.sub(r"\D", "", text or "")
    return digits if digits.startswith("888") and len(digits) >= 7 else ""


def format_phone(digits: str) -> str:
    """'88801234567' -> '+888 0123 4567'."""
    if not digits:
        return ""
    rest = digits[3:]
    groups = [digits[:3]] + [rest[i:i + 4] for i in range(0, len(rest), 4)]
    return "+" + " ".join(groups)


def parse_prices(text: str) -> dict:
    """'durov=7000, telegram=15k, number=3000' -> {'durov': 7000.0, 'telegram': 15000.0, 'number': 3000.0}"""
    prices = {}
    for part in re.split(r"[,;\n]+", text or ""):
        if "=" not in part:
            continue
        name, value = part.split("=", 1)
        name = name.strip().lstrip("@").lower()
        value = value.strip().lower().replace(" ", "").replace(",", ".")
        scale = 1
        if value.endswith(("k", "к")):
            value, scale = value[:-1], 1000
        try:
            prices[name] = float(value) * scale
        except ValueError:
            continue
    return prices


def http_get(url: str) -> str:
    """Through Java: the app's Python may lack CA certificates for urllib."""
    connection = URL(url).openConnection()
    connection.setConnectTimeout(10000)
    connection.setReadTimeout(10000)
    reader = BufferedReader(InputStreamReader(connection.getInputStream()))
    lines = []
    while True:
        line = reader.readLine()
        if line is None:
            break
        lines.append(line)
    reader.close()
    return "\n".join(lines)


def parse_slugs(text: str) -> List[str]:
    """Several links separated by commas, spaces or new lines, without duplicates."""
    slugs = []
    for part in re.split(r"[\s,;]+", text or ""):
        slug = parse_slug(part)
        if slug and slug not in slugs:
            slugs.append(slug)
    return slugs


class LocalNftShowcasePlugin(BasePlugin):
    def on_plugin_load(self):
        self.slugs = []
        self.gifts = {}
        self.generation = 0
        # Requests for gift lists are answered in order, so remember for each
        # account whether the pending ones were for our own profile.
        self.pending = defaultdict(deque)
        self.add_hook("getSavedStarGifts", match_substring=True)
        self.add_hook("TL_users_getFullUser")
        self.add_hook("updateEmojiStatus", match_substring=True)
        self.add_hook("getPaymentForm", match_substring=True)
        self.add_hook("getStarsStatus", match_substring=True)
        self.add_hook("getStarsTransactions", match_substring=True)
        self.add_hook("toggleStarGiftsPinnedToTop", match_substring=True)
        self.tx_pending = defaultdict(deque)
        self.form_prices = {}  # payment form id -> price (stars, or nanoTON)
        self.balance_cache = {}
        self.rates_loading = False
        self.last_purchase = None  # (slug or gift id, time)
        self.local_msg_ids = {}  # fake SavedStarGift.msg_id -> slug
        self.announce = {}  # slug or gift id -> account: post a card in Saved Messages once loaded
        self.own_ids = set()
        self.added_usernames = set()
        self.real_username = {}  # user id -> real main username, to restore it later
        self.real_phones = {}  # user id -> real phone, to restore when the +888 number is cleared
        self.statuses = {}
        self.catalog = {}  # gift id -> regular gift from the gift catalog
        self.install_java_hooks()
        self.load_gifts(self.get_setting("slug", ""))
        self.migrate_fragment_settings()
        self.load_catalog()

    def install_java_hooks(self):
        # Take java.lang.Class from live objects: find_class may return a Python proxy.
        user_config = get_user_config().getClass()
        controller = get_messages_controller().getClass()
        self.hook_method(user_config.getDeclaredMethod("isPremium"), PremiumHook(self))
        self.hook_all_methods(user_config, "setCurrentUser", PatchUserHook(self, 0))
        self.hook_all_methods(controller, "putUser", PatchUserHook(self, 0))
        stars = StarsController.getInstance(0).getClass()
        method = find_method(stars, "getBalance", 3)
        if method is None:
            self.logger.error("StarsController.getBalance not found, local balance is off")
        else:
            self.hook_method(method, BalanceHook(self))
        try:
            loader = stars.getClassLoader()
            sheet = loader.loadClass("org.telegram.ui.Stars.StarsIntroActivity$StarsNeededSheet")
            self.hook_method(find_method(sheet, "show", 0), StarsNeededHook(self))
        except Exception:
            self.logger.exception("StarsNeededSheet not found, purchases may repeat")
        connections = get_private_field(get_messages_controller(), "connectionsManager")
        connections_class = (connections or ConnectionsManager.getInstance(0)).getClass()
        if not self.hook_all_methods(connections_class, "sendRequest", SendRequestHook(self)):
            self.logger.error("ConnectionsManager.sendRequest not found, local purchases are off")

