# Токен бота от @BotFather. Никогда не коммитьте настоящий токен.
BOT_TOKEN=123456:replace-me
# Свой сервер Bot API (Local Bot API Server). Пусто — официальный api.telegram.org
TELEGRAM_API_URL=
# Строка подключения SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://ironvein:ironvein@db:5432/ironvein
# Telegram ID администраторов через запятую
ADMIN_IDS=
# production | development. В production запрещены тестовые выдачи.
ENVIRONMENT=development
# Множитель скорости игрового времени (1.0 = реальное время; 10 = в 10 раз быстрее)
GAME_SPEED=1.0
# Стартовый капитал нового аккаунта (кроны, целое число)
STARTER_CROWNS=1000
# Комиссия рынка и контрактов, базисные пункты (200 = 2%)
MARKET_FEE_BPS=200
CONTRACT_FEE_BPS=200
# Плата за регистрацию компании (уничтожается)
COMPANY_FEE=500
# Вместимость склада владельца в одной локации (единиц ресурсов)
WAREHOUSE_CAPACITY=2000
# Период опроса фоновых задач, секунды
JOB_POLL_SECONDS=5
# Сколько минут держится бронь лимитированного премиум-товара под выставленный счёт
PREMIUM_RESERVATION_MINUTES=30
