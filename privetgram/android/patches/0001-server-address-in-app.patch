diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/PrivetServer.java b/TMessagesProj/src/main/java/org/telegram/messenger/PrivetServer.java
new file mode 100644
index 00000000..880ea537
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/PrivetServer.java
@@ -0,0 +1,189 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.text.InputType;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.Toast;
+
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.LayoutHelper;
+
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.util.Locale;
+
+/**
+ * Privetgram: the MTProto server is chosen in the app (host[:port]) instead of being compiled in.
+ * The host is resolved to an IP when it is saved and again in the background on every start.
+ */
+public class PrivetServer {
+
+    public static final int DEFAULT_PORT = 10443;
+    private static final String PREFS = "privetgram_server";
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    public static boolean isConfigured() {
+        return !TextUtils.isEmpty(prefs().getString("ip", null));
+    }
+
+    public static String getIp() {
+        return prefs().getString("ip", "127.0.0.1");
+    }
+
+    public static int getPort() {
+        return prefs().getInt("port", DEFAULT_PORT);
+    }
+
+    public static String getDisplayAddress() {
+        String host = prefs().getString("host", "");
+        if (TextUtils.isEmpty(host)) {
+            return "";
+        }
+        return getPort() == DEFAULT_PORT ? host : host + ":" + getPort();
+    }
+
+    /** Must run before ConnectionsManager.native_init so a fresh config gets the right DC address. */
+    public static void applyDefault() {
+        ConnectionsManager.native_setDefaultServer(getIp(), getPort());
+    }
+
+    private static boolean isRu() {
+        return "ru".equals(Locale.getDefault().getLanguage()) || "uk".equals(Locale.getDefault().getLanguage());
+    }
+
+    private static String t(String ru, String en) {
+        return isRu() ? ru : en;
+    }
+
+    /** Returns {host, port} or null. Accepts host, host:port, [ipv6]:port and bare ipv6. */
+    static Object[] parse(String input) {
+        String s = input == null ? "" : input.trim();
+        s = s.replaceFirst("^[a-zA-Z]+://", "");
+        int slash = s.indexOf('/');
+        if (slash >= 0) {
+            s = s.substring(0, slash);
+        }
+        if (s.isEmpty()) {
+            return null;
+        }
+        String host = s;
+        int port = DEFAULT_PORT;
+        try {
+            if (s.startsWith("[")) {
+                int end = s.indexOf(']');
+                if (end < 0) return null;
+                host = s.substring(1, end);
+                if (s.length() > end + 2 && s.charAt(end + 1) == ':') {
+                    port = Integer.parseInt(s.substring(end + 2));
+                }
+            } else if (s.indexOf(':') == s.lastIndexOf(':') && s.indexOf(':') > 0) {
+                host = s.substring(0, s.indexOf(':'));
+                port = Integer.parseInt(s.substring(s.indexOf(':') + 1));
+            }
+        } catch (NumberFormatException e) {
+            return null;
+        }
+        if (port <= 0 || port > 65535 || host.isEmpty()) {
+            return null;
+        }
+        return new Object[]{host, port};
+    }
+
+    private static String resolve(String host) throws Exception {
+        InetAddress[] all = InetAddress.getAllByName(host);
+        for (InetAddress a : all) {
+            if (a instanceof Inet4Address) {
+                return a.getHostAddress();
+            }
+        }
+        String ip = all[0].getHostAddress();
+        int zone = ip.indexOf('%');
+        return zone >= 0 ? ip.substring(0, zone) : ip;
+    }
+
+    /** Re-resolve a DNS name in the background; if its IPv4 changed, point the connection there. */
+    public static void refreshDnsAsync(int account) {
+        String host = prefs().getString("host", "");
+        String oldIp = getIp();
+        if (TextUtils.isEmpty(host) || host.equals(oldIp)) {
+            return;
+        }
+        Utilities.globalQueue.postRunnable(() -> {
+            try {
+                String ip = resolve(host);
+                if (!ip.equals(oldIp) && ip.indexOf(':') < 0) {
+                    prefs().edit().putString("ip", ip).apply();
+                    ConnectionsManager.native_setDefaultServer(ip, getPort());
+                    ConnectionsManager.getInstance(account).applyDatacenterAddress(1, ip, getPort());
+                }
+            } catch (Exception e) {
+                FileLog.e(e);
+            }
+        });
+    }
+
+    public static void showDialog(Context context, int account, Runnable onSaved) {
+        if (context == null) {
+            return;
+        }
+        EditText input = new EditText(context);
+        input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18);
+        input.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        input.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint));
+        input.setHint(t("ip или домен, напр. 1.2.3.4", "ip or domain, e.g. 1.2.3.4"));
+        input.setSingleLine(true);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        input.setGravity(Gravity.LEFT);
+        input.setText(getDisplayAddress());
+        input.setSelection(input.getText().length());
+        FrameLayout frame = new FrameLayout(context);
+        frame.addView(input, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.TOP, 24, 6, 24, 0));
+
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(t("Сервер", "Server"));
+        builder.setMessage(t("Адрес твоего сервера Privetgram. Порт по умолчанию " + DEFAULT_PORT + ".",
+                "Address of your Privetgram server. Default port is " + DEFAULT_PORT + "."));
+        builder.setView(frame);
+        builder.setPositiveButton(t("Сохранить", "Save"), (dialog, which) -> {
+            Object[] parsed = parse(input.getText().toString());
+            if (parsed == null) {
+                Toast.makeText(context, t("Неверный адрес", "Invalid address"), Toast.LENGTH_SHORT).show();
+                return;
+            }
+            String host = (String) parsed[0];
+            int port = (Integer) parsed[1];
+            Utilities.globalQueue.postRunnable(() -> {
+                String ip;
+                try {
+                    ip = resolve(host);
+                } catch (Exception e) {
+                    AndroidUtilities.runOnUIThread(() -> Toast.makeText(context, t("Не удалось найти " + host, "Can't resolve " + host), Toast.LENGTH_LONG).show());
+                    return;
+                }
+                prefs().edit().putString("host", host).putString("ip", ip).putInt("port", port).commit();
+                AndroidUtilities.runOnUIThread(() -> {
+                    ConnectionsManager.native_setDefaultServer(ip, port);
+                    ConnectionsManager.native_resetServer(account);
+                    if (onSaved != null) {
+                        onSaved.run();
+                    }
+                });
+            });
+        });
+        builder.setNegativeButton(t("Отмена", "Cancel"), null);
+        AlertDialog dialog = builder.create();
+        dialog.show();
+        input.requestFocus();
+        AndroidUtilities.showKeyboard(input);
+    }
+}
