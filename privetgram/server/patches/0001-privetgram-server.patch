 package core
 
 import (
+	"strings"
+
 	"github.com/teamgram/proto/mtproto"
+	userpb "github.com/teamgram/teamgram-server/app/service/biz/user/user"
+	"github.com/teamgram/teamgram-server/pkg/phonenumber"
 )
 
+// maxImportContacts caps one request (the app sends the phone book in batches).
+const maxImportContacts = 500
+
 // ContactsImportContacts
 // contacts.importContacts#2c800be5 contacts:Vector<InputContact> = contacts.ImportedContacts;
+//
+// Privetgram: upstream community edition leaves this blocked, which means people can't add each
+// other by phone number. Implemented on top of the user service: look the number up, add the contact.
 func (c *ContactsCore) ContactsImportContacts(in *mtproto.TLContactsImportContacts) (*mtproto.Contacts_ImportedContacts, error) {
-	// TODO: not impl
-	c.Logger.Errorf("contacts.importContacts blocked, License key from https://teamgram.net required to unlock enterprise features.")
+	var (
+		imported = make([]*mtproto.ImportedContact, 0, len(in.Contacts))
+		idList   = make([]int64, 0, len(in.Contacts))
+		region   string
+	)
+
+	// phone book numbers are often in local format ("8 999 ..."), so parse them in the user's own region
+	if me, err := c.svcCtx.Dao.UserClient.UserGetImmutableUser(c.ctx, &userpb.TLUserGetImmutableUser{Id: c.MD.UserId}); err == nil && me != nil {
+		if p, err := phonenumber.MakePhoneNumberHelper("+"+me.Phone(), ""); err == nil {
+			region = p.GetRegionCode()
+		}
+	}
+
+	for i, contact := range in.Contacts {
+		if i >= maxImportContacts {
+			break
+		}
+		phone := strings.ReplaceAll(contact.GetPhone(), " ", "")
+		if phone == "" {
+			continue
+		}
+		p, err := phonenumber.MakePhoneNumberHelper(phone, region)
+		if err != nil {
+			continue
+		}
+		id, err := c.svcCtx.Dao.UserClient.UserGetUserIdByPhone(c.ctx, &userpb.TLUserGetUserIdByPhone{Phone: p.GetNormalizeDigits()})
+		if err != nil || id.GetV() == 0 || id.GetV() == c.MD.UserId {
+			continue
+		}
+		if _, err = c.svcCtx.Dao.UserClient.UserAddContact(c.ctx, &userpb.TLUserAddContact{
+			UserId:    c.MD.UserId,
+			Id:        id.GetV(),
+			FirstName: contact.GetFirstName(),
+			LastName:  contact.GetLastName(),
+			Phone:     p.GetNormalizeDigits(),
+		}); err != nil {
+			c.Logger.Errorf("contacts.importContacts - addContact(%d) error: %v", id.GetV(), err)
+			continue
+		}
+		imported = append(imported, mtproto.MakeTLImportedContact(&mtproto.ImportedContact{
+			UserId:   id.GetV(),
+			ClientId: contact.GetClientId(),
+		}).To_ImportedContact())
+		idList = append(idList, id.GetV())
+	}
+
+	users := make([]*mtproto.User, 0, len(idList))
+	if len(idList) > 0 {
+		mUsers, err := c.svcCtx.Dao.UserClient.UserGetMutableUsersV2(c.ctx, &userpb.TLUserGetMutableUsersV2{
+			Id:      append([]int64{c.MD.UserId}, idList...),
+			Privacy: true,
+			HasTo:   true,
+			To:      []int64{c.MD.UserId},
+		})
+		if err != nil {
+			c.Logger.Errorf("contacts.importContacts - getMutableUsers error: %v", err)
+		} else {
+			for _, id := range idList {
+				if u, err := mUsers.GetUnsafeUser(c.MD.UserId, id); err == nil && u != nil {
+					users = append(users, u)
+				}
+			}
+		}
+	}
 
 	return mtproto.MakeTLContactsImportedContacts(&mtproto.Contacts_ImportedContacts{
-		Imported:       []*mtproto.ImportedContact{},
+		Imported:       imported,
 		PopularInvites: []*mtproto.PopularContact{},
 		RetryContacts:  []int64{},
-		Users:          []*mtproto.User{},
+		Users:          users,
 	}).To_Contacts_ImportedContacts(), nil
 }
