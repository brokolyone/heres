  "authors": ["brokolyone"],
  "license": "MIT",
  "icon": "assets/heres/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["heres.HeresMod"],
    "client": ["heres.client.HeresClient"]
  },
  "mixins": [
    {"config": "heres.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21 <1.21.2",
    "java": ">=21",
    "fabric-api": "*"
  }
}
