BOT_TOKEN=123456:ABC-токен-от-BotFather
# твой Telegram ID (узнать у @userinfobot); несколько — через запятую
ALLOWED_USERS=123456789
# cookies.txt из браузера — для YouTube на сервере, Instagram, Reddit, Vimeo, приватного VK и т.п.
COOKIES_FILE=
# максимум треков/видео из плейлиста
MAX_PLAYLIST=50
# для Spotify/Apple/Deezer/Яндекса: искать и на SoundCloud, если на YouTube не нашлось (1/0)
MUSIC_SOUNDCLOUD_FALLBACK=1
# свой Local Bot API Server → лимит файлов 2 ГБ вместо 50 МБ, например http://localhost:8081
BOT_API_URL=
